-- 7. G3: VENTAS (room service, desayunos incluidos, minibar, lavanderia y spa, restaurante con pago directo) y su envio a Facturacion
-- =====================================================================
CREATE OR REPLACE FUNCTION pg_temp.precio_en(p_item text, p_ts timestamptz) RETURNS numeric LANGUAGE sql STABLE AS
$$ SELECT coalesce((SELECT nuevo FROM t_hist WHERE id = p_item AND fecha <= p_ts::date ORDER BY fecha DESC LIMIT 1),
                   (SELECT anterior FROM t_hist WHERE id = p_item ORDER BY fecha LIMIT 1),
                   (SELECT precio FROM t_item WHERE id = p_item)) $$;

