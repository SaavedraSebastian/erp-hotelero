INSERT INTO habitacion (id_tipo_habitacion, numero, piso, fecha_registro)
SELECT t.id_tipo_habitacion, (p * 100 + k)::text, p, (SELECT ini FROM cfg)::timestamptz - interval '3 years'
FROM generate_series(1, 5) p
CROSS JOIN generate_series(1, 8) k
JOIN tipo_habitacion t ON t.nombre = CASE
   WHEN p IN (1, 2) AND k <= 3 THEN 'Simple'
   WHEN p IN (1, 2) THEN 'Doble Estándar'
   WHEN p = 3 AND k <= 4 THEN 'Doble Estándar'
   WHEN p = 3 THEN 'Doble Superior'
   WHEN p = 4 AND k <= 4 THEN 'Doble Superior'
   WHEN p = 4 AND k <= 6 THEN 'Triple'
   WHEN p = 4 THEN 'Familiar'
   WHEN k <= 2 THEN 'Triple'
   WHEN k <= 4 THEN 'Familiar'
   WHEN k <= 6 THEN 'Suite Junior'
   ELSE 'Suite Ejecutiva' END
ORDER BY p, k;

