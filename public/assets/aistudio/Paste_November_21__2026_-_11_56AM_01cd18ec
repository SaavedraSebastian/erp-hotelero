CREATE OR REPLACE FUNCTION pg_temp.pick(a text[]) RETURNS text LANGUAGE sql VOLATILE AS
$$ SELECT a[1 + floor(random() * array_length(a, 1))::int] $$;

CREATE OR REPLACE FUNCTION pg_temp.wpick(a text[], w numeric[]) RETURNS text LANGUAGE plpgsql VOLATILE AS
$$ DECLARE r numeric := random() * (SELECT sum(x) FROM unnest(w) x); s numeric := 0; i int;
   BEGIN FOR i IN 1..array_length(a, 1) LOOP s := s + w[i]; IF r <= s THEN RETURN a[i]; END IF; END LOOP; RETURN a[array_length(a, 1)]; END $$;

CREATE OR REPLACE FUNCTION pg_temp.sa(t text) RETURNS text LANGUAGE sql IMMUTABLE AS
$$ SELECT translate(lower(t), 'áéíóúñü ', 'aeiounu.') $$;

CREATE OR REPLACE FUNCTION pg_temp.entre(a numeric, b numeric) RETURNS numeric LANGUAGE sql VOLATILE AS
$$ SELECT a + random() * (b - a) $$;

CREATE OR REPLACE FUNCTION pg_temp.expo(media numeric) RETURNS numeric LANGUAGE sql VOLATILE AS
$$ SELECT -ln(1 - random() * 0.999) * media $$;

CREATE OR REPLACE FUNCTION pg_temp.pascua(y int) RETURNS date LANGUAGE sql IMMUTABLE AS
$$ WITH x AS (SELECT y % 19 AS a, y / 100 AS b, y % 100 AS c),
        z AS (SELECT a, b, c, b / 4 AS d, b % 4 AS e, (b + 8) / 25 AS f FROM x),
        w AS (SELECT a, c, d, e, (b - f + 1) / 3 AS g, b FROM z),
        h AS (SELECT a, c, d, e, (19 * a + b - d - g + 15) % 30 AS h FROM w),
        l AS (SELECT a, h, (32 + 2 * e + 2 * (c / 4) - h - (c % 4)) % 7 AS l FROM h),
        m AS (SELECT h, l, (a + 11 * h + 22 * l) / 451 AS m FROM l)
   SELECT make_date(y, (h + l - 7 * m + 114) / 31, ((h + l - 7 * m + 114) % 31) + 1) FROM m $$;

CREATE OR REPLACE FUNCTION pg_temp.el(a text[], i int) RETURNS text LANGUAGE sql IMMUTABLE AS
$$ SELECT a[1 + (i % array_length(a, 1))] $$;

