-- historial de precios (reajustes durante el periodo): el precio vigente es el nuevo y las ventas anteriores usan el precio anterior
CREATE TEMP TABLE t_hist ON COMMIT DROP AS
SELECT x.id, (SELECT ini FROM cfg) + x.dias AS fecha, x.anterior, i.precio AS nuevo
FROM (VALUES ('IT-LOM', 95, 40.00), ('IT-CEV', 120, 36.00), ('IT-BRA', 70, 26.00), ('IT-JNA', 150, 10.00), ('IT-PSO', 60, 24.00), ('IT-DBF', 180, 42.00),
             ('IT-CAF', 110, 7.00), ('IT-CER', 90, 12.00), ('IT-LCA', 130, 10.00), ('IT-SM1', 200, 130.00), ('IT-LOM', 25, 38.00)) x(id, dias, anterior)
JOIN t_item i ON i.id = x.id;
UPDATE t_hist h SET nuevo = 40.00 WHERE id = 'IT-LOM' AND fecha < (SELECT ini FROM cfg) + 50;   -- 38 -> 40 -> 42
INSERT INTO historial_precio_item (id_historial_precio, id_item_catalogo, precio_anterior, precio_nuevo, vigente_desde, motivo)
SELECT 'HP-' || lpad((row_number() OVER (ORDER BY fecha,id))::text, 8, '0'), id, anterior, nuevo, fecha::timestamp,
       'Reajuste histórico de precio para datos de demostración'
FROM t_hist
WHERE anterior <> nuevo
ORDER BY fecha,id;

-- recetas (version 1 vigente; el lomo saltado y el ceviche tienen una version anterior con otras cantidades)
INSERT INTO receta (id_receta, id_item_catalogo, numero_version, vigente_desde, vigente_hasta, estado)
SELECT 'RC-' || id || '-V1', id, 1, (SELECT ini FROM cfg) - 200, (SELECT ini FROM cfg) + 120, 'reemplazada' FROM t_item WHERE id IN ('IT-LOM', 'IT-CEV');
INSERT INTO receta (id_receta, id_item_catalogo, numero_version, vigente_desde, estado)
SELECT 'RC-' || id || CASE WHEN id IN ('IT-LOM', 'IT-CEV') THEN '-V2' ELSE '-V1' END, id, CASE WHEN id IN ('IT-LOM', 'IT-CEV') THEN 2 ELSE 1 END,
       CASE WHEN id IN ('IT-LOM', 'IT-CEV') THEN (SELECT ini FROM cfg) + 121 ELSE (SELECT ini FROM cfg) - 200 END, 'vigente'
FROM t_item WHERE receta IS NOT NULL;
INSERT INTO detalle_receta (id_detalle_receta, id_receta, id_articulo, cantidad_por_porcion)
SELECT 'DR-' || row_number() OVER (ORDER BY r.id_receta, j.key), r.id_receta, j.key, j.value::numeric * CASE WHEN r.id_receta LIKE '%-V1' AND r.numero_version = 1 AND r.estado = 'reemplazada' THEN 1.15 ELSE 1 END
FROM receta r JOIN t_item i ON i.id = r.id_item_catalogo CROSS JOIN LATERAL jsonb_each_text(i.receta) j;
