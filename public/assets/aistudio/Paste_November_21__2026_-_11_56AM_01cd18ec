CREATE TEMP TABLE t_rcl ON COMMIT DROP AS
SELECT DISTINCT ON (id_estadia) * FROM (
  SELECT c.id_estadia, c.id_huesped, k.motivo, k.descr, k.area,
         CASE WHEN c.comp_fuera THEN c.ts_cierre + (2 + random() * 18) * interval '1 hour'
              ELSE e.ts_in::timestamp + (e.ts_out - e.ts_in) * (0.3 + random() * 0.4) END AS f_reg,
         NULL::bigint AS inc, c.id AS cta, c.comp, c.comp_tipo, c.comp_fuera, 1 AS prio, 'RECLAMO' AS tipo, false AS crit
  FROM t_cta c JOIN t_est e ON e.id_estadia = c.id_estadia
  CROSS JOIN LATERAL (SELECT * FROM t_cat ORDER BY random() LIMIT 1) k WHERE c.comp_tipo IS NOT NULL
  UNION ALL
  SELECT i.id_estadia, i.id_huesped, 'Mantenimiento', 'Falla reportada por el huésped: ' || lower(i.descr) || '.', 3, i.ts + (10 + random() * 50) * interval '1 minute', i.numero_incidencia,
         NULL, NULL, NULL, false, 2, 'RECLAMO', i.criticidad = 'Alta'
  FROM t_inc i WHERE i.origen = 'Huésped' AND random() < CASE i.criticidad WHEN 'Alta' THEN 0.7 ELSE 0.3 END
  UNION ALL
  SELECT e.id_estadia, e.id_huesped, k.motivo, k.descr, k.area,
         CASE WHEN random() < 0.7 THEN e.ts_in + (e.ts_out - e.ts_in) * random() ELSE e.ts_out + random() * interval '30 hours' END, NULL, NULL, NULL, NULL, false, 3, 'RECLAMO', random() < 0.06
  FROM t_est e CROSS JOIN LATERAL (SELECT * FROM t_cat ORDER BY random() LIMIT 1) k WHERE e.id_estadia IS NOT NULL AND random() < 0.02
  UNION ALL
  SELECT e.id_estadia, e.id_huesped, 'Sugerencia', pg_temp.pick(ARRAY['Sería ideal ofrecer más opciones vegetarianas en el desayuno.', 'Podrían instalar más tomacorrientes cerca de la cama.', 'Una carta de almohadas ayudaría a elegir la más cómoda.', 'Sugiero extender el horario del desayuno los fines de semana.']),
         1, e.ts_out - random() * interval '8 hours', NULL, NULL, NULL, NULL, false, 4, 'SUGERENCIA', false
  FROM t_est e WHERE e.id_estadia IS NOT NULL AND e.estado_est = 'FINALIZADA' AND random() < 0.006
) z WHERE f_reg < (SELECT ahora FROM cfg)::timestamp - interval '20 minutes' ORDER BY id_estadia, prio;
ALTER TABLE t_rcl ADD COLUMN t_der timestamp, ADD COLUMN t_att timestamp, ADD COLUMN t_cie timestamp, ADD COLUMN canal text, ADD COLUMN senti text, ADD COLUMN conf numeric;
UPDATE t_rcl SET t_der = f_reg + (1 + random() * 5) * interval '1 hour';
UPDATE t_rcl SET t_att = t_der + (2 + random() * 28) * interval '1 hour';
UPDATE t_rcl SET t_cie = t_att + (4 + random() * 56) * interval '1 hour';
UPDATE t_rcl SET canal = CASE WHEN random() < 0.25 THEN 'ASISTENTE' ELSE 'AGENTE' END;
UPDATE t_rcl SET senti = CASE WHEN tipo = 'SUGERENCIA' THEN 'NEUTRO' WHEN random() < 0.75 THEN 'NEGATIVO' ELSE NULL END WHERE true;
UPDATE t_rcl SET conf = round((0.75 + random() * 0.24)::numeric, 4) WHERE senti IS NOT NULL;
UPDATE t_rcl SET senti = 'NEGATIVO', conf = round((0.80 + random() * 0.19)::numeric, 4) WHERE canal = 'ASISTENTE' AND tipo = 'RECLAMO' AND senti IS NULL;

INSERT INTO reclamo (id_perfil, id_estadia, id_area, id_incidencia_g2, tipo, canal, descripcion, motivo, prioridad, sentimiento_ia, confianza, es_critico, estado, fecha_registro, fecha_cierre)
SELECT pf.id_perfil, r.id_estadia, CASE WHEN r.t_der <= a.ahora THEN r.area END, r.inc, r.tipo, r.canal, r.descr, r.motivo, CASE WHEN r.crit THEN 'CRITICA' ELSE 'NORMAL' END, r.senti, r.conf, r.crit,
       CASE WHEN r.t_cie <= a.ahora THEN 'CERRADO' WHEN r.t_att <= a.ahora THEN 'EN_ATENCION' WHEN r.t_der <= a.ahora THEN 'DERIVADO' ELSE 'REGISTRADO' END,
       r.f_reg, CASE WHEN r.t_cie <= a.ahora THEN r.t_cie END
FROM t_rcl r JOIN perfil_huesped pf ON pf.id_huesped = r.id_huesped CROSS JOIN (SELECT ahora::timestamp AS ahora FROM cfg) a ORDER BY r.f_reg;

-- seguimiento de cada reclamo (el trigger automatico se desactivo para registrar las fechas reales)
INSERT INTO seguimiento_reclamo (id_reclamo, estado_anterior, estado_nuevo, fecha_hora, usuario, observacion)
SELECT r.id_reclamo, x.ant, x.nuevo, x.f, (ARRAY['atencion.mrios', 'atencion.jlopez', 'atencion.cvalle'])[1 + (r.id_reclamo % 3)], x.obs
FROM reclamo r JOIN t_rcl t ON t.id_estadia = r.id_estadia
CROSS JOIN LATERAL (VALUES (NULL::text, 'REGISTRADO', t.f_reg, 'Registro inicial'),
                           ('REGISTRADO', 'DERIVADO', t.t_der, 'Derivado al área responsable'),
                           ('DERIVADO', 'EN_ATENCION', t.t_att, 'El área inició la atención del caso'),
                           ('EN_ATENCION', 'CERRADO', t.t_cie, 'Caso resuelto y comunicado al huésped')) x(ant, nuevo, f, obs)
WHERE x.f <= (SELECT ahora FROM cfg)::timestamp ORDER BY x.f;
UPDATE incidencia i SET id_reclamo = r.id_reclamo, informada_crm = true FROM reclamo r WHERE r.id_incidencia_g2 = i.numero_incidencia;

-- ----------------------------------------------------------------- compensaciones: solicitada, aprobada, notificada a Facturacion y aplicada (o fuera de plazo); algunas rechazadas
CREATE TEMP TABLE t_cmp ON COMMIT DROP AS
SELECT r.id_reclamo, t.cta, t.comp, t.comp_tipo, t.comp_fuera, t.f_reg + interval '20 minutes' AS f_sol,
       t.f_reg + (CASE WHEN t.comp_fuera THEN interval '3 hours' ELSE interval '40 minutes' END) AS f_res,
       t.f_reg + (CASE WHEN t.comp_fuera THEN interval '1 day' ELSE interval '60 minutes' END) AS f_not, 'OK' AS res
FROM reclamo r JOIN t_rcl t ON t.id_estadia = r.id_estadia WHERE t.cta IS NOT NULL;
INSERT INTO t_cmp
SELECT r.id_reclamo, NULL, 50, 'DESCUENTO', false, r.fecha_registro + interval '30 minutes', r.fecha_registro + interval '1 day', NULL, 'RECHAZADA'
FROM reclamo r JOIN t_rcl t ON t.id_estadia = r.id_estadia
WHERE t.cta IS NULL AND r.tipo = 'RECLAMO' AND r.estado = 'CERRADO' AND r.fecha_registro < (SELECT ahora FROM cfg)::timestamp - interval '5 days' AND random() < 0.22;
INSERT INTO t_cmp
SELECT r.id_reclamo, NULL, 40, 'SERVICIO_CORTESIA', false, r.fecha_registro + interval '30 minutes', NULL, NULL, 'PEND'
FROM reclamo r JOIN t_rcl t ON t.id_estadia = r.id_estadia WHERE t.cta IS NULL AND r.tipo = 'RECLAMO' AND r.estado IN ('REGISTRADO', 'DERIVADO', 'EN_ATENCION') AND random() < 0.5;
INSERT INTO compensacion (id_reclamo, tipo_compensacion, monto, estado, fecha_solicitud) SELECT id_reclamo, comp_tipo, comp, 'SOLICITADA', f_sol FROM t_cmp;
UPDATE compensacion c SET estado = 'APROBADA', usuario_aprobador = 'jefatura.atencion', fecha_resolucion = m.f_res FROM t_cmp m WHERE m.id_reclamo = c.id_reclamo AND m.res = 'OK';
UPDATE compensacion c SET estado = 'NOTIFICADA', fecha_notificacion = m.f_not FROM t_cmp m WHERE m.id_reclamo = c.id_reclamo AND m.res = 'OK';
UPDATE compensacion c SET estado = CASE WHEN m.comp_fuera THEN 'FUERA_DE_PLAZO' ELSE 'APLICADA' END FROM t_cmp m WHERE m.id_reclamo = c.id_reclamo AND m.res = 'OK';
UPDATE compensacion c SET estado = 'RECHAZADA', usuario_aprobador = 'jefatura.atencion', fecha_resolucion = m.f_res,
       motivo_rechazo = pg_temp.pick(ARRAY['No procede: el servicio reclamado no estaba incluido en la tarifa contratada', 'No procede: el incidente se resolvió durante la estadía sin afectar al huésped', 'No procede: el reclamo se presentó fuera del plazo de 48 horas'])
FROM t_cmp m WHERE m.id_reclamo = c.id_reclamo AND m.res = 'RECHAZADA';

-- ----------------------------------------------------------------- consultas al asistente conversacional (huespedes en casa y futuros clientes)
INSERT INTO consulta_asistente (id_estadia, id_reclamo, intencion, confianza, resultado, derivada_agente, tiempo_respuesta_ms, fecha_hora)
SELECT e.id_estadia, NULL, x.intencion, CASE x.resultado WHEN 'RESPONDIDA' THEN round((0.85 + random() * 0.14)::numeric, 4) WHEN 'DERIVADA' THEN round((0.35 + random() * 0.3)::numeric, 4) ELSE round((0.5 + random() * 0.25)::numeric, 4) END,
       x.resultado, x.resultado = 'DERIVADA', (300 + random() * 2200)::int, e.ts_in + (least(e.ts_out, (SELECT ahora FROM cfg)) - e.ts_in) * random()
FROM t_est e
CROSS JOIN LATERAL generate_series(1, 1 + (random() < 0.35)::int) g(i)
CROSS JOIN LATERAL (SELECT pg_temp.pick(ARRAY['HORARIO_DESAYUNO', 'SOLICITAR_LATE_CHECKOUT', 'CLAVE_WIFI', 'ESTACIONAMIENTO', 'TRANSPORTE_AEROPUERTO', 'RECOMENDACIONES_RESTAURANTES', 'SOLICITAR_TOALLAS', 'FACTURA_CON_RUC'] || CASE WHEN e.id_estadia < 0 THEN ARRAY['X'] ELSE ARRAY[]::text[] END) AS intencion,
                           pg_temp.wpick(ARRAY['RESPONDIDA', 'LIMITACION_INFORMADA', 'DERIVADA'], ARRAY[80 + e.id_estadia * 0, 9, 11]::numeric[]) AS resultado) x
WHERE e.id_estadia IS NOT NULL AND random() < 0.5;
INSERT INTO consulta_asistente (id_estadia, id_reclamo, intencion, confianza, resultado, derivada_agente, tiempo_respuesta_ms, fecha_hora)
SELECT NULL, NULL, x.intencion, round((0.8 + random() * 0.19)::numeric, 4), 'RESPONDIDA', false, (300 + random() * 1800)::int,
       (SELECT ini FROM cfg)::timestamp + random() * ((SELECT hoy - ini FROM cfg) * interval '1 day')
FROM generate_series(1, 450) g CROSS JOIN LATERAL (SELECT pg_temp.pick(ARRAY['CONSULTAR_DISPONIBILIDAD', 'POLITICA_MASCOTAS', 'UBICACION_DEL_HOTEL', 'TARIFAS_Y_PROMOCIONES', 'POLITICA_DE_CANCELACION']) AS intencion WHERE g > 0) x;
INSERT INTO consulta_asistente (id_estadia, id_reclamo, intencion, confianza, resultado, derivada_agente, tiempo_respuesta_ms, fecha_hora)
SELECT r.id_estadia, r.id_reclamo, 'REGISTRAR_RECLAMO', round((0.88 + random() * 0.1)::numeric, 4), 'RECLAMO_REGISTRADO', false, (700 + random() * 1500)::int, r.fecha_registro - interval '2 minutes'
FROM reclamo r WHERE r.canal = 'ASISTENTE' AND r.tipo = 'RECLAMO';
