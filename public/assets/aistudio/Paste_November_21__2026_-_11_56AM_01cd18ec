-- cuadrantes de turnos de las 12 personas de limpieza activas (descanso semanal, vacaciones y permisos)
CREATE TEMP TABLE t_limp ON COMMIT DROP AS
SELECT id_personal, k::int AS k, CASE WHEN k <= 8 THEN 'M' ELSE 'T' END AS turno FROM t_pers WHERE cargo = 'Limpieza' AND k <= 12;

INSERT INTO programacion_turno (id_personal, id_turno, fecha, disponible, motivo_no_disponible)
SELECT l.id_personal, l.turno, d::date, NOT y.off, CASE WHEN y.off THEN y.motivo END
FROM t_limp l CROSS JOIN cfg c
CROSS JOIN generate_series(c.ini - 3, c.fin + 3, interval '1 day') d
CROSS JOIN LATERAL (SELECT ((d::date - c.ini + l.k * 2) % 7 = 6) AS descanso,
                           (l.k IN (3, 9) AND d::date BETWEEN c.ini + 60 + l.k * 5 AND c.ini + 74 + l.k * 5) AS vac,
                           (random() < 0.015) AS permiso) x
CROSS JOIN LATERAL (SELECT x.descanso OR x.vac OR x.permiso AS off,
                           CASE WHEN x.vac THEN 'Vacaciones' WHEN x.descanso THEN 'Descanso semanal'
                                ELSE pg_temp.pick(ARRAY['Permiso personal', 'Descanso médico', 'Capacitación']) END AS motivo) y;

