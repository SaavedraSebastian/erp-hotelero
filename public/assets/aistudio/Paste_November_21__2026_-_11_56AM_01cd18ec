-- (a) room service: comandas a la habitacion durante la estadia
INSERT INTO t_cmd
SELECT 'CMD-RS-' || lpad((row_number() OVER (ORDER BY t0))::text, 6, '0'), 'PV-REST', NULL, 'habitación',
       CASE WHEN random() < 0.015 THEN 'cancelada' ELSE 'entregada' END, t0::timestamp, (t0 + (20 + random() * 25) * interval '1 minute')::timestamp,
       NULL, id_estadia
FROM (
  SELECT x.id_estadia,
         date_trunc('day', x.ts_in + random() * (x.ts_fin - x.ts_in)) + pg_temp.wpick(ARRAY['8','13','15','20','22'], ARRAY[10,28,10,45,7]::numeric[])::int * interval '1 hour' + random() * interval '55 minutes' AS t0,
         x.ts_in, x.ts_fin
  FROM (SELECT e.id_estadia, e.ts_in, least(e.ts_out, (SELECT ahora FROM cfg)) AS ts_fin, floor(e.noches * 0.32 * (0.5 + random()) + random())::int AS k FROM t_est e WHERE e.id_estadia IS NOT NULL) x
  CROSS JOIN LATERAL generate_series(1, x.k) g(i)
) c
WHERE t0 BETWEEN ts_in + interval '30 minutes' AND ts_fin - interval '45 minutes' AND t0 <= (SELECT ahora FROM cfg) - interval '45 minutes';
UPDATE t_cmd SET motivo = 'El huésped canceló el pedido antes de la preparación', entrega = NULL WHERE estado = 'cancelada';

INSERT INTO t_det
SELECT 'DET-' || c.num || '-' || l.i, c.num, it.id, q.cant, pg_temp.precio_en(it.id, c.apertura::timestamptz), c.apertura, c.id_estadia, false, false
FROM t_cmd c
CROSS JOIN LATERAL generate_series(1, 1 + floor(random() * 3)::int) l(i)
