DO $verif$
DECLARE v_vacias text;
BEGIN
  SELECT string_agg(schemaname || '.' || tablename, ', ' ORDER BY tablename) INTO v_vacias
  FROM pg_tables WHERE schemaname IN ('g1_reservas', 'g2_housekeeping', 'g3_servicios', 'g4_finanzas', 'g5_crm', 'public')
   AND (xpath('/row/c/text()', query_to_xml('select count(*) as c from ' || quote_ident(schemaname) || '.' || quote_ident(tablename), false, true, '')))[1]::text::int = 0;
  IF v_vacias IS NOT NULL THEN RAISE WARNING 'Tablas que quedaron sin filas: %', v_vacias; END IF;
END
$verif$;

SELECT 'Resumen de la carga' AS "Datos realistas del ERP hotelero", to_char(now(), 'DD/MM/YYYY HH24:MI') AS "Fecha de carga";
SELECT m.modulo AS "Módulo", m.concepto AS "Concepto", m.total AS "Filas" FROM (
  SELECT 1 o, 'G1 Reservas' modulo, 'Huéspedes' concepto, count(*) total FROM huesped
  UNION ALL SELECT 2, 'G1 Reservas', 'Reservas', count(*) FROM reserva
  UNION ALL SELECT 3, 'G1 Reservas', 'Estadías', count(*) FROM estadia
  UNION ALL SELECT 4, 'G1 Reservas', 'Acompañantes', count(*) FROM acompanante
  UNION ALL SELECT 5, 'G2 Housekeeping y Mantenimiento', 'Órdenes de limpieza', count(*) FROM orden_limpieza
  UNION ALL SELECT 6, 'G2 Housekeeping y Mantenimiento', 'Órdenes de trabajo', count(*) FROM orden_trabajo
  UNION ALL SELECT 7, 'G2 Housekeeping y Mantenimiento', 'Incidencias', count(*) FROM incidencia
  UNION ALL SELECT 8, 'G3 Servicios externos', 'Consumos', count(*) FROM g3_servicios.consumo
  UNION ALL SELECT 9, 'G3 Servicios externos', 'Órdenes de compra', count(*) FROM orden_compra
  UNION ALL SELECT 10, 'G3 Servicios externos', 'Movimientos de kardex', count(*) FROM movimiento_inventario
  UNION ALL SELECT 11, 'G4 Facturación y Finanzas', 'Cuentas', count(*) FROM cuenta
  UNION ALL SELECT 12, 'G4 Facturación y Finanzas', 'Comprobantes', count(*) FROM comprobante
  UNION ALL SELECT 13, 'G4 Facturación y Finanzas', 'Cobros', count(*) FROM cobro
  UNION ALL SELECT 14, 'G5 CRM y Atención', 'Perfiles de huésped', count(*) FROM perfil_huesped
