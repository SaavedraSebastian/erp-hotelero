-- 12. G5 (2/2): puntos de fidelizacion, opiniones (resenas y encuestas), campanas y auditoria
-- =====================================================================
-- ----------------------------------------------------------------- puntos: acumulacion por cada estadia finalizada, canjes, reversiones, ajustes y anulaciones
INSERT INTO puntos_fidelizacion (id_perfil, id_estadia_origen, id_regla_acum, tipo_movimiento, puntos, fecha, estado)
SELECT pf.id_perfil, e.id_estadia, r.id_regla_acum, 'ACUMULACION', e.noches * r.puntos_por_noche + floor(coalesce(p.pagado, 0) / r.monto_base)::int * r.puntos_por_monto,
       (e.ts_out + interval '30 minutes')::timestamp, CASE WHEN e.ts_out < (SELECT ahora FROM cfg) - interval '1 day' THEN 'ACREDITADO' ELSE 'PENDIENTE' END
FROM t_est e JOIN perfil_huesped pf ON pf.id_huesped = e.id_huesped
JOIN regla_acumulacion r ON r.activa AND e.salida BETWEEN r.fecha_inicio AND coalesce(r.fecha_fin, 'infinity'::date)
LEFT JOIN (SELECT c.id_estadia, sum(co.monto) AS pagado FROM t_cta c JOIN cobro co ON co.id_cuenta = c.id AND co.estado = 'REGISTRADO' WHERE c.id_estadia IS NOT NULL GROUP BY 1) p ON p.id_estadia = e.id_estadia
WHERE e.estado_est = 'FINALIZADA' AND e.noches * r.puntos_por_noche > 0 ORDER BY e.ts_out;

CREATE TEMP TABLE t_canje ON COMMIT DROP AS
SELECT s.id_perfil, b.id_beneficio, b.puntos_requeridos, s.ultima + (1 + random() * 25) * interval '1 day' AS f
FROM (SELECT id_perfil, sum(puntos) AS saldo, max(fecha) AS ultima FROM puntos_fidelizacion WHERE estado = 'ACREDITADO' GROUP BY 1 HAVING sum(puntos) >= 200) s
CROSS JOIN LATERAL (SELECT * FROM beneficio WHERE activo AND puntos_requeridos <= s.saldo ORDER BY random() LIMIT 1) b
WHERE random() < 0.25;
INSERT INTO puntos_fidelizacion (id_perfil, id_beneficio, tipo_movimiento, puntos, fecha, estado)
SELECT id_perfil, id_beneficio, 'CANJE', -puntos_requeridos, f, 'ACREDITADO' FROM t_canje WHERE f < (SELECT ahora FROM cfg)::timestamp ORDER BY f;
INSERT INTO puntos_fidelizacion (id_perfil, id_estadia_origen, tipo_movimiento, puntos, fecha, estado)
SELECT a.id_perfil, a.id_estadia_origen, 'REVERSION', -a.puntos, a.fecha + interval '2 days', 'ACREDITADO'
FROM puntos_fidelizacion a WHERE a.tipo_movimiento = 'ACUMULACION' AND a.estado = 'ACREDITADO' AND a.fecha < (SELECT ahora FROM cfg)::timestamp - interval '10 days'
  AND a.id_perfil NOT IN (SELECT id_perfil FROM t_canje) AND random() < 0.004;
INSERT INTO puntos_fidelizacion (id_perfil, tipo_movimiento, puntos, fecha, estado)
SELECT id_perfil, 'AJUSTE', 50, fecha + interval '3 days', 'ACREDITADO' FROM puntos_fidelizacion
WHERE tipo_movimiento = 'ACUMULACION' AND estado = 'ACREDITADO' AND fecha < (SELECT ahora FROM cfg)::timestamp - interval '10 days' AND random() < 0.003;
UPDATE puntos_fidelizacion SET estado = 'ANULADO'
WHERE id_movimiento IN (SELECT id_movimiento FROM puntos_fidelizacion a WHERE tipo_movimiento = 'ACUMULACION' AND estado = 'ACREDITADO' AND id_perfil NOT IN (SELECT id_perfil FROM t_canje)
                          AND id_estadia_origen NOT IN (SELECT id_estadia_origen FROM puntos_fidelizacion WHERE tipo_movimiento = 'REVERSION') AND random() < 0.002);

-- ----------------------------------------------------------------- opiniones del huesped (resena o encuesta) y su clasificacion de sentimiento
CREATE TEMP TABLE t_op ON COMMIT DROP AS
SELECT e.id_estadia, pf.id_perfil, e.ts_out, rc.motivo, rc.area, rc.id_estadia IS NOT NULL AS reclamo,
       CASE WHEN rc.id_estadia IS NOT NULL THEN (CASE WHEN random() < 0.70 THEN 'NEGATIVO' WHEN random() < 0.67 THEN 'NEUTRO' ELSE 'POSITIVO' END)
            ELSE (CASE WHEN random() < 0.90 THEN 'POSITIVO' WHEN random() < 0.8 THEN 'NEUTRO' ELSE 'NEGATIVO' END) END AS real_s,
       random() < 0.55 AS es_resena, random() AS r1, random() AS r2, random() AS r3
FROM t_est e JOIN perfil_huesped pf ON pf.id_huesped = e.id_huesped LEFT JOIN t_rcl rc ON rc.id_estadia = e.id_estadia
WHERE e.estado_est = 'FINALIZADA' AND e.ts_out < (SELECT ahora FROM cfg) - interval '2 days' AND random() < 0.45;
ALTER TABLE t_op ADD COLUMN texto text, ADD COLUMN s_ia text, ADD COLUMN conf numeric, ADD COLUMN est text, ADD COLUMN crit boolean DEFAULT false;
UPDATE t_op SET texto = CASE WHEN es_resena OR r3 < 0.4 THEN
   (CASE real_s WHEN 'POSITIVO' THEN pg_temp.pick(ARRAY['Excelente atención del personal y la habitación estaba impecable.', 'Muy buena ubicación y el desayuno estuvo delicioso. Volveremos.', 'Personal amable, cama muy cómoda y todo funcionó bien.',
                                                         'Una estadía tranquila; el check-in fue rápido y el room service llegó a tiempo.', 'Limpieza perfecta y buen precio por lo que ofrece. Lo recomiendo.', 'El restaurante de la terraza tiene platos muy buenos, sobre todo el ají de gallina.'])
                 WHEN 'NEUTRO' THEN pg_temp.pick(ARRAY['Buen hotel en general, aunque el desayuno podría tener más variedad.', 'La habitación estaba bien, pero el ruido de la avenida se escuchaba de noche.', 'Cumple lo básico; la atención fue correcta sin más.'])
                 ELSE pg_temp.pick(ARRAY['Tuvimos problemas con el aire acondicionado y tardaron en resolverlo.', 'El ruido de la calle no nos dejó dormir y la respuesta del personal fue lenta.', 'La habitación no estaba lista a la hora del check-in y la limpieza dejó que desear.',
                                         'Nos cobraron un consumo que no hicimos; tuvimos que reclamar en recepción.', 'El WiFi no funcionó y nadie pudo solucionarlo durante la estadía.']) END) END;
UPDATE t_op SET s_ia = CASE WHEN texto IS NULL OR r2 < 0.10 THEN NULL ELSE real_s END;
UPDATE t_op SET conf = CASE WHEN r2 BETWEEN 0.10 AND 0.18 THEN round((0.50 + random() * 0.18)::numeric, 4) ELSE round((0.80 + random() * 0.19)::numeric, 4) END WHERE s_ia IS NOT NULL;
UPDATE t_op SET est = CASE WHEN s_ia IS NULL THEN 'PENDIENTE' WHEN conf < 0.70 THEN 'EN_REVISION' ELSE 'CLASIFICADA' END;
UPDATE t_op SET crit = true, area = coalesce(area, 1 + floor(random() * 6)::int) WHERE s_ia = 'NEGATIVO' AND est = 'CLASIFICADA' AND r1 < 0.30;
UPDATE t_op SET area = coalesce(area, 1 + floor(random() * 6)::int) WHERE s_ia = 'NEGATIVO' AND est = 'CLASIFICADA';
UPDATE t_op SET area = NULL WHERE s_ia IS DISTINCT FROM 'NEGATIVO';

INSERT INTO opinion (id_perfil, id_estadia, id_area, tipo_opinion, texto_seudonimizado, sentimiento_ia, confianza, es_critica, estado_clasificacion, fecha_recepcion)
SELECT id_perfil, id_estadia, area, CASE WHEN es_resena THEN 'RESENA' ELSE 'ENCUESTA' END, texto, s_ia, conf, crit, est, ts_out::timestamp + (1 + random() * 46) * interval '1 hour' FROM t_op ORDER BY ts_out;
INSERT INTO resena (id_opinion, calificacion, titulo)
SELECT o.id_opinion, CASE t.real_s WHEN 'POSITIVO' THEN CASE WHEN random() < 0.7 THEN 5 ELSE 4 END WHEN 'NEUTRO' THEN 3 ELSE 1 + (random() < 0.5)::int END,
       CASE t.real_s WHEN 'POSITIVO' THEN pg_temp.pick(ARRAY['Excelente estadía', 'Muy recomendable', 'Gran atención', 'Volveremos pronto']) WHEN 'NEUTRO' THEN pg_temp.pick(ARRAY['Buena, pero mejorable', 'Cumple lo esperado']) ELSE pg_temp.pick(ARRAY['No cumplió mis expectativas', 'Servicio deficiente', 'Tuve varios inconvenientes']) END
FROM t_op t JOIN opinion o ON o.id_estadia = t.id_estadia WHERE t.es_resena;
INSERT INTO encuesta (id_opinion, puntaje, recomendaria)
SELECT o.id_opinion, CASE t.real_s WHEN 'POSITIVO' THEN 9 + (random() < 0.6)::int WHEN 'NEUTRO' THEN 7 + (random() < 0.5)::int ELSE floor(random() * 7)::int END,
       t.real_s <> 'NEGATIVO' FROM t_op t JOIN opinion o ON o.id_estadia = t.id_estadia WHERE NOT t.es_resena;

-- ----------------------------------------------------------------- campanas: programada -> activa (envios a los perfiles del segmento) -> cerrada o cancelada
DO $campanas$
DECLARE
  c record; v_ini date; v_hoy date; id_c int; seg int; n int := 0;
BEGIN
  SELECT ini, hoy INTO v_ini, v_hoy FROM cfg;
  FOR c IN SELECT * FROM (VALUES
     ('Bienvenida a nuevos huéspedes', 'SEG003', 'NOTIFICACION', v_ini + 25, v_ini + 100, 'CERRADA', 'Gracias por alojarte con nosotros. En tu próxima reserva directa tienes 10 % de descuento.'),
     ('Beneficios para huéspedes frecuentes', 'SEG002', 'CORREO', v_ini + 60, v_ini + 140, 'CERRADA', 'Por tu fidelidad, disfruta de un desayuno de cortesía en tu próxima estadía.'),
     ('Programa Preferente: upgrade de cortesía', 'SEG001', 'CORREO', v_ini + 120, v_ini + 200, 'CERRADA', 'Como huésped preferente, te reservamos un upgrade de habitación sujeto a disponibilidad.'),
     ('Promoción Fiestas Patrias', 'SEG002', 'CORREO', v_ini + 170, v_ini + 190, 'CERRADA', 'Celebra Fiestas Patrias en Lima: 15 % de descuento reservando en nuestra web.'),
     ('Reactivación de huéspedes', 'SEG003', 'CORREO', v_ini + 215, v_ini + 245, 'CANCELADA', 'Te extrañamos: vuelve con una tarifa especial.'),
     ('Fin de semana largo', 'SEG003', 'NOTIFICACION', v_hoy - 6, v_hoy + 12, 'ACTIVA', 'Escápate a Lima este fin de semana largo con late check-out gratuito.'),
     ('Navidad y Año Nuevo en Lima', 'SEG001', 'CORREO', v_hoy + 14, v_hoy + 50, 'PROGRAMADA', 'Reserva tu estadía de fin de año con anticipación y asegura tu tarifa preferente.')
  ) v(nombre, seg, canal, f1, f2, destino, msg) LOOP
    n := n + 1;
    SELECT id_segmento INTO seg FROM segmento WHERE codigo_segmento = c.seg;
    INSERT INTO campana (codigo_campana, id_segmento, nombre, canal, mensaje, fecha_inicio, fecha_fin)
    VALUES ('CMP-' || to_char(c.f1, 'YYYY') || '-' || lpad(n::text, 3, '0'), seg, c.nombre, c.canal, c.msg, c.f1, c.f2) RETURNING id_campana INTO id_c;
    IF c.destino = 'CANCELADA' THEN UPDATE campana SET estado = 'CANCELADA' WHERE id_campana = id_c; CONTINUE; END IF;
    IF c.destino = 'PROGRAMADA' THEN CONTINUE; END IF;
    UPDATE campana SET estado = 'ACTIVA' WHERE id_campana = id_c;
    INSERT INTO envio_campana (id_campana, id_perfil, fecha_envio, estado_envio)
    SELECT id_c, id_perfil, c.f1::timestamp + time '09:00' + random() * interval '3 hours', CASE WHEN random() < 0.05 THEN 'FALLIDO' ELSE 'ENVIADO' END
    FROM perfil_huesped WHERE id_segmento = seg ORDER BY random() LIMIT 70;
    IF c.destino = 'CERRADA' THEN UPDATE campana SET estado = 'CERRADA' WHERE id_campana = id_c; END IF;
  END LOOP;
END
$campanas$;

