FROM (VALUES ('Aire acondicionado split', 'Limpieza de filtros y revisión de gas refrigerante', 'Meses', 3),
             ('Televisor Smart TV', 'Revisión de conexiones y actualización de firmware', 'Meses', 12),
             ('Frigobar', 'Limpieza de condensador y verificación de temperatura', 'Meses', 6),
             ('Caja fuerte digital', 'Cambio de baterías y prueba de apertura', 'Meses', 6),
             ('Ascensor', 'Inspección mensual de seguridad y lubricación', 'Meses', 1),
             ('Terma a gas', 'Revisión de quemador, válvulas y termostato', 'Meses', 3),
             ('Bomba de agua', 'Lubricación y prueba de presión', 'Meses', 2),
             ('Grupo electrógeno', 'Prueba de arranque y cambio de aceite', 'HorasUso', 250),
             ('Lavadora industrial', 'Revisión de rodamientos y mangueras', 'Semanas', 12)) x(tipo, tarea, per, val)
JOIN tipo_activo ta ON ta.nombre = x.tipo;

-- ultima y proxima ejecucion de cada plan por activo (la proxima ya respeta la periodicidad)
INSERT INTO programacion_preventiva (id_plan, id_activo, fecha_ultima_ejecucion, fecha_proxima_ejecucion, horas_ultima_ejecucion, horas_proxima_ejecucion)
SELECT p.id_plan, a.id_activo,
       CASE WHEN p.tipo_periodicidad <> 'HorasUso' THEN u.ult END,
       CASE WHEN p.tipo_periodicidad <> 'HorasUso' THEN u.ult + CASE p.tipo_periodicidad WHEN 'Meses' THEN p.valor_periodicidad * 30 ELSE p.valor_periodicidad * 7 END END,
       CASE WHEN p.tipo_periodicidad = 'HorasUso' THEN a.horas_uso_acumuladas - (a.horas_uso_acumuladas % 250) END,
       CASE WHEN p.tipo_periodicidad = 'HorasUso' THEN a.horas_uso_acumuladas - (a.horas_uso_acumuladas % 250) + 250 END
FROM plan_mantenimiento p JOIN activo a ON a.id_tipo_activo = p.id_tipo_activo
CROSS JOIN LATERAL (SELECT (SELECT hoy FROM cfg) - (5 + (a.id_activo * 11) % (CASE p.tipo_periodicidad WHEN 'Meses' THEN p.valor_periodicidad * 30 ELSE p.valor_periodicidad * 7 END))::int AS ult) u;
-- =====================================================================
-- 2. FUNCIONES DE PERSONAS Y GRUPOS (familias, abuelos, parejas, amigos, compañeros de trabajo) Y PLAN DE OCUPACION
-- =====================================================================
CREATE OR REPLACE FUNCTION pg_temp.nombre(sx text, ext boolean) RETURNS text LANGUAGE sql VOLATILE AS
$$ SELECT pg_temp.pick(CASE WHEN ext THEN (CASE sx WHEN 'M' THEN em ELSE ef END) ELSE (CASE sx WHEN 'M' THEN nm ELSE nf END) END) FROM arr $$;

CREATE OR REPLACE FUNCTION pg_temp.apell(ext boolean) RETURNS text LANGUAGE sql VOLATILE AS
$$ SELECT pg_temp.pick(CASE WHEN ext THEN eap ELSE ap END) FROM arr $$;

-- persona del grupo: DNI (peruanos) o pasaporte (extranjeros); los peruanos llevan dos apellidos
CREATE OR REPLACE FUNCTION pg_temp.persona(sx text, ext boolean, nom text, a1 text, a2 text) RETURNS jsonb LANGUAGE sql VOLATILE AS
$$ SELECT jsonb_build_object('n', nom, 'a', CASE WHEN ext THEN a1 ELSE a1 || ' ' || a2 END, 'td', CASE WHEN ext THEN 'PAS' ELSE 'DNI' END,
          'doc', CASE WHEN ext THEN pg_temp.pasaporte(nextval('pg_temp.sq_persona')) ELSE pg_temp.dni(nextval('pg_temp.sq_persona')) END, 'sx', sx) $$;

CREATE OR REPLACE FUNCTION pg_temp.grupo(tipo text, tsx text, ta1 text, ta2 text, ext boolean, n int) RETURNS jsonb LANGUAGE plpgsql VOLATILE AS
$$
DECLARE
  p jsonb := '[]'::jsonb; otro text := CASE tsx WHEN 'M' THEN 'F' ELSE 'M' END; sx2 text;
  sp_a1 text; padre text; madre text; nota text; hijos int; con_pareja boolean; i int; ed int; edades int[] := '{}'; hsx text; txt text; sx_k text;
BEGIN
  IF tipo = 'Pareja' THEN
    sx2 := CASE WHEN random() < 0.92 THEN otro ELSE tsx END;
    sp_a1 := CASE WHEN ext AND random() < 0.6 THEN ta1 ELSE pg_temp.apell(ext) END;
    p := p || pg_temp.persona(sx2, ext, pg_temp.nombre(sx2, ext), sp_a1, pg_temp.apell(ext));
    nota := pg_temp.pick(ARRAY['Pareja en viaje de aniversario. Solicita cama matrimonial.', 'Pareja en luna de miel. Solicita decoración con pétalos y espumante.',
                               'Escapada de fin de semana en pareja.', 'Pareja de turistas. Solicita late check-out.', 'Viaje de pareja por cumpleaños. Pide habitación en piso alto.', NULL, NULL]);
  ELSIF tipo IN ('Familia', 'Abuelos') THEN
    con_pareja := (tipo = 'Abuelos') OR (n >= 3 AND NOT (n = 3 AND random() < 0.15));
    hijos := n - 1 - (CASE WHEN con_pareja THEN 1 ELSE 0 END) - (CASE WHEN tipo = 'Abuelos' THEN 1 ELSE 0 END);
    IF con_pareja THEN
      sp_a1 := CASE WHEN ext AND random() < 0.8 THEN ta1 ELSE pg_temp.apell(ext) END;
      p := p || pg_temp.persona(otro, ext, pg_temp.nombre(otro, ext), sp_a1, pg_temp.apell(ext));
    ELSE
      sp_a1 := pg_temp.apell(ext);
    END IF;
    -- en Peru los hijos llevan el primer apellido del padre y el de la madre
    padre := CASE WHEN tsx = 'M' THEN ta1 ELSE sp_a1 END;
    madre := CASE WHEN tsx = 'M' THEN sp_a1 ELSE ta1 END;
    IF tipo = 'Abuelos' THEN   -- abuelo o abuela del titular: llevan los apellidos del titular (linea paterna o materna)
      IF random() < 0.5 THEN
        p := p || pg_temp.persona('M', ext, pg_temp.nombre('M', ext), ta1, pg_temp.apell(ext));
      ELSE
        p := p || pg_temp.persona('F', ext, pg_temp.nombre('F', ext), CASE WHEN ext THEN ta1 ELSE ta2 END, pg_temp.apell(ext));
      END IF;
    END IF;
    FOR i IN 1..hijos LOOP
      hsx := CASE WHEN random() < 0.5 THEN 'M' ELSE 'F' END;
      ed := 1 + floor(random() * 15)::int; edades := edades || ed;
      p := p || pg_temp.persona(hsx, ext, (SELECT pg_temp.pick(CASE hsx WHEN 'M' THEN hm ELSE hf END) FROM arr),
                                padre, CASE WHEN con_pareja OR ext THEN madre ELSE pg_temp.apell(ext) END);
    END LOOP;
    IF tipo = 'Abuelos' THEN
      nota := 'Familia con adulto mayor y ' || hijos || ' niño. Solicita habitación en piso bajo, cerca del ascensor.';
    ELSE
      SELECT string_agg(e::text, ' y ' ORDER BY e) INTO txt FROM unnest(edades) e;
      nota := CASE WHEN con_pareja THEN 'Familia: 2 adultos' ELSE 'Madre/padre con ' END ||
              CASE WHEN con_pareja THEN ' y ' || hijos || CASE WHEN hijos = 1 THEN ' niño' ELSE ' niños' END ELSE hijos || CASE WHEN hijos = 1 THEN ' niño' ELSE ' niños' END END ||
              ' (' || txt || ' años).' ||
              CASE WHEN edades[1] <= 3 OR (array_length(edades, 1) > 1 AND least(edades[1], edades[2]) <= 3) THEN ' Solicita cuna.' WHEN random() < 0.4 THEN ' Solicita cama adicional.' ELSE '' END;
    END IF;
  ELSIF tipo IN ('Amigos', 'Trabajo') THEN
    FOR i IN 1..(n - 1) LOOP
      sx_k := CASE WHEN random() < (CASE tipo WHEN 'Amigos' THEN 0.6 ELSE 0.5 END) THEN tsx ELSE otro END;
      p := p || pg_temp.persona(sx_k, ext, pg_temp.nombre(sx_k, ext), pg_temp.apell(ext), pg_temp.apell(ext));
    END LOOP;
    nota := CASE tipo WHEN 'Amigos' THEN pg_temp.pick(ARRAY['Grupo de amigos de viaje turístico.', 'Amigos que asisten a un concierto en Lima.', 'Grupo de amigos por celebración de cumpleaños.'])
                      ELSE 'Viaje de trabajo en comisión de servicio. Facturar a nombre de la empresa.' END;
  ELSE
    nota := CASE WHEN random() < 0.30 THEN pg_temp.pick(ARRAY['Llegada tarde por vuelo; solicita check-in anticipado.', 'Viaje de negocios: solicita escritorio y buena señal de internet.',
                                                              'Alergia a las plumas: solicita almohadas sintéticas.', 'Solicita habitación silenciosa, lejos del ascensor.',
                                                              'Primera visita a Lima por turismo.', 'Solicita factura.']) END;
  END IF;
  RETURN jsonb_build_object('p', p, 'nota', nota);
END
$$;

-- ---------------------------------------------------------------- plan de ocupacion por habitacion
CREATE TEMP TABLE t_plan (n serial, id_hab bigint, tipo text, ingreso date, salida date, sub text) ON COMMIT DROP;

DO $plan$
DECLARE
  h record; d date; noches int; s date; gap int; v_ini date; v_fin date; v_hoy date; total int;
BEGIN
  SELECT ini, fin, hoy INTO v_ini, v_fin, v_hoy FROM cfg;
  FOR h IN SELECT id_habitacion FROM t_hab ORDER BY id_habitacion LOOP
    d := v_ini + floor(random() * 4)::int;
    WHILE d < v_fin LOOP
      noches := pg_temp.wpick(ARRAY['1', '2', '3', '4', '5', '6', '7', '9'], ARRAY[22, 28, 22, 10, 6, 4, 5, 3]::numeric[])::int;
      s := d + noches;
      EXIT WHEN s > v_fin + 5;
      INSERT INTO t_plan (id_hab, tipo, ingreso, salida) VALUES (h.id_habitacion, 'estadia', d, s);
      gap := floor(pg_temp.expo(CASE WHEN extract(month FROM s) IN (12, 1, 7, 8) THEN 1.3 ELSE 2.4 END))::int;
      IF gap >= 2 AND random() < 0.10 AND s + 1 < v_fin THEN
        INSERT INTO t_plan (id_hab, tipo, ingreso, salida, sub) VALUES (h.id_habitacion, 'bloqueo', s + 1, s + 2, CASE WHEN random() < 0.6 THEN 'Profunda' ELSE 'Mantenimiento' END);
      END IF;
      d := s + gap;
    END LOOP;
  END LOOP;
  SELECT count(*) INTO total FROM t_plan WHERE tipo = 'estadia';
  -- reservas canceladas (12 %) y no-show (3 %): no ocupan la habitacion
  INSERT INTO t_plan (id_hab, tipo, ingreso, salida)
  SELECT (SELECT id_habitacion FROM t_hab ORDER BY id_habitacion OFFSET ((g * 7 + floor(random() * 40)::int) % 40) LIMIT 1), 'cancelada', f.dia, f.dia + 1 + floor(random() * 4)::int
  FROM generate_series(1, (total * 0.12)::int) g, LATERAL (SELECT v_ini + 3 + floor(random() * (v_fin - v_ini - 8))::int AS dia WHERE g > 0) f;
  INSERT INTO t_plan (id_hab, tipo, ingreso, salida)
  SELECT (SELECT id_habitacion FROM t_hab ORDER BY id_habitacion OFFSET ((g * 11 + floor(random() * 40)::int) % 40) LIMIT 1), 'noshow', f.dia, f.dia + 1 + floor(random() * 3)::int
  FROM generate_series(1, (total * 0.03)::int) g, LATERAL (SELECT v_ini + 3 + floor(random() * greatest(v_hoy - v_ini - 8, 1))::int AS dia WHERE g > 0) f;
END
$plan$;

-- comprobacion rapida del plan (se quita al final)
-- =====================================================================
-- 3. CICLO DE LIMPIEZA (G2): orden, asignacion, inicio, fin, inspeccion y habilitacion de la habitacion, con sus fechas reales
-- =====================================================================
CREATE OR REPLACE FUNCTION pg_temp.notificar(p_pers bigint, p_tipo text, p_msg text, p_ref_tipo text, p_ref bigint, p_ts timestamptz) RETURNS void LANGUAGE plpgsql VOLATILE AS
$$
DECLARE v_ahora timestamptz; lei boolean;
BEGIN
  SELECT ahora INTO v_ahora FROM cfg;
  lei := p_ts < v_ahora - interval '2 days';
  INSERT INTO notificacion (id_personal, tipo_evento, mensaje, tipo_referencia, id_referencia, leida, fecha_hora_generacion, fecha_hora_lectura)
  VALUES (p_pers, p_tipo, left(p_msg, 200), p_ref_tipo, p_ref, lei, p_ts, CASE WHEN lei THEN p_ts + (2 + random() * 90) * interval '1 minute' END);
END
$$;

CREATE OR REPLACE FUNCTION pg_temp.limpieza(p_hab bigint, p_est bigint, p_tipo text, p_origen text, p_prior text, p_ts timestamptz, p_min int, p_cambia boolean,
                                            OUT est_final text, OUT ts_dis timestamptz, OUT nro bigint) LANGUAGE plpgsql VOLATILE AS
$$
DECLARE
  v_ahora timestamptz; fd date; pref text; cl bigint; tn text; sup bigint; num text;
  t_asg timestamptz; t_ini timestamptz; t_fin timestamptz; t_ins timestamptz; t_ini2 timestamptz; t_fin2 timestamptz; t_dis timestamptz;
  dur interval; insp boolean; noconf boolean; cl2 bigint; tn2 text; motivo text;
BEGIN
  SELECT ahora INTO v_ahora FROM cfg;
  est_final := NULL; ts_dis := NULL;
  fd := p_ts::date;
  pref := CASE WHEN extract(hour FROM p_ts) < 13 THEN 'M' ELSE 'T' END;
  SELECT id_personal, id_turno INTO cl, tn FROM programacion_turno
   WHERE fecha = fd AND disponible AND id_personal IN (SELECT id_personal FROM t_limp)
   ORDER BY (id_turno = pref) DESC, random() LIMIT 1;
  IF cl IS NULL THEN RETURN; END IF;
  SELECT numero INTO num FROM t_hab WHERE id_habitacion = p_hab;
  INSERT INTO orden_limpieza (id_habitacion, id_estadia, id_turno, fecha_programada, tipo_limpieza, origen, prioridad, estado, fecha_hora_creacion, observaciones)
  VALUES (p_hab, CASE WHEN p_tipo = 'Salida' THEN p_est END, tn, fd, p_tipo, p_origen, p_prior, 'Pendiente', p_ts,
          CASE p_tipo WHEN 'Salida' THEN CASE WHEN p_prior = 'Alta' THEN 'Ingresa un huésped hoy: priorizar.' END
                      WHEN 'Profunda' THEN 'Limpieza profunda: colchón, alfombra, cortinas y ductos.' ELSE NULL END)
  RETURNING numero_orden INTO nro;
  est_final := 'SUC';
  t_asg := p_ts + (3 + random() * 20) * interval '1 minute';
  IF t_asg > v_ahora THEN RETURN; END IF;
  INSERT INTO asignacion_limpieza (numero_orden, id_personal, fecha_hora_asignacion, origen_asignacion, vigente)
  VALUES (nro, cl, t_asg, CASE WHEN random() < 0.3 THEN 'PropuestaIA' ELSE 'Manual' END, true);
  UPDATE orden_limpieza SET estado = 'Asignada' WHERE numero_orden = nro;
  IF random() < 0.10 THEN PERFORM pg_temp.notificar(cl, 'OrdenAsignada', 'Se le asignó la limpieza de la habitación ' || num || '.', 'OrdenLimpieza', nro, t_asg); END IF;
  dur := (p_min * (0.8 + random() * 0.4)) * interval '1 minute';
  t_ini := greatest(t_asg + (10 + random() * 30) * interval '1 minute', CASE tn WHEN 'T' THEN (fd + time '15:00')::timestamptz + random() * interval '20 minutes' ELSE (fd + time '07:00')::timestamptz END);
  IF t_ini > v_ahora THEN RETURN; END IF;
  UPDATE orden_limpieza SET estado = 'En limpieza', fecha_hora_inicio = t_ini WHERE numero_orden = nro;
  IF p_cambia THEN
    INSERT INTO cambio_estado_habitacion (id_habitacion, id_estado_anterior, id_estado_nuevo, id_personal, fecha_hora, origen) VALUES (p_hab, 'SUC', 'ELI', cl, t_ini, 'Limpieza');
    est_final := 'ELI';
  END IF;
  t_fin := t_ini + dur;
  IF t_fin > v_ahora THEN RETURN; END IF;
  insp := p_tipo IN ('Salida', 'Profunda') AND random() < CASE p_tipo WHEN 'Profunda' THEN 1 ELSE 0.45 END;
  noconf := insp AND p_tipo = 'Salida' AND random() < 0.05 AND t_fin < v_ahora - interval '2 days';
  IF p_cambia THEN
    INSERT INTO cambio_estado_habitacion (id_habitacion, id_estado_anterior, id_estado_nuevo, id_personal, fecha_hora, origen) VALUES (p_hab, 'ELI', 'LIM', cl, t_fin, 'Limpieza');
    est_final := 'LIM';
  END IF;
  IF NOT insp THEN
    UPDATE orden_limpieza SET estado = 'Cerrada', fecha_hora_fin = t_fin WHERE numero_orden = nro;
    IF p_cambia THEN
      t_dis := t_fin + (5 + random() * 20) * interval '1 minute';
      IF t_dis <= v_ahora THEN
        INSERT INTO cambio_estado_habitacion (id_habitacion, id_estado_anterior, id_estado_nuevo, fecha_hora, origen, motivo) VALUES (p_hab, 'LIM', 'DIS', t_dis, 'Manual', 'Habitación lista para la venta');
        est_final := 'DIS'; ts_dis := t_dis;
      END IF;
    END IF;
    RETURN;
  END IF;
  UPDATE orden_limpieza SET estado = 'Pendiente inspección', fecha_hora_fin = t_fin WHERE numero_orden = nro;
  t_ins := t_fin + (10 + random() * 30) * interval '1 minute';
  IF t_ins > v_ahora THEN RETURN; END IF;
  SELECT id_personal INTO sup FROM t_pers WHERE cargo = 'Supervisor' AND k <= 2 ORDER BY random() LIMIT 1;
  IF noconf THEN
    motivo := pg_temp.pick(ARRAY['Cabello en el baño y espejo con manchas.', 'Cama mal tendida y almohadas sin funda limpia.', 'Piso del baño con residuos de jabón.', 'Polvo visible en el escritorio y los zócalos.', 'Falta reponer amenities y toallas.']);
    INSERT INTO inspeccion (numero_orden, id_supervisor, resultado, motivo_rechazo, lista_verificacion, fecha_hora)
    VALUES (nro, sup, 'No conforme', motivo, jsonb_build_object('cama', true, 'bano', false, 'superficies', false, 'amenities', random() < 0.5), t_ins);
    PERFORM pg_temp.notificar(cl, 'InspeccionRechazada', 'Inspección no conforme en la habitación ' || num || ': ' || motivo, 'OrdenLimpieza', nro, t_ins);
    SELECT id_personal, id_turno INTO cl2, tn2 FROM programacion_turno WHERE fecha = fd AND disponible AND id_turno = tn AND id_personal IN (SELECT id_personal FROM t_limp) ORDER BY (id_personal = cl) DESC LIMIT 1;
    UPDATE asignacion_limpieza SET vigente = false WHERE numero_orden = nro;
    UPDATE orden_limpieza SET estado = 'Pendiente inspección' WHERE numero_orden = nro;   -- la orden sigue abierta
    INSERT INTO asignacion_limpieza (numero_orden, id_personal, fecha_hora_asignacion, origen_asignacion, motivo_reasignacion, vigente)
    VALUES (nro, coalesce(cl2, cl), t_ins + interval '3 minutes', 'Manual', 'Reproceso por inspección no conforme', true);
    t_ini2 := t_ins + (10 + random() * 15) * interval '1 minute'; t_fin2 := t_ini2 + dur * 0.5;
    UPDATE orden_limpieza SET fecha_hora_inicio = t_ini2, fecha_hora_fin = t_fin2 WHERE numero_orden = nro;
    INSERT INTO cambio_estado_habitacion (id_habitacion, id_estado_anterior, id_estado_nuevo, id_personal, fecha_hora, origen, motivo) VALUES (p_hab, 'LIM', 'ELI', coalesce(cl2, cl), t_ini2, 'Limpieza', 'Reproceso por inspección no conforme');
    INSERT INTO cambio_estado_habitacion (id_habitacion, id_estado_anterior, id_estado_nuevo, id_personal, fecha_hora, origen) VALUES (p_hab, 'ELI', 'LIM', coalesce(cl2, cl), t_fin2, 'Limpieza');
    t_ins := t_fin2 + (10 + random() * 15) * interval '1 minute';
  END IF;
  INSERT INTO inspeccion (numero_orden, id_supervisor, resultado, lista_verificacion, fecha_hora)
  VALUES (nro, sup, 'Conforme', jsonb_build_object('cama', true, 'bano', true, 'superficies', true, 'amenities', true, 'aire_acondicionado', true), t_ins);
  UPDATE orden_limpieza SET estado = 'Cerrada' WHERE numero_orden = nro;
  t_dis := t_ins + (3 + random() * 12) * interval '1 minute';
  IF t_dis <= v_ahora THEN
    INSERT INTO cambio_estado_habitacion (id_habitacion, id_estado_anterior, id_estado_nuevo, id_personal, fecha_hora, origen) VALUES (p_hab, 'LIM', 'DIS', sup, t_dis, 'Inspección');
    est_final := 'DIS'; ts_dis := t_dis;
  END IF;
END
$$;
