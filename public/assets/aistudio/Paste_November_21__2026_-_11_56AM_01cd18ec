INSERT INTO proyeccion_financiera (id_usuario, id_proyeccion_base, periodo, tipo, monto_estimado, flujo_caja_estimado, limite_inferior, limite_superior, version, supuestos, fecha_creacion)
SELECT a.jef, id, periodo, 'ESCENARIO', round(monto * 0.85, 2), round(monto * 0.85 * 0.8, 2), round(monto * 0.76, 2), round(monto * 0.94, 2), 2,
