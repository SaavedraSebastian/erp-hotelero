INSERT INTO log_auditoria (fecha_hora, usuario_app, operacion, tabla, id_registro, datos_nuevos)
SELECT (SELECT ahora FROM cfg)::timestamp - random() * interval '120 days', (ARRAY['atencion.mrios', 'atencion.jlopez', 'atencion.cvalle', 'auditoria.interna'])[1 + floor(random() * 4)::int], 'CONSULTA', 'perfil_huesped', id_perfil::text,
