-- DNI de 8 digitos, unico por numero de persona (multiplicador coprimo con 90 000 000)
CREATE OR REPLACE FUNCTION pg_temp.dni(n bigint) RETURNS text LANGUAGE sql IMMUTABLE AS
$$ SELECT (10000000 + (n * 7919) % 90000000)::text $$;
CREATE OR REPLACE FUNCTION pg_temp.pasaporte(n bigint) RETURNS text LANGUAGE sql IMMUTABLE AS
$$ SELECT chr(65 + (n % 26)::int) || chr(65 + ((n / 26) % 26)::int) || lpad(((n * 104729) % 10000000)::text, 7, '0') $$;
CREATE OR REPLACE FUNCTION pg_temp.celular(n bigint) RETURNS text LANGUAGE sql IMMUTABLE AS
$$ SELECT '9' || lpad(((n * 15485863) % 100000000)::text, 8, '0') $$;

