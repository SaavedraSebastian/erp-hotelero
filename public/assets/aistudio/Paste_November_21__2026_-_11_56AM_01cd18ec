-- ----------------------------------------------------------------- consumo semanal de cada articulo (platos, bebidas, amenities, limpieza y repuestos)
CREATE TEMP TABLE t_cons ON COMMIT DROP AS
SELECT art, semana, sum(qty) AS qty FROM (
  SELECT j.key AS art, date_trunc('week', c.fecha_hora_confirmacion)::date AS semana, dc.cantidad * j.value::numeric AS qty
  FROM g3_servicios.consumo c JOIN detalle_consumo dc ON dc.numero_consumo = c.numero_consumo
  JOIN t_item i ON i.id = dc.id_item_catalogo CROSS JOIN LATERAL jsonb_each_text(i.receta) j
  WHERE c.estado = 'confirmado' AND i.receta IS NOT NULL
  UNION ALL
  SELECT i.art_desc, date_trunc('week', c.fecha_hora_confirmacion)::date, dc.cantidad
  FROM g3_servicios.consumo c JOIN detalle_consumo dc ON dc.numero_consumo = c.numero_consumo
  JOIN t_item i ON i.id = dc.id_item_catalogo WHERE c.estado = 'confirmado' AND i.art_desc IS NOT NULL
  UNION ALL   -- amenities por huesped alojado (se reponen al hacer la habitacion)
  SELECT x.art, date_trunc('week', e.ts_out)::date, e.npers * x.q FROM t_est e
  CROSS JOIN (VALUES ('ART-JAB', 2), ('ART-SHA', 2), ('ART-ACO', 2), ('ART-GOR', 1)) x(art, q) WHERE e.estado_est = 'FINALIZADA'
  UNION ALL   -- limpieza e higiene por orden de limpieza
  SELECT x.art, date_trunc('week', o.fecha_hora_creacion)::date, x.q * CASE o.tipo_limpieza WHEN 'Salida' THEN 1.0 WHEN 'Profunda' THEN 2.5 ELSE 0.4 END
  FROM orden_limpieza o CROSS JOIN (VALUES ('ART-DET', 0.12), ('ART-DES', 0.08), ('ART-LEJ', 0.04), ('ART-BOL', 0.02), ('ART-PHI', 0.10)) x(art, q)
  UNION ALL   -- repuestos de mantenimiento por orden de trabajo
  SELECT x.art, date_trunc('week', ot.fecha_hora_creacion)::date, x.q FROM orden_trabajo ot
  CROSS JOIN (VALUES ('ART-FOC', 0.4), ('ART-PIL', 0.3), ('ART-FIL', 0.2)) x(art, q)
) z GROUP BY art, semana;

CREATE TEMP TABLE t_sem ON COMMIT DROP AS
SELECT s::date AS semana FROM cfg, generate_series(date_trunc('week', cfg.ini - 7)::date, date_trunc('week', cfg.hoy)::date, interval '7 days') s;

-- ----------------------------------------------------------------- ordenes de compra semanales por proveedor, recepciones y lotes
CREATE TEMP TABLE t_stk (art text PRIMARY KEY, saldo numeric) ON COMMIT DROP;
INSERT INTO t_stk SELECT art, ceil(sum(qty) * 1.4) FROM t_cons WHERE semana = (SELECT min(semana) FROM t_sem) + 7 GROUP BY art;
INSERT INTO t_stk SELECT id, 0 FROM t_art WHERE id NOT IN (SELECT art FROM t_stk);

CREATE TEMP TABLE t_oc (num text, prov text, f_orden timestamp, f_entrega date, total numeric, estado text, decision text, motivo text, f_decision timestamp,
                        medio text, f_envio timestamp, res_envio text, motivo_canc text) ON COMMIT DROP;
CREATE TEMP TABLE t_ocd (id text, num text, art text, qty numeric, precio numeric) ON COMMIT DROP;
CREATE TEMP TABLE t_rec (id text, num text, f timestamp, guia text, estado text, motivo text) ON COMMIT DROP;
CREATE TEMP TABLE t_recd (id text, rec text, ocd text, art text, lote text, recibida numeric, aceptada numeric, rechazada numeric, motivo text, costo numeric, f timestamp, vence date) ON COMMIT DROP;

DO $compras$
DECLARE
  v_ahora timestamp; v_ini date; w record; pr record; a record; freq int; plazo int; n int := 0; v_num text; f_ord timestamp; f_ent date; v_qty numeric; cobertura numeric;
  v_precio numeric; v_total numeric; stk numeric; f_rec timestamp; rid text; k int; v_estado text; r numeric; f_dec timestamp; tot_inicial numeric;
BEGIN
  SELECT ahora::timestamp, ini INTO v_ahora, v_ini FROM cfg;
  FOR w IN SELECT semana, row_number() OVER (ORDER BY semana) AS idx FROM t_sem LOOP
    FOR pr IN SELECT DISTINCT prov FROM t_art WHERE prov <> 10 ORDER BY prov LOOP
      freq := CASE WHEN pr.prov IN (1, 2, 3, 5, 9) THEN 1 WHEN pr.prov IN (4, 6) THEN 2 ELSE 4 END;
      CONTINUE WHEN (w.idx - 1) % freq <> 0;
      plazo := CASE WHEN pr.prov IN (1, 2, 3, 5, 9) THEN 1 WHEN pr.prov IN (4, 6) THEN 2 ELSE 3 END;
      f_ord := (w.semana - 1 - plazo)::timestamp + time '09:00' + random() * interval '2 hours';   -- se pide con la anticipacion del plazo para recibir el lunes
      CONTINUE WHEN f_ord > v_ahora;
      n := n + 1; v_num := 'OC-' || to_char(w.semana, 'YYYY') || '-' || lpad(n::text, 5, '0');
      f_ent := w.semana + (CASE WHEN pr.prov IN (1, 2, 3, 5, 9) AND random() < 0.15 THEN 1 ELSE 0 END);
      v_total := 0;
      FOR a IN SELECT * FROM t_art WHERE prov = pr.prov ORDER BY id LOOP
        SELECT coalesce(sum(qty), 0) INTO cobertura FROM t_cons WHERE art = a.id AND semana >= w.semana AND semana < w.semana + freq * 7;
        CONTINUE WHEN cobertura <= 0;
        SELECT saldo INTO stk FROM t_stk WHERE art = a.id;
        v_qty := greatest(0, ceil(cobertura * 1.06 + CASE WHEN a.cat IN ('CA-LIM', 'CA-AME', 'CA-REP') THEN 1.15 * coalesce((SELECT sum(qty) FROM t_cons WHERE art = a.id AND semana = w.semana), 0) ELSE a.minimo * 0.6 END - stk));
        CONTINUE WHEN v_qty = 0;
        IF a.um = 'UM-UN' AND v_qty > 30 THEN v_qty := ceil(v_qty / 10.0) * 10; END IF;
        v_precio := round(a.costo * (1 + 0.0006 * (w.semana - v_ini)), 2);
        INSERT INTO t_ocd VALUES ('OCD-' || v_num || '-' || a.id, v_num, a.id, v_qty, v_precio);
        UPDATE t_stk SET saldo = saldo + v_qty WHERE art = a.id;
        v_total := v_total + v_qty * v_precio;
      END LOOP;
      CONTINUE WHEN v_total = 0;
      f_dec := f_ord + (1 + random() * 3) * interval '1 hour';
      v_estado := CASE WHEN f_dec > v_ahora THEN 'pendiente de aprobación' WHEN f_ord + interval '5 hours' > v_ahora THEN 'aprobada'
                     WHEN f_ent::timestamp + time '12:00' > v_ahora THEN 'enviada' ELSE 'completada' END;
      INSERT INTO t_oc VALUES (v_num, 'PRV-' || lpad(pr.prov::text, 2, '0'), f_ord, f_ent, round(v_total, 2), v_estado,
                               CASE WHEN v_estado <> 'pendiente de aprobación' THEN 'aprobada' END, NULL, CASE WHEN v_estado <> 'pendiente de aprobación' THEN f_dec END,
                               CASE WHEN v_estado IN ('enviada', 'completada') THEN pg_temp.pick(ARRAY['correo electrónico', 'WhatsApp Business']) END,
                               CASE WHEN v_estado IN ('enviada', 'completada') THEN f_dec + interval '25 minutes' END,
                               CASE WHEN v_estado IN ('enviada', 'completada') THEN 'enviada' END, NULL);
      IF v_estado = 'completada' THEN
        f_rec := f_ent::timestamp + time '06:30' + random() * interval '50 minutes'; rid := 'REC-' || v_num;
        INSERT INTO t_rec VALUES (rid, v_num, f_rec, 'F001-' || lpad((10000 + n * 7)::text, 6, '0'), 'completada', NULL);
        FOR a IN SELECT d.*, t.vence, t.aviso FROM t_ocd d JOIN t_art t ON t.id = d.art WHERE d.num = v_num LOOP
          r := random();
          INSERT INTO t_recd VALUES ('RCD-' || a.id, rid, a.id, a.art, 'LOT-' || a.id, a.qty,
                                     CASE WHEN r < 0.03 THEN a.qty - round(a.qty * 0.1, 3) ELSE a.qty END, CASE WHEN r < 0.03 THEN round(a.qty * 0.1, 3) ELSE 0 END,
                                     CASE WHEN r < 0.03 THEN pg_temp.pick(ARRAY['Producto en mal v_estado', 'Empaque dañado', 'Temperatura inadecuada en la entrega']) END,
                                     a.precio, f_rec, CASE WHEN a.vence THEN (f_rec + (a.aviso * 2 + 2) * interval '1 day')::date END);
        END LOOP;
      END IF;
    END LOOP;
    UPDATE t_stk s SET saldo = s.saldo - coalesce((SELECT sum(c.qty) FROM t_cons c WHERE c.art = s.art AND c.semana = w.semana), 0) * 1.06;
  END LOOP;
  -- ordenes adicionales que no abastecen la operacion regular: rechazada, cancelada y recepcion parcial
  FOR pr IN SELECT s.semana, row_number() OVER (ORDER BY s.semana) AS i FROM t_sem s WHERE s.semana > v_ini + 15 AND s.semana < (SELECT hoy FROM cfg) - 20 AND (extract(week FROM s.semana)::int % 6 = 0) LOOP
    n := n + 1; v_num := 'OC-' || to_char(pr.semana, 'YYYY') || '-' || lpad(n::text, 5, '0'); f_ord := (pr.semana - 2)::timestamp + time '10:30';
    INSERT INTO t_ocd VALUES ('OCD-' || v_num || '-ART-AGU', v_num, 'ART-AGU', 120, 1.25), ('OCD-' || v_num || '-ART-VIN', v_num, 'ART-VIN', 24, 33);
    INSERT INTO t_oc VALUES (v_num, 'PRV-06', f_ord, pr.semana + 1, round(120 * 1.25 + 24 * 33, 2),
                             CASE pr.i % 3 WHEN 0 THEN 'rechazada' WHEN 1 THEN 'cancelada' ELSE 'parcialmente recibida' END,
                             CASE WHEN pr.i % 3 = 0 THEN 'rechazada' ELSE 'aprobada' END, CASE WHEN pr.i % 3 = 0 THEN 'Presupuesto del mes agotado; reprogramar para el siguiente periodo' END,
                             f_ord + interval '2 hours', CASE WHEN pr.i % 3 <> 0 THEN 'correo electrónico' END, CASE WHEN pr.i % 3 <> 0 THEN f_ord + interval '3 hours' END,
                             CASE WHEN pr.i % 3 <> 0 THEN 'enviada' END, CASE WHEN pr.i % 3 = 1 THEN 'El evento fue cancelado por el cliente' END);
    IF pr.i % 3 = 2 THEN
      rid := 'REC-' || v_num;
      INSERT INTO t_rec VALUES (rid, v_num, (pr.semana + 1)::timestamp + time '09:00', 'F001-' || lpad((20000 + n)::text, 6, '0'), 'parcial', NULL);
      INSERT INTO t_recd VALUES ('RCD-' || v_num || '-ART-AGU', rid, 'OCD-' || v_num || '-ART-AGU', 'ART-AGU', 'LOT-' || v_num || '-ART-AGU', 120, 120, 0, NULL, 1.25, (pr.semana + 1)::timestamp + time '09:00', NULL);
    END IF;
  END LOOP;
END
$compras$;

INSERT INTO orden_compra (numero_orden, id_proveedor, fecha_hora_preparacion, fecha_entrega_esperada, total_estimado, estado, decision_aprobacion, motivo_decision, fecha_hora_decision,
                          medio_envio, fecha_hora_envio, resultado_envio, motivo_cancelacion)
SELECT num, prov, f_orden, f_entrega, total, estado, decision, motivo, f_decision, medio, f_envio, res_envio, motivo_canc FROM t_oc ORDER BY f_orden;
INSERT INTO detalle_orden_compra (id_detalle_orden, numero_orden, id_articulo, cantidad_solicitada, precio_referencia_capturado) SELECT id, num, art, qty, precio FROM t_ocd;
INSERT INTO recepcion_compra (id_recepcion, numero_orden, fecha_hora, numero_guia_factura, estado) SELECT id, num, f, guia, estado FROM t_rec ORDER BY f;
INSERT INTO lote_articulo (id_lote, id_articulo, fecha_vencimiento, cantidad_disponible, costo_unitario)
SELECT lote, art, vence, CASE WHEN f > (SELECT ahora FROM cfg)::timestamp - interval '6 days' THEN aceptada * 0.5 ELSE 0 END, costo FROM t_recd;
INSERT INTO detalle_recepcion (id_detalle_recepcion, id_recepcion, id_detalle_orden, id_lote, cantidad_recibida, cantidad_aceptada, cantidad_rechazada, motivo_rechazo, costo_unitario)
SELECT id, rec, ocd, lote, recibida, aceptada, rechazada, motivo, costo FROM t_recd;

-- costo de cada compra recibida, enviado a Facturacion
INSERT INTO envio_externo (id_envio, destino, tipo_envio, id_referencia, estado, numero_intento, fecha_hora_intento)
SELECT 'ENV-CMP-' || lpad((row_number() OVER (ORDER BY f))::text, 5, '0'), 'Facturación y Finanzas', 'costo de compra', id, 'aceptado', 1, f + interval '20 minutes' FROM t_rec ORDER BY f;
-- costo de ventas mensual (resumen del almacen)
INSERT INTO envio_externo (id_envio, destino, tipo_envio, id_referencia, estado, numero_intento, fecha_hora_intento)
SELECT 'ENV-CV-' || to_char(m, 'YYYYMM'), 'Facturación y Finanzas', 'costo de ventas', 'CV-' || to_char(m, 'YYYY-MM'), 'aceptado', 1, (m + interval '1 month')::timestamp + time '07:00'
FROM cfg, generate_series(date_trunc('month', cfg.ini)::date, (date_trunc('month', cfg.hoy) - interval '1 month')::date, interval '1 month') m;

-- ----------------------------------------------------------------- insumos de Housekeeping (G2) vinculados a articulos del almacen
INSERT INTO insumo (codigo_insumo, id_articulo, nombre, tipo_insumo, unidad_medida, punto_reposicion, costo_unitario)
SELECT 'INS-' || lpad((row_number() OVER (ORDER BY a.id))::text, 4, '0'), a.id, a.nombre,
       CASE WHEN a.cat = 'CA-AME' THEN 'Amenity' WHEN a.cat = 'CA-REP' THEN 'Repuesto' ELSE 'Limpieza' END,
       CASE a.um WHEN 'UM-LT' THEN 'Litro' WHEN 'UM-PQ' THEN 'Caja' WHEN 'UM-KG' THEN 'Kg' ELSE 'Unidad' END, a.minimo, a.costo
FROM t_art a WHERE a.cat IN ('CA-LIM', 'CA-AME', 'CA-REP');

-- ----------------------------------------------------------------- kardex de G3 y kardex de insumos de G2, siempre en orden cronologico
CREATE TEMP TABLE t_kardex (id text, art text, tipo text, qty numeric, signo text, f timestamp, motivo text, origen text, modulo text, costo numeric, lote text) ON COMMIT DROP;
-- (1) inventario inicial: cubre la primera semana antes de la primera recepcion
INSERT INTO t_kardex
SELECT 'KX-INI-' || a.id, a.id, 'ajuste', ceil(sum(c.qty) * 1.4), 'entrada', (SELECT ini FROM cfg)::timestamp - interval '9 days' + time '08:00', 'Inventario inicial al implementar el sistema', 'INV-INICIAL', 'Almacén', a.costo, NULL
FROM t_art a JOIN t_cons c ON c.art = a.id AND c.semana = (SELECT min(semana) FROM t_sem) + 7 GROUP BY a.id, a.costo HAVING sum(c.qty) > 0;
-- (2) ingresos por compras recibidas
INSERT INTO t_kardex SELECT 'KX-ING-' || id, art, 'ingreso', aceptada, 'entrada', f, NULL, rec, 'Compras', costo, lote FROM t_recd WHERE aceptada > 0;
-- (3) salidas a cocina y bar (dos cortes por semana); los articulos de limpieza, amenities y repuestos salen a Housekeeping y Mantenimiento
INSERT INTO t_kardex
SELECT 'KX-SAL-' || c.art || '-' || c.semana || '-' || p.corte, c.art, 'salida', round(c.qty * p.frac, 3), 'salida',
       c.semana::timestamp + p.dia * interval '1 day' + time '17:30', NULL, 'CONSUMO-' || c.semana || '-' || p.corte, 'Almacén', a.costo, NULL
FROM t_cons c JOIN t_art a ON a.id = c.art CROSS JOIN (VALUES ('A', 0.43, 2), ('B', 0.57, 6)) p(corte, frac, dia)
WHERE a.cat NOT IN ('CA-LIM', 'CA-AME', 'CA-REP') AND round(c.qty * p.frac, 3) > 0
  AND c.semana::timestamp + p.dia * interval '1 day' + time '17:30' < (SELECT ahora FROM cfg)::timestamp;
INSERT INTO t_kardex
SELECT 'KX-HK-' || c.art || '-' || c.semana, c.art, 'salida', round(c.qty * 1.05, 3), 'salida', c.semana::timestamp + time '07:30', NULL, 'HKREQ-' || c.semana || '-' || c.art, 'Housekeeping y Mantenimiento', a.costo, NULL
FROM t_cons c JOIN t_art a ON a.id = c.art WHERE a.cat IN ('CA-LIM', 'CA-AME', 'CA-REP') AND c.semana::timestamp + time '07:30' < (SELECT ahora FROM cfg)::timestamp;
-- (4) mermas, vencimientos y ajustes por conteo fisico (cantidades pequenas, siempre cubiertas por el stock)
INSERT INTO t_kardex
SELECT 'KX-MER-' || c.art || '-' || c.semana, c.art, 'merma', greatest(round(c.qty * 0.015, 3), 0.001), 'salida', c.semana::timestamp + interval '4 days' + time '16:00',
       pg_temp.pick(ARRAY['Merma por manipulación en cocina', 'Producto dañado durante el almacenamiento', 'Pérdida por descongelamiento']), 'MERMA-' || c.semana, 'Almacén', a.costo, NULL
FROM t_cons c JOIN t_art a ON a.id = c.art WHERE a.vence AND a.cat IN ('CA-CAR', 'CA-PES', 'CA-VER', 'CA-LAC') AND (extract(week FROM c.semana)::int + length(c.art)) % 3 = 0
  AND c.semana::timestamp + interval '4 days' + time '16:00' < (SELECT ahora FROM cfg)::timestamp;
INSERT INTO t_kardex
SELECT 'KX-VEN-' || c.art || '-' || c.semana, c.art, 'vencimiento', greatest(round(c.qty * 0.01, 3), 0.001), 'salida', c.semana::timestamp + interval '5 days' + time '09:00',
       'Lote vencido retirado del almacén', 'VENC-' || c.semana, 'Almacén', a.costo, NULL
FROM t_cons c JOIN t_art a ON a.id = c.art WHERE a.vence AND a.cat IN ('CA-LAC', 'CA-BEB', 'CA-ABA') AND (extract(week FROM c.semana)::int + length(c.art)) % 11 = 0
  AND c.semana::timestamp + interval '5 days' + time '09:00' < (SELECT ahora FROM cfg)::timestamp;
INSERT INTO t_kardex
SELECT 'KX-AJU-' || c.art || '-' || c.semana, c.art, 'ajuste', greatest(round(c.qty * 0.01, 3), 0.001), CASE WHEN (extract(week FROM c.semana)::int) % 2 = 0 THEN 'entrada' ELSE 'salida' END,
       c.semana::timestamp + interval '6 days' + time '18:00', 'Ajuste por conteo físico de fin de mes', 'CONTEO-' || c.semana, 'Almacén', a.costo, NULL
FROM t_cons c JOIN t_art a ON a.id = c.art WHERE a.cat NOT IN ('CA-LIM', 'CA-AME', 'CA-REP') AND extract(day FROM c.semana + 6) <= 7 AND (length(c.art) + extract(month FROM c.semana)::int) % 4 = 0
  AND c.semana::timestamp + interval '6 days' + time '18:00' < (SELECT ahora FROM cfg)::timestamp;

INSERT INTO movimiento_inventario (id_movimiento, id_articulo, id_lote, tipo_movimiento, cantidad, signo, fecha_hora, saldo_posterior, motivo, id_origen, modulo_origen, costo_unitario)
SELECT id, art, lote, tipo, qty, signo, f, 0, motivo, origen, modulo, costo FROM t_kardex WHERE qty > 0 ORDER BY f, id;

-- movimientos de los insumos en G2: entrada semanal desde el almacen y consumo en dos cortes (el trigger de G2 calcula el stock)
INSERT INTO movimiento_insumo (id_insumo, id_personal, tipo_movimiento, cantidad, signo, costo_unitario, motivo, fecha_hora)
SELECT i.id_insumo, sp.id_personal, 'Entrada', k.qty, '+', i.costo_unitario, 'Reposición ' || k.origen, k.f
FROM t_kardex k JOIN insumo i ON i.id_articulo = k.art
CROSS JOIN LATERAL (SELECT id_personal FROM t_pers WHERE cargo = 'Supervisor' AND k <= 2 ORDER BY id_personal LIMIT 1) sp
WHERE k.modulo = 'Housekeeping y Mantenimiento' ORDER BY k.f;
INSERT INTO movimiento_insumo (id_insumo, id_personal, tipo_movimiento, cantidad, signo, costo_unitario, fecha_hora)
SELECT i.id_insumo, l.id_personal, 'Salida', round(c.qty * p.frac, 2), '-', i.costo_unitario, c.semana::timestamp + p.dia * interval '1 day' + time '18:00'
FROM t_cons c JOIN insumo i ON i.id_articulo = c.art CROSS JOIN (VALUES (0.45, 3), (0.55, 6)) p(frac, dia)
CROSS JOIN LATERAL (SELECT id_personal FROM t_limp ORDER BY random() LIMIT 1) l
WHERE round(c.qty * p.frac, 2) > 0 AND c.semana::timestamp + p.dia * interval '1 day' + time '18:00' < (SELECT ahora FROM cfg)::timestamp
ORDER BY 7;

-- solicitudes de reposicion de G2 atendidas por almacen (y su resultado enviado a Housekeeping)
INSERT INTO solicitud_reposicion (id_solicitud_externa, id_articulo, cantidad_solicitada, cantidad_atendida, estado, fecha_hora_recepcion, fecha_hora_atencion)
SELECT replace(k.origen, 'HKREQ', 'SRP'), k.art, k.qty, k.qty, 'atendida', k.f - interval '20 hours', k.f FROM t_kardex k WHERE k.modulo = 'Housekeeping y Mantenimiento' ORDER BY k.f;
INSERT INTO solicitud_reposicion (id_solicitud_externa, id_articulo, cantidad_solicitada, estado, fecha_hora_recepcion)
SELECT 'SRP-PEND-' || a.id, a.id, ceil(a.minimo), 'pendiente', (SELECT ahora FROM cfg)::timestamp - interval '3 hours' FROM t_art a WHERE a.id IN ('ART-DET', 'ART-JAB');
INSERT INTO envio_externo (id_envio, destino, tipo_envio, id_referencia, estado, numero_intento, fecha_hora_intento)
SELECT 'ENV-REP-' || lpad((row_number() OVER (ORDER BY fecha_hora_atencion))::text, 5, '0'), 'Housekeeping y Mantenimiento', 'resultado de reposición', id_solicitud_externa, 'aceptado', 1, fecha_hora_atencion + interval '2 minutes'
FROM solicitud_reposicion WHERE estado = 'atendida' ORDER BY fecha_hora_atencion;
SELECT pg_temp.notificar(sp.id_personal, 'StockBajo', 'Stock bajo del insumo ' || i.nombre || ': revisar la reposición.', 'Insumo', i.id_insumo, (SELECT ahora FROM cfg) - (g * 9 + 2) * interval '1 day')
FROM generate_series(1, 6) g CROSS JOIN LATERAL (SELECT id_insumo, nombre FROM insumo ORDER BY random() LIMIT 1) i
CROSS JOIN LATERAL (SELECT id_personal FROM t_pers WHERE cargo = 'Supervisor' AND k = 1) sp;

-- ----------------------------------------------------------------- pronostico de demanda e IA de recomendaciones de gestion
INSERT INTO pronostico_demanda (id_pronostico, id_punto_venta, id_item_catalogo, id_articulo, fecha_desde, fecha_hasta, fecha_hora_generacion, tipo_resultado, cantidad_estimada, datos_utilizados)
SELECT 'PRO-' || to_char(s.semana, 'YYYYMMDD') || '-' || i.id, 'PV-REST', i.id, NULL, s.semana + 7, s.semana + 13, (s.semana + 5)::timestamp + time '20:00', 'Demanda semanal de platos',
       round((coalesce(real.q, 20) * (0.9 + random() * 0.22))::numeric, 0), 'Ventas de las últimas 8 semanas, ocupación proyectada del hotel y temporada'
FROM t_sem s CROSS JOIN (SELECT id FROM t_item WHERE id IN ('IT-LOM', 'IT-AJG', 'IT-CEV', 'IT-BRA', 'IT-DBF', 'IT-PSO')) i
LEFT JOIN LATERAL (SELECT sum(dc.cantidad) AS q FROM g3_servicios.consumo c
                   JOIN detalle_consumo dc ON dc.numero_consumo = c.numero_consumo
                   WHERE dc.id_item_catalogo = i.id AND c.estado = 'confirmado'
                     AND c.fecha_hora_confirmacion >= s.semana + 7 AND c.fecha_hora_confirmacion < s.semana + 14) real ON true
WHERE s.semana + 14 <= (SELECT hoy FROM cfg) AND s.semana > (SELECT min(semana) FROM t_sem) + 14;
INSERT INTO pronostico_demanda (id_pronostico, id_punto_venta, id_item_catalogo, id_articulo, fecha_desde, fecha_hasta, fecha_hora_generacion, tipo_resultado, cantidad_estimada, datos_utilizados)
SELECT 'PRO-' || to_char(s.semana, 'YYYYMMDD') || '-' || a.id, 'PV-REST', NULL, a.id, s.semana + 7, s.semana + 13, (s.semana + 5)::timestamp + time '20:05', 'Consumo semanal de insumos',
       round((coalesce((SELECT qty FROM t_cons WHERE art = a.id AND semana = s.semana + 7), 10) * (0.92 + random() * 0.2))::numeric, 1), 'Consumo histórico de insumos y reservas confirmadas'
FROM t_sem s CROSS JOIN (SELECT id FROM t_art WHERE id IN ('ART-LOM', 'ART-COR', 'ART-PIS', 'ART-HUE')) a
WHERE s.semana + 14 <= (SELECT hoy FROM cfg) AND s.semana > (SELECT min(semana) FROM t_sem) + 14 AND extract(week FROM s.semana)::int % 2 = 0;
INSERT INTO recomendacion_gestion (id_recomendacion, id_pronostico, tipo, motivo, datos_utilizados, fecha_hora_generacion, estado, decision, comentario_decision, fecha_hora_decision)
SELECT 'REC-' || id_pronostico, id_pronostico, (ARRAY['Abastecimiento', 'Ajuste de menú', 'Promoción'])[1 + (row_number() OVER ())::int % 3],
       pg_temp.pick(ARRAY['Se proyecta mayor demanda que la semana anterior: adelantar la compra.', 'Rotación baja: considerar una promoción en el menú.', 'Pico por feriado y ocupación alta: reforzar personal de cocina.']),
       'Pronóstico ' || id_pronostico, fecha_hora_generacion + interval '5 minutes',
       CASE WHEN r < 0.55 THEN 'aceptada' WHEN r < 0.75 THEN 'rechazada' ELSE 'pendiente' END,
       CASE WHEN r < 0.55 THEN 'aceptada' WHEN r < 0.75 THEN 'rechazada' END,
       CASE WHEN r < 0.55 THEN 'Aprobado por la jefatura de alimentos y bebidas' WHEN r < 0.75 THEN 'Se mantiene el plan actual por presupuesto' END,
       CASE WHEN r < 0.75 THEN fecha_hora_generacion + interval '1 day 3 hours' END
FROM (SELECT id_pronostico, fecha_hora_generacion, random() AS r FROM pronostico_demanda WHERE id_item_catalogo IS NOT NULL AND extract(week FROM fecha_desde)::int % 3 = 0) p;
-- =====================================================================
-- 9. G4 FACTURACION Y FINANZAS (1/2): turnos de caja, cuentas de las estadias, cargos y transferencias
-- =====================================================================
CREATE TEMP TABLE t_caj ON COMMIT DROP AS SELECT row_number() OVER (ORDER BY id_usuario)::int AS k, id_usuario FROM usuario WHERE rol = 'CAJERO';
CREATE TEMP TABLE t_rcp ON COMMIT DROP AS SELECT row_number() OVER (ORDER BY id_usuario)::int AS k, id_usuario FROM usuario WHERE rol = 'RECEPCIONISTA';

-- un turno de caja por dia y por turno (MANANA y TARDE); el del momento actual sigue abierto
CREATE TEMP TABLE t_tc ON COMMIT DROP AS
SELECT gen_random_uuid()::text AS id, d::date AS dia, s.turno, (d::date + s.h_ini) AS f_ap, (d::date + s.h_fin) AS f_ci,
       (SELECT id_usuario FROM t_caj WHERE k = ((d::date - c.ini) + s.ord) % 3 + 1) AS usr, s.saldo::numeric AS saldo_ini
FROM cfg c CROSS JOIN generate_series(c.ini, c.hoy, interval '1 day') d
CROSS JOIN (VALUES ('MANANA', time '07:00', time '15:00', 300, 0), ('TARDE', time '15:00', time '23:00', 250, 1)) s(turno, h_ini, h_fin, saldo, ord)
WHERE (d::date + s.h_ini) <= c.ahora::timestamp;
INSERT INTO turno_caja (id_turno_caja, id_usuario, turno, saldo_inicial, fecha_apertura, fecha_cierre, estado)
SELECT id, usr, turno, saldo_ini, f_ap + (random() * 6) * interval '1 minute',
       CASE WHEN f_ci > (SELECT ahora FROM cfg)::timestamp THEN NULL ELSE f_ci + (2 + random() * 8) * interval '1 minute' END,
       CASE WHEN f_ci > (SELECT ahora FROM cfg)::timestamp THEN 'ABIERTA' ELSE 'CERRADA' END
FROM t_tc ORDER BY f_ap;

-- cuenta de cada estadia
CREATE TEMP TABLE t_cta (id text PRIMARY KEY, id_estadia bigint, id_reserva bigint, id_hab bigint, id_huesped bigint, noches int, precio numeric, ts_ap timestamp, ts_cierre timestamp,
                         corp boolean, id_empresa int, ext boolean, final text, comp numeric DEFAULT 0, comp_tipo text, comp_fuera boolean DEFAULT false, sec boolean DEFAULT false,
                         estado_est text, early boolean, late boolean, paquete boolean, npers int) ON COMMIT DROP;
INSERT INTO t_cta (id, id_estadia, id_reserva, id_hab, id_huesped, noches, precio, ts_ap, ts_cierre, corp, id_empresa, ext, final, estado_est, early, late, paquete, npers)
SELECT gen_random_uuid()::text, e.id_estadia, e.id_reserva, e.id_hab, e.id_huesped, e.noches, e.precio_noche, (e.ts_in + interval '5 minutes')::timestamp,
       CASE WHEN e.estado_est = 'FINALIZADA' AND e.ts_out + interval '35 minutes' <= (SELECT ahora FROM cfg) THEN (e.ts_out + interval '35 minutes')::timestamp END,
       e.corp, e.id_empresa, e.ext, CASE WHEN e.estado_est = 'FINALIZADA' AND e.ts_out + interval '35 minutes' <= (SELECT ahora FROM cfg) THEN 'CERRADA' ELSE 'ACTIVA' END,
       e.estado_est, e.early, e.late, e.paquete, e.npers
FROM t_est e WHERE e.id_estadia IS NOT NULL;
-- compensaciones comerciales (3 %): la mayoria se aplica antes del cierre; unas pocas llegan despues (FUERA_DE_PLAZO)
UPDATE t_cta SET comp_tipo = (ARRAY['DESCUENTO', 'DESCUENTO', 'NOCHE_SIN_COSTO', 'SERVICIO_CORTESIA'])[1 + floor(random() * 4)::int]
 WHERE final = 'CERRADA' AND ts_cierre < (SELECT ahora FROM cfg)::timestamp - interval '3 days' AND random() < 0.03;
UPDATE t_cta SET comp = CASE comp_tipo WHEN 'NOCHE_SIN_COSTO' THEN precio WHEN 'DESCUENTO' THEN round((30 + random() * 120)::numeric, 0) ELSE round((40 + random() * 40)::numeric, 0) END,
                 comp_fuera = random() < 0.15
 WHERE comp_tipo IS NOT NULL;

INSERT INTO cuenta (id_cuenta, id_huesped, id_reserva, id_habitacion, fecha_apertura, estado)
SELECT id, id_huesped, id_reserva, id_hab, ts_ap, 'ACTIVA' FROM t_cta ORDER BY ts_ap;

-- (a) alojamiento: una linea por noche (cierre de dia del hotel)
INSERT INTO g4_finanzas.consumo (id_cuenta, id_usuario, id_centro_costo, numero_consumo_origen, concepto, importe, fecha, area)
SELECT c.id, (SELECT id_usuario FROM t_rcp WHERE k = 1 + (c.id_estadia % 3)), cc.id_centro_costo, 'ALOJ-' || c.id_estadia || '-' || n.k,
       'Alojamiento - noche del ' || to_char(e.ingreso + n.k, 'DD/MM/YYYY') || ' (hab. ' || h.numero || ')', c.precio, e.ingreso + n.k, 'Recepción'
FROM t_cta c JOIN t_est e ON e.id_estadia = c.id_estadia JOIN t_hab h ON h.id_habitacion = c.id_hab
CROSS JOIN centro_costo cc CROSS JOIN LATERAL generate_series(0, c.noches - 1) n(k)
WHERE cc.nombre = 'Alojamiento' AND e.ingreso + n.k < (SELECT hoy FROM cfg) + CASE WHEN c.estado_est = 'FINALIZADA' THEN 1 ELSE 0 END;
-- (b) extras: check-in anticipado, salida tardia y estacionamiento
INSERT INTO g4_finanzas.consumo (id_cuenta, id_usuario, id_centro_costo, numero_consumo_origen, concepto, importe, fecha, area)
SELECT c.id, (SELECT id_usuario FROM t_rcp WHERE k = 1 + (c.id_estadia % 3)), cc.id_centro_costo, 'EXT-' || x.tipo || '-' || c.id_estadia,
       x.concepto, x.importe, e.ingreso + (CASE WHEN x.tipo = 'LATE' THEN c.noches ELSE 0 END), 'Recepción'
FROM t_cta c JOIN t_est e ON e.id_estadia = c.id_estadia CROSS JOIN centro_costo cc
CROSS JOIN LATERAL (VALUES ('EARLY', 'Check-in anticipado (antes de las 13:00)', 40::numeric, c.early AND random() < 0.4),
                           ('LATE', 'Salida tardía (hasta las 15:00)', round(c.precio * 0.5), c.late AND c.estado_est = 'FINALIZADA' AND random() < 0.8),
                           ('PARK', 'Estacionamiento (' || c.noches || ' noches)', (25 * c.noches)::numeric, random() < 0.08)) x(tipo, concepto, importe, aplica)
WHERE cc.nombre = 'Alojamiento' AND x.aplica;

-- (c) consumos de G3 aceptados por Facturacion: llegan a la cuenta de la estadia o, si el pago fue directo, sin cuenta
INSERT INTO g4_finanzas.consumo (id_cuenta, id_usuario, id_centro_costo, numero_consumo_origen, concepto, importe, fecha, area)
SELECT ct.id,
       (SELECT id_usuario FROM t_rcp WHERE k = 1 + (abs(hashtext(c.numero_consumo)) % 3)),
       (SELECT id_centro_costo FROM centro_costo WHERE nombre = CASE c.id_punto_venta WHEN 'PV-LAV' THEN 'Lavandería' WHEN 'PV-SPA' THEN 'Spa y bienestar' ELSE 'Alimentos y bebidas' END),
       c.numero_consumo, d.concepto, c.importe_total, c.fecha_hora_confirmacion::date,
       CASE c.id_punto_venta WHEN 'PV-LAV' THEN 'Lavandería' WHEN 'PV-SPA' THEN 'Spa' WHEN 'PV-MINI' THEN 'Minibar' WHEN 'PV-BAR' THEN 'Bar' ELSE CASE WHEN c.forma_cobro = 'cargo a la habitación' THEN 'Room service' ELSE 'Restaurante' END END
FROM g3_servicios.consumo c
JOIN LATERAL (
 SELECT string_agg(i.nombre || CASE WHEN dc.cantidad > 1 THEN ' x' || trim(to_char(dc.cantidad, 'FM999990.##')) ELSE '' END, ', ' ORDER BY i.nombre) AS concepto
 FROM detalle_consumo dc JOIN t_item i ON i.id = dc.id_item_catalogo WHERE dc.numero_consumo = c.numero_consumo
) d ON true
JOIN envio_externo en ON en.id_referencia = c.numero_consumo AND en.tipo_envio = 'consumo' AND en.destino = 'Facturación y Finanzas' AND en.estado = 'aceptado'
LEFT JOIN t_cta ct ON ct.id_estadia = substr(c.id_estadia_externa, 5)::bigint
WHERE c.estado = 'confirmado' AND ct.id IS NOT NULL AND c.importe_total > 0;

-- transferencias: un acompañante o la empresa paga aparte parte del consumo (cuenta secundaria del mismo huesped)
CREATE TEMP TABLE t_tr ON COMMIT DROP AS
SELECT gen_random_uuid()::text AS id, c.id AS orig, gen_random_uuid()::text AS dest, k.id_consumo, k.importe, c.id_estadia, c.id_huesped, c.id_hab, c.ts_ap, c.ts_cierre, c.corp, c.id_empresa, c.ext, c.final, c.npers
FROM t_cta c JOIN LATERAL (SELECT id_consumo, importe FROM g4_finanzas.consumo WHERE id_cuenta = c.id AND numero_consumo_origen NOT LIKE 'ALOJ-%' AND numero_consumo_origen NOT LIKE 'EXT-%' ORDER BY importe DESC LIMIT 1) k ON true
WHERE c.final = 'CERRADA' AND c.npers >= 2 AND c.comp_tipo IS NULL AND random() < 0.012;
INSERT INTO cuenta (id_cuenta, id_huesped, id_habitacion, fecha_apertura, estado) SELECT dest, id_huesped, id_hab, ts_ap + interval '1 day', 'ACTIVA' FROM t_tr;
INSERT INTO transferencia_consumo (id_transferencia, id_cuenta_origen, id_cuenta_destino, id_usuario, motivo, fecha_hora)
SELECT id, orig, dest, (SELECT id_usuario FROM t_rcp WHERE k = 1), pg_temp.pick(ARRAY['El acompañante pagará su consumo por separado', 'La empresa asume el consumo del restaurante', 'Separar el cargo a pedido del huésped']), ts_cierre - interval '3 hours' FROM t_tr;
INSERT INTO detalle_transferencia (id_transferencia, id_consumo, importe) SELECT id, id_consumo, importe FROM t_tr;
UPDATE g4_finanzas.consumo k SET id_cuenta = t.dest FROM t_tr t WHERE k.id_consumo = t.id_consumo;
INSERT INTO t_cta (id, id_estadia, id_reserva, id_hab, id_huesped, noches, precio, ts_ap, ts_cierre, corp, id_empresa, ext, final, sec, estado_est, early, late, paquete, npers)
SELECT dest, NULL, NULL, id_hab, id_huesped, 0, 0, ts_ap + interval '1 day', ts_cierre, false, NULL, ext, final, true, 'FINALIZADA', false, false, false, 1 FROM t_tr;
-- =====================================================================
-- 10. G4 (2/2): comprobantes, notas de credito, cobros, cierre de cuentas, caja, historial, gastos, alertas y proyecciones
-- =====================================================================
CREATE TEMP TABLE t_tot ON COMMIT DROP AS SELECT id_cuenta AS id, round(sum(importe), 2) AS total FROM g4_finanzas.consumo WHERE id_cuenta IS NOT NULL GROUP BY 1;
CREATE TEMP TABLE t_admin ON COMMIT DROP AS SELECT (SELECT id_usuario FROM usuario WHERE rol = 'ADMINISTRADOR' LIMIT 1) AS adm, (SELECT id_usuario FROM usuario WHERE rol = 'JEFE_FINANZAS' LIMIT 1) AS jef,
                                              (SELECT id_usuario FROM usuario WHERE rol = 'RESP_COSTOS' LIMIT 1) AS cos, (SELECT id_usuario FROM usuario WHERE rol = 'GERENTE_GENERAL' LIMIT 1) AS ger;

-- ----------------------------------------------------------------- comprobantes: boleta o factura al cierre de cada cuenta (algunas boletas anuladas y reemitidas)
CREATE TEMP TABLE t_doc0 (id text, cta text, tipo text, f timestamp, total numeric, id_empresa int, id_huesped bigint, anul boolean, r numeric) ON COMMIT DROP;
INSERT INTO t_doc0
SELECT gen_random_uuid()::text, c.id, CASE WHEN c.corp AND NOT c.sec THEN 'FACTURA' ELSE 'BOLETA' END, c.ts_cierre - interval '17 minutes' + random() * interval '3 minutes', t.total,
       CASE WHEN c.corp AND NOT c.sec THEN c.id_empresa END, c.id_huesped, false, random()
FROM t_cta c JOIN t_tot t ON t.id = c.id WHERE c.final = 'CERRADA' AND t.total > 0;
INSERT INTO t_doc0
SELECT gen_random_uuid()::text, cta, tipo, f - interval '9 minutes', total, id_empresa, id_huesped, true, random() FROM t_doc0
WHERE random() < 0.01 AND f < (SELECT ahora FROM cfg)::timestamp - interval '2 days';

CREATE TEMP TABLE t_doc ON COMMIT DROP AS
SELECT d.id, d.cta, d.tipo, CASE d.tipo WHEN 'FACTURA' THEN 'F001' ELSE 'B001' END AS serie,
       row_number() OVER (PARTITION BY d.tipo ORDER BY d.f, d.id) AS corr, d.f, d.total, round(d.total / 1.18, 2) AS gravada, d.total - round(d.total / 1.18, 2) AS igv,
       CASE WHEN d.anul THEN 'ANULADO'
            WHEN d.f > (SELECT ahora FROM cfg)::timestamp - interval '2 hours' THEN 'BORRADOR'
            WHEN d.f > (SELECT ahora FROM cfg)::timestamp - interval '12 hours' THEN 'FIRMADO'
            WHEN d.f > (SELECT ahora FROM cfg)::timestamp - interval '36 hours' THEN 'ENVIADO'
            WHEN d.f > (SELECT ahora FROM cfg)::timestamp - interval '5 days' AND d.r < 0.04 THEN 'RECHAZADO' ELSE 'ACEPTADO' END AS estado,
       d.id_empresa, d.id_huesped, d.anul
FROM t_doc0 d;

INSERT INTO comprobante (id_comprobante, id_cuenta, id_usuario, tipo, serie, correlativo, tipo_documento_cliente, numero_documento_cliente, razon_social_cliente, direccion_cliente,
                         operacion_gravada, igv, total, estado, mensaje_rechazo, fecha_emision)
SELECT d.id, d.cta, u.usr, d.tipo, d.serie, d.corr::int,
       CASE WHEN d.tipo = 'FACTURA' THEN 'RUC' ELSE h.tipo_documento END, CASE WHEN d.tipo = 'FACTURA' THEN e.ruc ELSE h.numero_documento END,
       CASE WHEN d.tipo = 'FACTURA' THEN e.razon_social ELSE h.nombres || ' ' || h.apellidos END, CASE WHEN d.tipo = 'FACTURA' THEN e.direccion END,
       d.gravada, d.igv, d.total, d.estado,
       CASE WHEN d.estado = 'RECHAZADO' THEN pg_temp.pick(ARRAY['SUNAT: el RUC del receptor no está activo (código 2800)', 'SUNAT: error de validación en el XML (código 2335)', 'SUNAT: el monto no coincide con el detalle (código 3030)']) END, d.f
FROM t_doc d JOIN huesped h ON h.id_huesped = d.id_huesped LEFT JOIN t_empresa e ON e.id = d.id_empresa
CROSS JOIN LATERAL (SELECT usr FROM t_tc WHERE f_ap <= d.f ORDER BY f_ap DESC LIMIT 1) u ORDER BY d.f;

-- notas de credito por las compensaciones aplicadas antes del cierre
INSERT INTO comprobante (id_comprobante, id_cuenta, id_usuario, id_comprobante_ref, tipo, serie, correlativo, tipo_documento_cliente, numero_documento_cliente, razon_social_cliente,
                         direccion_cliente, operacion_gravada, igv, total, estado, motivo_nota, fecha_emision)
SELECT gen_random_uuid()::text, d.cta, p.id_usuario, d.id, 'NOTA_CREDITO', CASE d.tipo WHEN 'FACTURA' THEN 'FC01' ELSE 'BC01' END,
       (row_number() OVER (PARTITION BY d.tipo ORDER BY d.f))::int, p.tipo_documento_cliente, p.numero_documento_cliente, p.razon_social_cliente, p.direccion_cliente,
       round(c.comp / 1.18, 2), c.comp - round(c.comp / 1.18, 2), c.comp, 'ACEPTADO', 'Compensación comercial aprobada por reclamo del huésped', d.f + interval '4 minutes'
FROM t_doc d JOIN t_cta c ON c.id = d.cta JOIN comprobante p ON p.id_comprobante = d.id
WHERE c.comp > 0 AND NOT c.comp_fuera AND NOT d.anul AND d.estado = 'ACEPTADO';
UPDATE t_cta SET comp = 0 WHERE comp > 0 AND NOT comp_fuera AND id NOT IN (SELECT id_cuenta FROM comprobante WHERE tipo = 'NOTA_CREDITO');   -- sin nota de credito no hay compensacion en la cuenta

UPDATE g4_finanzas.consumo k SET estado = 'FACTURADO' FROM t_doc d WHERE d.cta = k.id_cuenta AND NOT d.anul AND d.estado <> 'RECHAZADO';

-- ----------------------------------------------------------------- cobros (uno o dos medios de pago; algunos anulados y repetidos) y adelantos de huespedes en casa
CREATE TEMP TABLE t_cob0 (id text, cta text, monto numeric, medio text, f timestamp, doc text, estado text) ON COMMIT DROP;
INSERT INTO t_cob0
SELECT gen_random_uuid()::text, d.cta, round(d.total - CASE WHEN c.comp > 0 AND NOT c.comp_fuera THEN c.comp ELSE 0 END, 2),
       CASE WHEN c.corp THEN pg_temp.wpick(ARRAY['TRANSFERENCIA', 'TARJETA'], ARRAY[65, 35]::numeric[])
            ELSE pg_temp.wpick(ARRAY['EFECTIVO', 'TARJETA', 'TRANSFERENCIA', 'BILLETERA_DIGITAL'], ARRAY[20, 52, 14, 14]::numeric[]) END,
       d.f + interval '2 minutes', d.id, 'REGISTRADO'
FROM t_doc d JOIN t_cta c ON c.id = d.cta WHERE NOT d.anul;
DELETE FROM t_cob0 WHERE monto <= 0;
-- pago en dos medios (12 %)
INSERT INTO t_cob0 SELECT gen_random_uuid()::text, cta, monto - round(monto * 0.5, 2), CASE WHEN medio = 'EFECTIVO' THEN 'TARJETA' ELSE 'EFECTIVO' END, f + interval '1 minute', doc, 'REGISTRADO'
FROM t_cob0 WHERE random() < 0.12 AND monto > 40;
UPDATE t_cob0 a SET monto = round(monto * 0.5, 2) WHERE EXISTS (SELECT 1 FROM t_cob0 b WHERE b.cta = a.cta AND b.id <> a.id AND b.f > a.f AND b.estado = 'REGISTRADO') AND a.f = (SELECT min(f) FROM t_cob0 z WHERE z.cta = a.cta);
-- cobro anulado y repetido (1 %)
INSERT INTO t_cob0 SELECT gen_random_uuid()::text, cta, monto, 'TARJETA', f - interval '4 minutes', doc, 'ANULADO' FROM t_cob0
WHERE random() < 0.01 AND estado = 'REGISTRADO' AND f < (SELECT ahora FROM cfg)::timestamp - interval '2 days' AND medio = 'TARJETA';
-- adelantos (18 % de los huespedes que aun estan alojados)
INSERT INTO t_cob0 SELECT gen_random_uuid()::text, c.id, round(c.precio, 0), 'TARJETA', c.ts_ap + interval '2 minutes', NULL, 'REGISTRADO' FROM t_cta c WHERE c.final = 'ACTIVA' AND random() < 0.18;

INSERT INTO cobro (id_cobro, id_cuenta, id_turno_caja, id_usuario, id_comprobante, monto, medio_pago, fecha_hora, estado)
SELECT b.id, b.cta, u.id, u.usr, b.doc, b.monto, b.medio, b.f, b.estado FROM t_cob0 b
CROSS JOIN LATERAL (SELECT id, usr FROM t_tc WHERE f_ap <= b.f ORDER BY f_ap DESC LIMIT 1) u ORDER BY b.f;

-- movimientos de caja (35 % de los turnos)
INSERT INTO movimiento_caja (id_turno_caja, id_usuario, tipo, importe, motivo, fecha_hora)
SELECT t.id, t.usr, m.tipo, m.imp, m.motivo, (t.f_ap + (60 + random() * 360) * interval '1 minute')
FROM t_tc t CROSS JOIN LATERAL (SELECT * FROM (VALUES
   ('EGRESO', round((15 + random() * 105)::numeric, 0), 'Compra de útiles de limpieza en efectivo'), ('EGRESO', round((15 + random() * 40)::numeric, 0), 'Reembolso de taxi al huésped por demora en el traslado'),
   ('EGRESO', round((20 + random() * 60)::numeric, 0), 'Compra de hielo y bebidas para el bar'), ('INGRESO', round((100 + random() * 200)::numeric, 0), 'Reposición de sencillo desde tesorería')) v(tipo, imp, motivo)
   ORDER BY random() LIMIT 1 + (random() < 0.3)::int) m
WHERE random() < 0.35 AND t.f_ap + interval '420 minutes' <= (SELECT ahora FROM cfg)::timestamp;

-- ----------------------------------------------------------------- cierre de cuentas (con autorizacion cuando una compensacion deja diferencia) y saldos de las abiertas
UPDATE cuenta c SET estado = 'CERRADA', fecha_cierre = t.ts_cierre, saldo_pendiente = 0 FROM t_cta t WHERE t.id = c.id_cuenta AND t.final = 'CERRADA' AND t.comp = 0;
UPDATE cuenta c SET estado = 'CERRADA', fecha_cierre = t.ts_cierre, saldo_pendiente = 0
FROM t_cta t WHERE t.id = c.id_cuenta AND t.final = 'CERRADA' AND t.comp > 0;
UPDATE cuenta c SET saldo_pendiente = greatest((SELECT coalesce(sum(importe), 0) FROM g4_finanzas.consumo WHERE id_cuenta = c.id_cuenta)
                                             - (SELECT coalesce(sum(monto), 0) FROM cobro WHERE id_cuenta = c.id_cuenta AND estado = 'REGISTRADO'), 0)
WHERE c.estado = 'ACTIVA';

-- ----------------------------------------------------------------- cierre de los turnos de caja (arqueo con diferencias justificadas)
UPDATE turno_caja t SET saldo_esperado = x.esperado,
       saldo_final = x.esperado + x.dif,
       justificacion_diferencia = CASE WHEN x.dif <> 0 THEN pg_temp.pick(ARRAY['Vuelto entregado en exceso a un huésped; se verificó con el video de caja', 'Billete falso detectado en el arqueo', 'Diferencia por redondeo en cobros en efectivo', 'Faltante por error al contar el sencillo']) END
FROM (SELECT tt.id_turno_caja AS id,
             tt.saldo_inicial + coalesce((SELECT sum(monto) FROM cobro WHERE id_turno_caja = tt.id_turno_caja AND medio_pago = 'EFECTIVO' AND estado = 'REGISTRADO'), 0)
                              + coalesce((SELECT sum(CASE tipo WHEN 'INGRESO' THEN importe ELSE -importe END) FROM movimiento_caja WHERE id_turno_caja = tt.id_turno_caja), 0) AS esperado,
             CASE WHEN random() < 0.12 THEN round((random() * 50 - 25)::numeric, 0) ELSE 0 END AS dif
      FROM turno_caja tt WHERE tt.estado = 'CERRADA') x
WHERE t.id_turno_caja = x.id;

-- ----------------------------------------------------------------- historial de cuentas y envio de documentos al correo del huesped
INSERT INTO historial_cuenta (id_cuenta, id_usuario, tipo_movimiento, importe, detalle, motivo, fecha_hora)
SELECT c.id, (SELECT id_usuario FROM t_rcp WHERE k = 1 + (coalesce(c.id_estadia, 0) % 3)), 'APERTURA', 0, jsonb_build_object('estadia', c.id_estadia, 'habitacion', c.id_hab),
       CASE WHEN c.sec THEN 'Cuenta separada a pedido del huésped' ELSE 'Apertura de la cuenta al hacer el check-in' END, c.ts_ap FROM t_cta c;
INSERT INTO historial_cuenta (id_cuenta, id_usuario, tipo_movimiento, importe, detalle, motivo, fecha_hora)
SELECT c.id, u.usr, 'CONSUMO', t.total, jsonb_build_object('alojamiento', coalesce((SELECT sum(importe) FROM g4_finanzas.consumo WHERE id_cuenta = c.id AND (numero_consumo_origen LIKE 'ALOJ-%' OR numero_consumo_origen LIKE 'EXT-%')), 0),
                                                         'servicios', coalesce((SELECT sum(importe) FROM g4_finanzas.consumo WHERE id_cuenta = c.id AND (numero_consumo_origen NOT LIKE 'ALOJ-%' AND numero_consumo_origen NOT LIKE 'EXT-%')), 0)),
       'Cargos totales de la estadía', c.ts_cierre - interval '25 minutes'
FROM t_cta c JOIN t_tot t ON t.id = c.id CROSS JOIN LATERAL (SELECT usr FROM t_tc WHERE f_ap <= c.ts_cierre ORDER BY f_ap DESC LIMIT 1) u WHERE c.final = 'CERRADA';
INSERT INTO historial_cuenta (id_cuenta, id_usuario, tipo_movimiento, importe, detalle, motivo, fecha_hora)
SELECT b.cta, co.id_usuario, 'COBRO', b.monto, jsonb_build_object('medio_pago', b.medio, 'id_cobro', b.id), 'Cobro de la cuenta', b.f FROM t_cob0 b JOIN cobro co ON co.id_cobro = b.id WHERE b.estado = 'REGISTRADO';
INSERT INTO historial_cuenta (id_cuenta, id_usuario, tipo_movimiento, importe, detalle, motivo, fecha_hora)
SELECT t.id, CASE WHEN t.comp > 0 THEN (SELECT adm FROM t_admin) ELSE u.usr END, 'CIERRE', t.comp, NULL,
       CASE WHEN t.comp > 0 THEN 'Cierre autorizado: saldo cubierto por nota de crédito' ELSE 'Cierre de la cuenta al hacer el check-out' END, t.ts_cierre
FROM t_cta t CROSS JOIN LATERAL (SELECT usr FROM t_tc WHERE f_ap <= t.ts_cierre ORDER BY f_ap DESC LIMIT 1) u WHERE t.final = 'CERRADA';
INSERT INTO historial_cuenta (id_cuenta, id_usuario, tipo_movimiento, importe, detalle, motivo, fecha_hora)
SELECT t.orig, (SELECT id_usuario FROM t_rcp WHERE k = 1), 'TRANSFERENCIA', t.importe, jsonb_build_object('cuenta_destino', t.dest), 'Transferencia de consumo a otra cuenta', t.ts_cierre - interval '3 hours' FROM t_tr t;
INSERT INTO historial_cuenta (id_cuenta, id_usuario, tipo_movimiento, importe, detalle, motivo, fecha_hora)
SELECT c.id, (SELECT id_usuario FROM t_rcp WHERE k = 2), 'ACTUALIZACION', NULL, jsonb_build_object('campo', 'documento del cliente'), 'Se corrigieron los datos del cliente para el comprobante', c.ts_cierre - interval '40 minutes'
FROM t_cta c WHERE c.final = 'CERRADA' AND random() < 0.04;

INSERT INTO envio_documento (id_usuario, id_comprobante, tipo, correo_destino, estado, fecha_hora)
SELECT co.id_usuario, d.id, 'COMPROBANTE', h.correo, CASE WHEN fl THEN 'FALLIDO' ELSE 'ENVIADO' END, d.f + interval '3 minutes'
FROM t_doc d JOIN comprobante co ON co.id_comprobante = d.id JOIN t_cta c ON c.id = d.cta JOIN huesped h ON h.id_huesped = c.id_huesped
CROSS JOIN LATERAL (SELECT random() < 0.04 AS fl) x
WHERE h.correo IS NOT NULL AND d.estado NOT IN ('BORRADOR', 'ANULADO', 'RECHAZADO');
INSERT INTO envio_documento (id_usuario, id_comprobante, tipo, correo_destino, estado, fecha_hora)
SELECT e.id_usuario, e.id_comprobante, 'COMPROBANTE', e.correo_destino, 'ENVIADO', e.fecha_hora + interval '20 minutes' FROM envio_documento e WHERE e.estado = 'FALLIDO';
INSERT INTO envio_documento (id_usuario, id_cuenta, tipo, correo_destino, estado, fecha_hora)
SELECT u.usr, c.id, 'ESTADO_CUENTA', h.correo, 'ENVIADO', c.ts_cierre - interval '30 minutes'
FROM t_cta c JOIN huesped h ON h.id_huesped = c.id_huesped CROSS JOIN LATERAL (SELECT usr FROM t_tc WHERE f_ap <= c.ts_cierre ORDER BY f_ap DESC LIMIT 1) u
WHERE c.final = 'CERRADA' AND h.correo IS NOT NULL AND random() < 0.06;

-- ----------------------------------------------------------------- gastos del hotel (servicios, mantenimiento, suministros, marketing, seguridad)
INSERT INTO gasto (id_usuario, id_usuario_aprobador, id_centro_costo, categoria, proveedor, concepto, monto, fecha, comprobante_sustento, estado, fecha_aprobacion)
SELECT a.cos, CASE WHEN est <> 'PENDIENTE' THEN a.jef END, (SELECT id_centro_costo FROM centro_costo WHERE nombre = g.cc), g.categoria, g.proveedor, g.concepto || ' - ' || to_char(f, 'MM/YYYY'),
       round((g.minimo + random() * (g.maximo - g.minimo))::numeric, 2), f, 'F001-' || lpad((100000 + row_number() OVER (ORDER BY f, g.proveedor))::text, 6, '0'), est,
       CASE WHEN est <> 'PENDIENTE' THEN (f + (1 + floor(random() * 3)::int) * interval '1 day' + time '10:00') END
FROM t_admin a CROSS JOIN cfg c
CROSS JOIN generate_series(date_trunc('month', c.ini)::date, c.hoy, interval '1 month') m(mes)
CROSS JOIN LATERAL (VALUES
  ('Servicios básicos', 'Energía y Luz Lima S.A.', 'Consumo de electricidad', 2800, 4300, 'Administración', 5), ('Servicios básicos', 'Agua Potable Metropolitana S.A.', 'Consumo de agua potable', 900, 1500, 'Administración', 8),
  ('Servicios básicos', 'Telecomunicaciones Andinas S.A.', 'Internet y telefonía', 650, 820, 'Administración', 10), ('Seguridad', 'Seguridad y Vigilancia Escudo S.A.C.', 'Servicio de vigilancia', 3600, 3600, 'Administración', 3),
  ('Mantenimiento', 'Servicios Técnicos del Perú S.A.C.', 'Mantenimiento de ascensores', 780, 780, 'Mantenimiento', 12), ('Marketing', 'Publicidad Digital Perú S.A.C.', 'Campaña de anuncios en buscadores', 900, 2200, 'Ventas y marketing', 15),
  ('Suministros', 'Papelería Comercial Lima S.A.C.', 'Útiles de oficina e impresiones', 180, 520, 'Administración', 18), ('Lavandería', 'Insumos Textiles del Pacífico S.A.C.', 'Reposición de sábanas y toallas', 1200, 3400, 'Lavandería', 20)
) g(categoria, proveedor, concepto, minimo, maximo, cc, dia)
CROSS JOIN LATERAL (SELECT (m.mes::date + (g.dia - 1)) AS f) d
CROSS JOIN LATERAL (SELECT CASE WHEN d.f > c.hoy - 5 THEN 'PENDIENTE' WHEN random() < 0.03 THEN 'RECHAZADO' ELSE 'APROBADO' END AS est) e
WHERE d.f <= c.hoy AND d.f >= c.ini;

-- ----------------------------------------------------------------- alertas financieras (IA): cobros inusuales y diferencias de arqueo
INSERT INTO alerta_financiera (id_usuario, id_usuario_revisor, id_cuenta, id_cobro, id_turno_caja, tipo_operacion, monto, puntaje_anomalia, severidad, clasificacion, justificacion, fecha_hora, fecha_revision)
SELECT co.id_usuario, CASE WHEN cl <> 'PENDIENTE' THEN a.jef END, co.id_cuenta, co.id_cobro, co.id_turno_caja, 'COBRO_ATIPICO', co.monto, p, CASE WHEN p >= 0.85 THEN 'ALTA' WHEN p >= 0.65 THEN 'MEDIA' ELSE 'BAJA' END, cl,
       CASE cl WHEN 'CONFIRMADA' THEN 'Cobro duplicado confirmado con el huésped; se regularizó con anulación' WHEN 'JUSTIFICADA' THEN 'Pago corporativo de varias habitaciones autorizado por gerencia' WHEN 'FALSO_POSITIVO' THEN 'Monto elevado por estadía larga en temporada alta' END,
       co.fecha_hora + interval '5 minutes', CASE WHEN cl <> 'PENDIENTE' THEN co.fecha_hora + interval '1 day 4 hours' END
FROM (SELECT * FROM cobro WHERE estado = 'REGISTRADO' ORDER BY monto DESC LIMIT 24) co CROSS JOIN t_admin a
CROSS JOIN LATERAL (SELECT round((0.6 + random() * 0.38)::numeric, 4) AS p) pp
CROSS JOIN LATERAL (SELECT CASE WHEN co.fecha_hora > (SELECT ahora FROM cfg)::timestamp - interval '3 days' THEN 'PENDIENTE'
                                ELSE (ARRAY['CONFIRMADA', 'JUSTIFICADA', 'FALSO_POSITIVO', 'JUSTIFICADA'])[1 + floor(random() * 4)::int] END AS cl) k;
INSERT INTO alerta_financiera (id_usuario, id_usuario_revisor, id_turno_caja, tipo_operacion, monto, puntaje_anomalia, severidad, clasificacion, justificacion, fecha_hora, fecha_revision)
SELECT t.id_usuario, a.jef, t.id_turno_caja, 'DIFERENCIA_CIERRE', abs(t.diferencia), least(0.55 + abs(t.diferencia) / 60.0, 0.99)::numeric(5,4), CASE WHEN abs(t.diferencia) >= 20 THEN 'ALTA' WHEN abs(t.diferencia) >= 10 THEN 'MEDIA' ELSE 'BAJA' END,
       'JUSTIFICADA', 'Diferencia de arqueo sustentada por el cajero', t.fecha_cierre, t.fecha_cierre + interval '1 day 2 hours'
FROM turno_caja t CROSS JOIN t_admin a WHERE t.estado = 'CERRADA' AND t.diferencia IS NOT NULL AND abs(t.diferencia) >= 8 AND t.fecha_cierre < (SELECT ahora FROM cfg)::timestamp - interval '1 day';

-- ----------------------------------------------------------------- proyecciones de ingresos y flujo de caja (IA): base y escenario, a 7, 30 y 90 dias
CREATE TEMP TABLE t_proy ON COMMIT DROP AS
SELECT gen_random_uuid()::text AS id, m.mes::date AS f, p.periodo,
       round((coalesce((SELECT sum(importe) FROM g4_finanzas.consumo WHERE fecha >= m.mes::date AND fecha < m.mes::date + p.periodo), 0) * (0.93 + random() * 0.14))::numeric, 2) AS monto
FROM cfg c CROSS JOIN generate_series(date_trunc('month', c.ini + 40)::date, (c.hoy - 35), interval '1 month') m(mes)
CROSS JOIN (VALUES (7), (30), (90)) p(periodo) WHERE p.periodo = 30 OR extract(month FROM m.mes)::int % 3 = 0;
INSERT INTO proyeccion_financiera (id_proyeccion, id_usuario, periodo, tipo, monto_estimado, flujo_caja_estimado, limite_inferior, limite_superior, version, supuestos, fecha_creacion)
