-- regla de acumulacion para estadias anteriores a la regla vigente (sin solaparse con ella)
INSERT INTO regla_acumulacion (codigo_regla, puntos_por_noche, monto_base, puntos_por_monto, fecha_inicio, fecha_fin, activa)
SELECT 'RAC000', 8, 10.00, 1, (SELECT ini FROM cfg) - 400, (SELECT min(fecha_inicio) FROM regla_acumulacion WHERE activa) - 1, true
WHERE (SELECT min(fecha_inicio) FROM regla_acumulacion WHERE activa) > (SELECT ini FROM cfg) - 30;

-- ----------------------------------------------------------------- perfil unico del huesped (con estadisticas reales y segmento segun las reglas)
CREATE TEMP TABLE t_pf ON COMMIT DROP AS
SELECT h.id_huesped, h.fecha_registro::date AS alta, h.telefono IS NOT NULL AS tel, h.correo IS NOT NULL AS cor,
       coalesce(s.n, 0) AS n_est, s.ult, coalesce(p.pagado, 0) AS valor
FROM huesped h
LEFT JOIN (SELECT id_huesped, count(*) FILTER (WHERE estado_est = 'FINALIZADA') AS n, max(salida) FILTER (WHERE estado_est = 'FINALIZADA') AS ult FROM t_est WHERE tipo = 'estadia' GROUP BY 1) s USING (id_huesped)
LEFT JOIN (SELECT c.id_huesped, sum(co.monto) AS pagado FROM cuenta c JOIN cobro co ON co.id_cuenta = c.id_cuenta AND co.estado = 'REGISTRADO' GROUP BY 1) p USING (id_huesped);
INSERT INTO perfil_huesped (id_huesped, id_segmento, fecha_alta, total_estadias, valor_acumulado, fecha_ultima_estadia, fec_act_estadias, fec_act_incidencias, fec_act_consumos, fec_act_valor, estado_perfil)
SELECT p.id_huesped, (SELECT id_segmento FROM segmento WHERE codigo_segmento = CASE WHEN p.valor >= 4000 THEN 'SEG001' WHEN p.n_est >= 3 THEN 'SEG002' WHEN p.n_est >= 1 THEN 'SEG003' END),
       p.alta, p.n_est, p.valor, p.ult, CASE WHEN p.ult IS NOT NULL THEN least(p.ult::timestamp + time '13:00', localtimestamp - (4 + random() * 40) * interval '1 minute') END, CASE WHEN p.ult IS NOT NULL THEN least(p.ult::timestamp + time '13:05', localtimestamp - (3 + random() * 30) * interval '1 minute') END,
       CASE WHEN p.ult IS NOT NULL THEN least(p.ult::timestamp + time '13:10', localtimestamp - (2 + random() * 20) * interval '1 minute') END, CASE WHEN p.ult IS NOT NULL THEN least(p.ult::timestamp + time '13:15', localtimestamp - (1 + random() * 10) * interval '1 minute') END,
       CASE WHEN p.ult IS NOT NULL AND p.ult < (SELECT hoy FROM cfg) - 150 THEN 'INACTIVO' WHEN NOT p.tel OR NOT p.cor THEN 'INCOMPLETO' ELSE 'ACTIVO' END
FROM t_pf p ORDER BY p.id_huesped;

-- preferencias declaradas o detectadas
INSERT INTO preferencia (id_perfil, categoria, descripcion, origen, fecha_registro, vigente)
SELECT pf.id_perfil, x.cat, x.descr, CASE WHEN random() < 0.7 THEN 'DECLARADA' ELSE 'DETECTADA' END,
       h.fecha_registro::timestamp + least(random() * interval '20 days', (localtimestamp - interval '5 minutes' - h.fecha_registro::timestamp) * random()), random() < 0.9
FROM perfil_huesped pf JOIN huesped h USING (id_huesped)
CROSS JOIN LATERAL (SELECT * FROM (VALUES
   ('HABITACION', 'Habitación en piso alto'), ('HABITACION', 'Habitación silenciosa, lejos del ascensor'), ('HABITACION', 'Cama king'), ('HABITACION', 'Almohadas firmes o sintéticas'),
   ('HABITACION', 'Cuna en la habitación'), ('ALIMENTACION', 'Desayuno sin gluten'), ('ALIMENTACION', 'Menú vegetariano'), ('ALIMENTACION', 'Desayuno temprano (antes de las 7:00)'),
   ('SERVICIOS', 'Late check-out cuando sea posible'), ('SERVICIOS', 'Traslado desde el aeropuerto'), ('SERVICIOS', 'Escritorio de trabajo y buena señal de WiFi'),
   ('COMUNICACION', 'Comunicación por WhatsApp'), ('COMUNICACION', 'Comprobante electrónico por correo')) v(cat, descr)
   WHERE pf.id_perfil IS NOT NULL ORDER BY random() LIMIT 1 + floor(random() * 3)::int) x
WHERE random() < 0.55;
UPDATE perfil_huesped pf SET porcentaje_completitud = 25 + (CASE WHEN h.correo IS NOT NULL THEN 25 ELSE 0 END) + (CASE WHEN h.telefono IS NOT NULL THEN 25 ELSE 0 END)
                                                         + (CASE WHEN EXISTS (SELECT 1 FROM preferencia p WHERE p.id_perfil = pf.id_perfil) THEN 25 ELSE 0 END)
FROM huesped h WHERE h.id_huesped = pf.id_huesped;

