BEGIN
  FOR t IN SELECT schemaname, tablename FROM pg_tables WHERE schemaname IN ('g1_reservas', 'g2_housekeeping', 'g3_servicios', 'g4_finanzas', 'g5_crm', 'public') LOOP EXECUTE 'ANALYZE ' || quote_ident(t.schemaname) || '.' || quote_ident(t.tablename); END LOOP;
