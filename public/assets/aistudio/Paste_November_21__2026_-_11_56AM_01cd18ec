-- Temporadas reales del turismo en Lima: se agrupan los dias consecutivos con el mismo tipo de temporada
CREATE TEMP TABLE t_isla ON COMMIT DROP AS
WITH dias AS (
  SELECT d::date AS dia, extract(month FROM d)::int AS m, extract(day FROM d)::int AS dd, extract(year FROM d)::int AS y
  FROM cfg, generate_series(cfg.ini - 10, cfg.fin + 40, interval '1 day') d
), cl AS (
  SELECT dia,
    CASE WHEN (m = 12 AND dd >= 20) OR (m = 1 AND dd <= 6) THEN 'Alta - Navidad y Año Nuevo'
         WHEN dia BETWEEN pg_temp.pascua(y) - 4 AND pg_temp.pascua(y) + 1 THEN 'Alta - Semana Santa'
         WHEN m = 7 AND dd >= 24 THEN 'Alta - Fiestas Patrias'
         WHEN (m = 7 AND dd < 24) OR (m = 8 AND dd <= 20) THEN 'Media alta - Vacaciones de invierno'
         WHEN (m = 4 AND dd >= 15) OR m IN (5, 6, 9, 10) OR (m = 11 AND dd <= 15) THEN 'Baja'
         ELSE 'Media' END AS nom
  FROM dias
), g AS (
  SELECT dia, nom, sum(CASE WHEN nom IS DISTINCT FROM prev THEN 1 ELSE 0 END) OVER (ORDER BY dia) AS isla
  FROM (SELECT dia, nom, lag(nom) OVER (ORDER BY dia) AS prev FROM cl) s
)
SELECT isla, nom, min(dia) AS desde, max(dia) AS hasta,
       CASE WHEN nom LIKE 'Alta - Navidad%' THEN 1.40 WHEN nom LIKE 'Alta%' THEN 1.30 WHEN nom LIKE 'Media alta%' THEN 1.15
            WHEN nom = 'Baja' THEN 0.85 ELSE 1.00 END AS factor
FROM g GROUP BY isla, nom;

INSERT INTO temporada (nombre, fecha_inicio, fecha_fin, factor_ajuste)
SELECT nom || ' (' || to_char(desde, 'DD/MM/YYYY') || ' al ' || to_char(hasta, 'DD/MM/YYYY') || ')', desde, hasta, factor FROM t_isla ORDER BY isla;

INSERT INTO tarifa (id_tipo_habitacion, id_temporada, id_canal_reserva, nombre, precio_base, fecha_inicio, fecha_fin)
SELECT t.id_tipo_habitacion, s.id_temporada, c.id_canal_reserva,
       'Tarifa ' || t.nombre || ' - ' || c.nombre,
       round(b.base * s.factor_ajuste * CASE c.nombre WHEN 'Web del hotel' THEN 0.95 WHEN 'Agencia de viajes' THEN 0.90
                                                      WHEN 'Convenio corporativo' THEN 0.85 ELSE 1.00 END),
       s.fecha_inicio, s.fecha_fin
FROM tipo_habitacion t
JOIN (SELECT DISTINCT id_tipo, base FROM t_hab) b ON b.id_tipo = t.id_tipo_habitacion
CROSS JOIN temporada s CROSS JOIN canal_reserva c;

