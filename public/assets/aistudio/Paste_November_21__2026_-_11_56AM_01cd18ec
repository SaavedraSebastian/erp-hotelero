CREATE TEMP TABLE t_act ON COMMIT DROP AS
SELECT a.id_habitacion, ta.nombre AS tipo, a.id_activo FROM activo a JOIN tipo_activo ta USING (id_tipo_activo) WHERE a.id_habitacion IS NOT NULL;

CREATE OR REPLACE FUNCTION pg_temp.incidencia(p_hab bigint, p_ts timestamptz, p_origen text, p_pers bigint, p_crit text,
                                              OUT nro bigint, OUT t_cierre timestamptz, OUT cat text, OUT crit text, OUT descr text) LANGUAGE plpgsql VOLATILE AS
$$
DECLARE
  v_ahora timestamptz; c record; id_act bigint; tec bigint; costo_h numeric; cc int; t_cre timestamptz; t_ini timestamptz; t_fin timestamptz;
  hrs numeric; est text; ot bigint; inc_est text; trabajo text; sup bigint;
BEGIN
  SELECT ahora INTO v_ahora FROM cfg;
  SELECT * INTO c FROM (VALUES
    ('El aire acondicionado no enfría la habitación',            'Aire acondicionado split', 'Climatización', 3, 1.0, 3.0, 180, ARRAY['Media', 'Alta']),
    ('El aire acondicionado gotea agua sobre la cama',           'Aire acondicionado split', 'Climatización', 3, 0.8, 2.0,  60, ARRAY['Media']),
    ('La televisión no enciende o no sintoniza los canales',      'Televisor Smart TV',       'Electrónica',   5, 0.4, 1.2,   0, ARRAY['Baja']),
    ('El frigobar no enfría',                                     'Frigobar',                 'Electrónica',   5, 0.6, 1.5,  90, ARRAY['Baja', 'Media']),
    ('La caja fuerte no abre y quedó bloqueada',                  'Caja fuerte digital',      'Electrónica',   5, 0.5, 1.0,  40, ARRAY['Media']),
    ('No hay agua caliente en la ducha',                          NULL,                       'Gasfitería',    2, 0.8, 2.5,  50, ARRAY['Alta']),
    ('La cerradura de la puerta se traba al abrir',               NULL,                       'Carpintería',   4, 0.5, 1.5,  60, ARRAY['Alta']),
    ('Fuga de agua en el lavatorio',                              NULL,                       'Gasfitería',    2, 0.6, 1.5,  45, ARRAY['Media']),
    ('Foco quemado y tomacorriente sin energía',                  NULL,                       'Electricidad',  1, 0.3, 0.8,  20, ARRAY['Baja']),
    ('Ruido y vibración en el ducto de ventilación',              NULL,                       'Electricidad',  1, 0.5, 1.5,   0, ARRAY['Baja']),
    ('El riel de la cortina se desprendió',                       NULL,                       'Carpintería',   4, 0.4, 1.0,  15, ARRAY['Baja']),
    ('El WiFi de la habitación no conecta',                       NULL,                       'Electrónica',   5, 0.5, 2.0,   0, ARRAY['Media'])
  ) v(descr, tipo_act, cat, esp, hmin, hmax, rep, crits) ORDER BY random() LIMIT 1;
  descr := c.descr; cat := c.cat;
  crit := coalesce(p_crit, c.crits[1 + floor(random() * array_length(c.crits, 1))::int]);
  IF c.tipo_act IS NOT NULL THEN SELECT id_activo INTO id_act FROM t_act WHERE id_habitacion = p_hab AND tipo = c.tipo_act; END IF;
  SELECT t.id_personal, tm.costo_hora INTO tec, costo_h FROM t_pers t JOIN tecnico_mantenimiento tm USING (id_personal) WHERE t.cargo = 'Técnico' AND t.k = c.esp;
  SELECT id_centro_costo INTO cc FROM centro_costo WHERE nombre = 'Mantenimiento';
  SELECT id_personal INTO sup FROM t_pers WHERE cargo = 'Supervisor' AND k = 3;
  t_cre := p_ts + (5 + random() * 20) * interval '1 minute';
  t_ini := t_cre + (20 + random() * 160) * interval '1 minute';
  hrs := round((c.hmin + random() * (c.hmax - c.hmin))::numeric, 2);
  t_fin := t_ini + (hrs::float8) * interval '1 hour';
  est := CASE WHEN t_fin <= v_ahora THEN 'Cerrada' WHEN t_ini <= v_ahora THEN 'En proceso' ELSE 'Asignada' END;
  IF est = 'En proceso' AND random() < 0.20 THEN est := 'En espera'; END IF;
  trabajo := pg_temp.pick(ARRAY['Se reemplazó la pieza dañada y se verificó el funcionamiento.', 'Se realizó limpieza, ajuste y pruebas de funcionamiento.',
                                'Se reparó la falla y se dejó operativo; se informó a housekeeping.', 'Se cambió el repuesto y se realizaron pruebas con el huésped.']);
  INSERT INTO orden_trabajo (id_activo, id_tecnico, id_centro_costo, tipo_ot, descripcion_tarea, prioridad, estado, motivo_espera, trabajo_realizado, horas_trabajadas, costo_total,
                             fecha_hora_creacion, fecha_hora_inicio, fecha_hora_cierre)
  VALUES (id_act, tec, cc, 'Correctiva', c.descr, CASE crit WHEN 'Alta' THEN 'Alta' WHEN 'Media' THEN 'Media' ELSE 'Baja' END, est,
          CASE WHEN est = 'En espera' THEN 'Esperando el repuesto del proveedor' END,
          CASE WHEN est = 'Cerrada' THEN trabajo END, CASE WHEN est = 'Cerrada' THEN hrs END,
          CASE WHEN est = 'Cerrada' THEN round((hrs * costo_h + random() * c.rep)::numeric, 2) END,
          t_cre, CASE WHEN est IN ('Cerrada', 'En proceso', 'En espera') THEN t_ini END, CASE WHEN est = 'Cerrada' THEN t_fin END)
  RETURNING numero_ot INTO ot;
  inc_est := CASE est WHEN 'Cerrada' THEN 'Cerrada' WHEN 'Asignada' THEN 'Abierta' ELSE 'En atención' END;
  INSERT INTO incidencia (id_habitacion, id_activo, id_personal, descripcion, criticidad, origen, estado, informada_crm, fecha_hora_registro, fecha_hora_cierre)
  VALUES (p_hab, id_act, p_pers, c.descr, crit, p_origen, inc_est, false, p_ts, CASE WHEN est = 'Cerrada' THEN t_fin END)
  RETURNING numero_incidencia INTO nro;
  INSERT INTO ot_correctiva (numero_ot, numero_incidencia, diagnostico) VALUES (ot, nro, 'Diagnóstico: ' || lower(c.descr) || '. Revisión por ' || lower(c.cat) || '.');
  t_cierre := CASE WHEN est = 'Cerrada' THEN t_fin END;
  IF crit = 'Alta' AND sup IS NOT NULL THEN
    PERFORM pg_temp.notificar(sup, 'IncidenciaCritica', 'Incidencia crítica en la habitación ' || (SELECT numero FROM t_hab WHERE id_habitacion = p_hab) || ': ' || lower(c.descr), 'Incidencia', nro, p_ts + interval '2 minutes');
  END IF;
END
$$;
-- =====================================================================
-- 5. RESERVAS, ESTADIAS Y ACOMPAÑANTES (G1) + estado de habitaciones, limpieza e incidencias (G2), en orden cronologico
-- =====================================================================
CREATE TEMP TABLE t_tit (id_huesped bigint PRIMARY KEY, sx text, nombres text, a1 text, a2 text, ext boolean, ultimo date) ON COMMIT DROP;
CREATE TEMP TABLE t_est (
  id_reserva bigint, id_estadia bigint, id_hab bigint, id_tipo bigint, id_huesped bigint, ingreso date, salida date, noches int,
  ts_in timestamptz, ts_out timestamptz, estado_res text, estado_est text, precio_noche numeric, id_tarifa bigint, canal text,
  paquete boolean, npers int, grupo text, corp boolean, id_empresa int, ext boolean, tipo text, fecha_reserva timestamptz,
  early boolean, late boolean) ON COMMIT DROP;
CREATE TEMP TABLE t_inc (numero_incidencia bigint, id_estadia bigint, id_reserva bigint, id_hab bigint, ts timestamptz, origen text, criticidad text, categoria text, id_huesped bigint, descr text) ON COMMIT DROP;

CREATE INDEX ON t_plan (id_hab, tipo, ingreso);
ANALYZE t_hab; ANALYZE t_pers; ANALYZE t_limp; ANALYZE t_plan; ANALYZE programacion_turno; ANALYZE tarifa; ANALYZE canal_reserva; ANALYZE t_empresa; ANALYZE usuario;

DO $estancias$
DECLARE
  v_ini date; v_hoy date; v_ahora timestamptz;
  recep text[]; est_arr text[] := '{}'; dis_arr timestamptz[] := '{}';
  p record; hb record; rt record; tf record; li record; inc record;
  tipo_g text; npers int; g jsonb; nota text; corp boolean; emp int; canal text; id_canal bigint; pq boolean; es_ext boolean; ret boolean;
  antic int; f_res timestamptz; tit_id bigint; tit_sx text; tit_n text; tit_a1 text; tit_a2 text; kk bigint; t_td text; t_doc text;
  id_res bigint; id_det bigint; id_est bigint; noches int; ts_in timestamptz; ts_out timestamptz; h_in numeric; h_out numeric;
  est_res text; est_est text; f_canc timestamptz; prob numeric; occ numeric; usr text; j int; per jsonb; prior text; t_loc timestamptz;
  e_early boolean; e_late boolean; emp_txt text; sup_mant bigint; t_inc timestamptz; t_x timestamptz; id_pers bigint; n_estancias int := 0; n_fila int := 0;
BEGIN
  SELECT ini, hoy, ahora INTO v_ini, v_hoy, v_ahora FROM cfg;
  SELECT array_agg(nombre_usuario) INTO recep FROM usuario WHERE rol = 'RECEPCIONISTA';
  SELECT id_personal INTO sup_mant FROM t_pers WHERE cargo = 'Supervisor' AND k = 3;
  FOR hb IN SELECT * FROM t_hab LOOP
    INSERT INTO cambio_estado_habitacion (id_habitacion, id_estado_anterior, id_estado_nuevo, fecha_hora, origen, motivo)
    VALUES (hb.id_habitacion, NULL, 'DIS', (v_ini - 20)::timestamp + time '08:00', 'Manual', 'Alta de la habitación en el sistema');
    est_arr[hb.id_habitacion] := 'DIS'; dis_arr[hb.id_habitacion] := (v_ini - 20)::timestamp + time '08:00';
  END LOOP;

  FOR p IN SELECT * FROM t_plan ORDER BY ingreso, id_hab, n LOOP
    n_fila := n_fila + 1;
    IF n_fila IN (30, 150, 500, 1200, 2400) THEN   -- las tablas crecen durante la carga: se refrescan las estadisticas para que los triggers usen sus indices
      ANALYZE reserva; ANALYZE detalle_reserva; ANALYZE estadia; ANALYZE orden_limpieza; ANALYZE cambio_estado_habitacion; ANALYZE asignacion_limpieza;
    END IF;
    SELECT * INTO hb FROM t_hab WHERE id_habitacion = p.id_hab;

    ---------------------------------------------------------------- bloqueos de la habitacion (limpieza profunda o reparacion)
    IF p.tipo = 'bloqueo' THEN
      t_loc := (p.ingreso::timestamp + time '08:00')::timestamptz;
      IF t_loc > v_ahora - interval '1 day' OR est_arr[p.id_hab] IS DISTINCT FROM 'DIS' OR dis_arr[p.id_hab] > t_loc THEN CONTINUE; END IF;
      IF p.sub = 'Mantenimiento' THEN
        SELECT * INTO inc FROM pg_temp.incidencia(p.id_hab, t_loc, 'Supervisor', sup_mant, 'Alta');
        INSERT INTO cambio_estado_habitacion (id_habitacion, id_estado_anterior, id_estado_nuevo, id_personal, fecha_hora, origen, motivo)
        VALUES (p.id_hab, 'DIS', 'FSV', sup_mant, t_loc, 'Incidencia', 'Fuera de servicio: ' || lower(inc.descr));
        t_x := coalesce(inc.t_cierre, t_loc + interval '5 hours') + interval '10 minutes';
        IF t_x > v_ahora THEN est_arr[p.id_hab] := 'FSV'; dis_arr[p.id_hab] := v_ahora + interval '1 day'; CONTINUE; END IF;
        INSERT INTO cambio_estado_habitacion (id_habitacion, id_estado_anterior, id_estado_nuevo, id_personal, fecha_hora, origen, motivo)
        VALUES (p.id_hab, 'FSV', 'SUC', sup_mant, t_x, 'OrdenTrabajo', 'Reparación concluida; requiere limpieza posterior');
        SELECT * INTO li FROM pg_temp.limpieza(p.id_hab, NULL, 'Profunda', 'OrdenTrabajo', 'Alta', t_x + interval '10 minutes', hb.min_limpieza * 2, true);
      ELSE
        INSERT INTO cambio_estado_habitacion (id_habitacion, id_estado_anterior, id_estado_nuevo, fecha_hora, origen, motivo)
        VALUES (p.id_hab, 'DIS', 'FSV', t_loc, 'Manual', 'Limpieza profunda programada (colchón, alfombra y cortinas)');
        INSERT INTO cambio_estado_habitacion (id_habitacion, id_estado_anterior, id_estado_nuevo, fecha_hora, origen, motivo)
        VALUES (p.id_hab, 'FSV', 'SUC', t_loc + interval '20 minutes', 'Manual', 'Inicio de limpieza profunda');
        SELECT * INTO li FROM pg_temp.limpieza(p.id_hab, NULL, 'Profunda', 'Manual', 'Baja', t_loc + interval '30 minutes', hb.min_limpieza * 2, true);
      END IF;
      est_arr[p.id_hab] := coalesce(li.est_final, 'SUC'); dis_arr[p.id_hab] := coalesce(li.ts_dis, v_ahora + interval '90 minutes');
      CONTINUE;
    END IF;

    ---------------------------------------------------------------- tipo de grupo, canal y condiciones comerciales
    noches := p.salida - p.ingreso;
    tipo_g := CASE hb.capacidad
      WHEN 1 THEN 'Solo'
      WHEN 2 THEN pg_temp.wpick(ARRAY['Solo', 'Pareja', 'Amigos', 'Trabajo', 'Familia'], ARRAY[28, 45, 9, 8, 10]::numeric[])
      WHEN 3 THEN pg_temp.wpick(ARRAY['Solo', 'Pareja', 'Familia', 'Amigos', 'Trabajo'], ARRAY[15, 18, 38, 14, 15]::numeric[])
      ELSE pg_temp.wpick(ARRAY['Familia', 'Abuelos', 'Amigos', 'Solo', 'Pareja'], ARRAY[45, 18, 17, 10, 10]::numeric[]) END;
    npers := CASE tipo_g WHEN 'Solo' THEN 1 WHEN 'Pareja' THEN 2
              WHEN 'Familia' THEN CASE hb.capacidad WHEN 2 THEN 2 WHEN 3 THEN 3 ELSE 3 + (random() < 0.5)::int END
              WHEN 'Abuelos' THEN 4
              ELSE least(hb.capacidad, 2 + (random() < 0.5)::int + (CASE WHEN hb.capacidad = 4 AND random() < 0.4 THEN 1 ELSE 0 END)) END;
    corp := (tipo_g = 'Trabajo') OR (tipo_g = 'Solo' AND random() < 0.30);
    canal := CASE WHEN corp THEN 'Convenio corporativo'
                  ELSE pg_temp.wpick(ARRAY['Recepción (directo)', 'Web del hotel', 'Booking.com', 'Expedia', 'Agencia de viajes'], ARRAY[14, 18, 32, 12, 14]::numeric[]) END;
    es_ext := random() < CASE canal WHEN 'Booking.com' THEN 0.40 WHEN 'Expedia' THEN 0.45 WHEN 'Agencia de viajes' THEN 0.50 WHEN 'Web del hotel' THEN 0.25
                                 WHEN 'Recepción (directo)' THEN 0.10 ELSE 0.04 END;
    pq := random() < CASE canal WHEN 'Agencia de viajes' THEN 0.85 WHEN 'Booking.com' THEN 0.55 WHEN 'Expedia' THEN 0.55 WHEN 'Web del hotel' THEN 0.50
                                WHEN 'Convenio corporativo' THEN 0.40 ELSE 0.25 END;
    SELECT id_canal_reserva INTO id_canal FROM canal_reserva WHERE nombre = canal;
    SELECT t.id_tarifa, t.precio_base INTO tf FROM tarifa t WHERE t.id_tipo_habitacion = hb.id_tipo AND t.id_canal_reserva = id_canal AND p.ingreso BETWEEN t.fecha_inicio AND t.fecha_fin LIMIT 1;
    antic := least(floor(pg_temp.expo(CASE canal WHEN 'Recepción (directo)' THEN 1.2 WHEN 'Web del hotel' THEN 18 WHEN 'Booking.com' THEN 25 WHEN 'Expedia' THEN 30
                                                  WHEN 'Agencia de viajes' THEN 40 ELSE 10 END))::int, 200);
    f_res := ((p.ingreso - antic)::timestamp + CASE WHEN antic = 0 THEN time '08:00' + random() * interval '5 hours' ELSE time '08:00' + random() * interval '15 hours' END)::timestamptz;
    -- una reserva para dentro de pocos dias no puede haberse creado en el futuro: se reparte en los dias previos en vez de amontonarse en el momento de la carga
    IF f_res > v_ahora - interval '10 minutes' THEN
      f_res := v_ahora - interval '10 minutes' - CASE WHEN antic = 0 THEN random() * interval '4 hours' ELSE random() * least(interval '9 days', (p.ingreso::timestamp - v_ahora::timestamp) + interval '1 day') END;
    END IF;

    ---------------------------------------------------------------- titular (huesped nuevo o recurrente)
    ret := (SELECT count(*) FROM t_tit) > 40 AND random() < 0.20;
    IF ret THEN
      SELECT * INTO rt FROM t_tit WHERE t_tit.ext = es_ext AND (ultimo IS NULL OR ultimo < p.ingreso - 5) ORDER BY random() LIMIT 1;
      IF NOT FOUND THEN ret := false; END IF;
    END IF;
    IF ret THEN
      tit_id := rt.id_huesped; tit_sx := rt.sx; tit_n := rt.nombres; tit_a1 := rt.a1; tit_a2 := rt.a2;
    ELSE
      tit_sx := CASE WHEN random() < 0.5 THEN 'M' ELSE 'F' END; tit_n := pg_temp.nombre(tit_sx, es_ext); tit_a1 := pg_temp.apell(es_ext);
      tit_a2 := CASE WHEN es_ext THEN '' ELSE pg_temp.apell(false) END; kk := nextval('pg_temp.sq_persona');
      t_td := CASE WHEN es_ext THEN 'PAS' ELSE 'DNI' END; t_doc := CASE WHEN es_ext THEN pg_temp.pasaporte(kk) ELSE pg_temp.dni(kk) END;
      INSERT INTO huesped (tipo_documento, numero_documento, nombres, apellidos, telefono, correo, fecha_registro)
      VALUES (t_td, t_doc, tit_n, CASE WHEN es_ext THEN tit_a1 ELSE tit_a1 || ' ' || tit_a2 END,
              CASE WHEN random() < 0.92 THEN pg_temp.celular(kk) END,
              CASE WHEN random() < 0.93 THEN pg_temp.sa(split_part(tit_n, ' ', 1)) || '.' || pg_temp.sa(tit_a1) || (kk % 97)::text || '@' ||
                    pg_temp.wpick(ARRAY['gmail.com', 'hotmail.com', 'outlook.com', 'yahoo.com'], ARRAY[60, 18, 12, 10]::numeric[]) END, f_res)
      RETURNING id_huesped INTO tit_id;
      INSERT INTO t_tit VALUES (tit_id, tit_sx, tit_n, tit_a1, tit_a2, es_ext, NULL);
    END IF;
    g := pg_temp.grupo(tipo_g, tit_sx, tit_a1, tit_a2, es_ext, npers);
    npers := 1 + jsonb_array_length(g -> 'p');
    nota := g ->> 'nota';
    emp := NULL;
    IF corp THEN
      emp := 1 + floor(random() * 20)::int;
      SELECT 'Empresa: ' || razon_social || ' (RUC ' || ruc || ').' INTO emp_txt FROM t_empresa WHERE id = emp;
      nota := CASE WHEN tipo_g = 'Trabajo' THEN nota || ' ' || emp_txt ELSE coalesce(nota || ' ', '') || 'Convenio corporativo. ' || emp_txt END;
    END IF;
    IF pq THEN nota := coalesce(nota || ' ', '') || 'Tarifa con desayuno incluido.'; END IF;

    ---------------------------------------------------------------- estado de la reserva y horas reales de entrada/salida
    e_early := false; e_late := false; ts_in := NULL; ts_out := NULL; est_est := NULL;
    IF p.tipo = 'cancelada' THEN est_res := 'CANCELADA';
    ELSIF p.tipo = 'noshow' THEN est_res := 'NO_SHOW';
    ELSE
      h_in := CASE WHEN random() < 0.10 THEN 10 + random() * 3 ELSE 14 + random() * 6.5 END; e_early := h_in < 13;
      h_out := CASE WHEN random() < 0.06 THEN 13 + random() * 2 ELSE 8 + random() * 4 END; e_late := h_out >= 13;
      ts_in := greatest((p.ingreso::timestamp + h_in * interval '1 hour')::timestamptz, dis_arr[p.id_hab] + interval '10 minutes');
      ts_out := (p.salida::timestamp + h_out * interval '1 hour')::timestamptz;
      IF ts_out < ts_in + interval '6 hours' THEN ts_out := ts_in + interval '8 hours'; END IF;
      IF ts_in > v_ahora THEN est_res := 'CONFIRMADA'; ts_in := NULL; ts_out := NULL;
      ELSIF ts_out > v_ahora THEN est_res := 'EN_CURSO'; est_est := 'EN_CURSO';
      ELSE est_res := 'FINALIZADA'; est_est := 'FINALIZADA'; END IF;
    END IF;

    INSERT INTO reserva (id_huesped, id_tarifa, id_canal_reserva, fecha_reserva, fecha_ingreso, fecha_salida, cantidad_huespedes, estado, observaciones)
    VALUES (tit_id, tf.id_tarifa, id_canal, f_res, p.ingreso, p.salida, npers, est_res, nota) RETURNING id_reserva INTO id_res;
    INSERT INTO detalle_reserva (id_reserva, id_habitacion, precio_noche, cantidad_huespedes) VALUES (id_res, p.id_hab, tf.precio_base, npers) RETURNING id_detalle_reserva INTO id_det;
    UPDATE t_tit SET ultimo = p.salida WHERE id_huesped = tit_id;

    ---------------------------------------------------------------- historial, prediccion de no-show y sugerencia de tarifa
    usr := CASE canal WHEN 'Recepción (directo)' THEN pg_temp.pick(recep) WHEN 'Convenio corporativo' THEN 'portal.corporativo' ELSE 'canal.' || pg_temp.sa(canal) END;
    INSERT INTO historial_reserva (id_reserva, accion, valores_nuevos, usuario, fecha_hora)
    VALUES (id_res, 'CREACIÓN', jsonb_build_object('estado', 'CONFIRMADA', 'ingreso', p.ingreso, 'salida', p.salida, 'huespedes', npers, 'precio_noche', tf.precio_base, 'canal', canal), usr, f_res);
    IF random() < 0.12 AND antic > 2 THEN
      INSERT INTO historial_reserva (id_reserva, accion, valores_anteriores, valores_nuevos, usuario, fecha_hora)
      VALUES (id_res, 'MODIFICACIÓN DE FECHAS', jsonb_build_object('salida', p.salida - 1), jsonb_build_object('salida', p.salida), usr,
              f_res + (least(p.ingreso::timestamptz, v_ahora) - f_res) * 0.4);
    END IF;
    prob := CASE p.tipo WHEN 'noshow' THEN 0.55 + random() * 0.35 WHEN 'cancelada' THEN 0.35 + random() * 0.45
                        ELSE (CASE canal WHEN 'Booking.com' THEN 0.10 WHEN 'Expedia' THEN 0.10 WHEN 'Convenio corporativo' THEN 0.01 ELSE 0.04 END) + random() * 0.18 END;
    INSERT INTO prediccion_no_show (id_reserva, probabilidad, nivel_riesgo, fecha_prediccion, version_modelo)
    VALUES (id_res, round(prob::numeric, 4), CASE WHEN prob < 0.20 THEN 'BAJO' WHEN prob < 0.50 THEN 'MEDIO' ELSE 'ALTO' END, least(f_res + (30 + random() * 690) * interval '1 minute', f_res + (v_ahora - f_res) * (0.2 + random() * 0.7)), 'noshow-gbm-2.3');
    occ := CASE WHEN extract(month FROM p.ingreso) IN (12, 1, 7, 8) THEN 0.70 + random() * 0.28 ELSE 0.35 + random() * 0.45 END;
    INSERT INTO sugerencia_tarifa (id_reserva, tarifa_base, factor_ajuste, tarifa_sugerida, ocupacion_proyectada, anticipacion_dias, fecha_generacion, aceptada)
    VALUES (id_res, hb.base, round((0.85 + occ * 0.5)::numeric, 4), round(hb.base * (0.85 + occ * 0.5), 2), round(occ::numeric, 4), antic, f_res - interval '2 minutes', random() < 0.55);

    IF p.tipo = 'cancelada' THEN
      f_canc := f_res + (least(p.ingreso::timestamptz, v_ahora) - f_res) * (0.2 + random() * 0.75);
      INSERT INTO historial_reserva (id_reserva, accion, valores_anteriores, valores_nuevos, usuario, fecha_hora)
      VALUES (id_res, 'CANCELACIÓN', jsonb_build_object('estado', 'CONFIRMADA'), jsonb_build_object('estado', 'CANCELADA', 'motivo',
              pg_temp.pick(ARRAY['Cambio de planes del viaje', 'Vuelo cancelado', 'Encontró otra alternativa', 'Motivos de salud', 'Cancelación por la empresa'])), usr, f_canc);
    ELSIF p.tipo = 'noshow' THEN
      INSERT INTO historial_reserva (id_reserva, accion, valores_anteriores, valores_nuevos, usuario, fecha_hora)
      VALUES (id_res, 'NO SE PRESENTÓ', jsonb_build_object('estado', 'CONFIRMADA'), jsonb_build_object('estado', 'NO_SHOW'), 'sistema.auditoria-nocturna', (p.ingreso + 1)::timestamp + time '02:00');
    END IF;

    ---------------------------------------------------------------- estadia (check-in), acompañantes, estado y limpieza
    id_est := NULL;
    IF ts_in IS NOT NULL THEN
      INSERT INTO estadia (id_detalle_reserva, id_reserva, id_habitacion, fecha_hora_check_in, fecha_hora_check_out, estado, observaciones)
      VALUES (id_det, id_res, p.id_hab, ts_in, CASE WHEN est_est = 'FINALIZADA' THEN ts_out END, est_est,
              CASE WHEN e_early THEN 'Check-in anticipado: habitación disponible.' WHEN e_late AND est_est = 'FINALIZADA' THEN 'Salida tardía autorizada por recepción.' END)
      RETURNING id_estadia INTO id_est;
      INSERT INTO acompanante (id_estadia, tipo_documento, numero_documento, nombres, apellidos)
      SELECT id_est, e ->> 'td', e ->> 'doc', e ->> 'n', e ->> 'a' FROM jsonb_array_elements(g -> 'p') e;
      INSERT INTO historial_reserva (id_reserva, accion, valores_nuevos, usuario, fecha_hora)
      VALUES (id_res, 'CHECK-IN', jsonb_build_object('estadia', id_est, 'habitacion', hb.numero), pg_temp.pick(recep), ts_in);
      INSERT INTO cambio_estado_habitacion (id_habitacion, id_estado_anterior, id_estado_nuevo, fecha_hora, origen) VALUES (p.id_hab, 'DIS', 'OCU', ts_in, 'Manual');
      est_arr[p.id_hab] := 'OCU';
      -- limpieza durante la estadia (cada dos dias en estadias de 3 noches o mas)
      FOR j IN 1..greatest((noches - 1) / 2, 0) LOOP
        t_loc := ((p.ingreso + 2 * j)::timestamp + time '09:30' + random() * interval '2 hours')::timestamptz;
        EXIT WHEN t_loc > v_ahora - interval '1 hour' OR (p.ingreso + 2 * j) >= p.salida;
        PERFORM pg_temp.limpieza(p.id_hab, id_est, 'Estadía', 'Manual', 'Baja', t_loc, hb.min_limpieza, false);
      END LOOP;
      -- incidencia durante la estadia (7 %)
      IF random() < 0.07 AND least(ts_out, v_ahora) - ts_in > interval '5 hours' THEN
        t_inc := ts_in + (least(ts_out, v_ahora) - ts_in - interval '3 hours') * (0.1 + random() * 0.8);
        id_pers := NULL;
        IF random() < 0.30 THEN SELECT id_personal INTO id_pers FROM t_pers WHERE cargo = 'Limpieza' AND k <= 12 ORDER BY random() LIMIT 1; END IF;
        SELECT * INTO inc FROM pg_temp.incidencia(p.id_hab, t_inc, CASE WHEN id_pers IS NULL THEN 'Huésped' ELSE 'Personal' END, id_pers, NULL);
        INSERT INTO t_inc VALUES (inc.nro, id_est, id_res, p.id_hab, t_inc, CASE WHEN id_pers IS NULL THEN 'Huésped' ELSE 'Personal' END, inc.crit, inc.cat, tit_id, inc.descr);
      END IF;
      IF est_est = 'FINALIZADA' THEN
        INSERT INTO historial_reserva (id_reserva, accion, valores_nuevos, usuario, fecha_hora)
        VALUES (id_res, 'CHECK-OUT', jsonb_build_object('estadia', id_est), pg_temp.pick(recep), ts_out);
        INSERT INTO cambio_estado_habitacion (id_habitacion, id_estado_anterior, id_estado_nuevo, fecha_hora, origen, motivo) VALUES (p.id_hab, 'OCU', 'SUC', ts_out, 'Check-out', NULL);
        prior := CASE WHEN EXISTS (SELECT 1 FROM t_plan x WHERE x.id_hab = p.id_hab AND x.tipo = 'estadia' AND x.ingreso = p.salida) THEN 'Alta' ELSE 'Media' END;
        SELECT * INTO li FROM pg_temp.limpieza(p.id_hab, id_est, 'Salida', 'Check-out', prior, ts_out, hb.min_limpieza, true);
        IF li.nro IS NULL THEN RAISE EXCEPTION 'Sin personal de limpieza disponible el %', ts_out::date; END IF;
        est_arr[p.id_hab] := coalesce(li.est_final, 'SUC'); dis_arr[p.id_hab] := coalesce(li.ts_dis, v_ahora + interval '90 minutes');
      END IF;
      n_estancias := n_estancias + 1;
    END IF;

    INSERT INTO t_est VALUES (id_res, id_est, p.id_hab, hb.id_tipo, tit_id, p.ingreso, p.salida, noches, ts_in, ts_out, est_res, est_est, tf.precio_base, tf.id_tarifa, canal,
                              pq, npers, tipo_g, corp, emp, es_ext, p.tipo, f_res, e_early, e_late);
  END LOOP;
  RAISE NOTICE 'Reservas cargadas: %, estadias: %', (SELECT count(*) FROM t_est), n_estancias;
END
