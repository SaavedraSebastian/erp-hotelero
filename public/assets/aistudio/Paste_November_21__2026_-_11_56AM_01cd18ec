-- =====================================================================
-- 13. G2: mantenimiento preventivo, modelos predictivos, propuestas de asignacion, lista de espera (G1) e integracion entre modulos
-- =====================================================================
-- ----------------------------------------------------------------- OT preventivas: historial por plan/activo (segun la periodicidad) y la proxima ejecucion si ya esta cerca
CREATE TEMP TABLE t_pre ON COMMIT DROP AS
SELECT nextval(pg_get_serial_sequence('orden_trabajo', 'numero_ot')) AS ot, pp.id_plan, pp.id_activo, f.dia, p.tarea, ta.nombre AS tipo,
       CASE ta.nombre WHEN 'Aire acondicionado split' THEN 3 WHEN 'Terma a gas' THEN 2 WHEN 'Bomba de agua' THEN 2 WHEN 'Ascensor' THEN 1 WHEN 'Grupo electrógeno' THEN 1 WHEN 'Lavadora industrial' THEN 1 ELSE 5 END AS esp,
       f.dia > (SELECT hoy FROM cfg) - 1 AS futura, random() AS r
FROM programacion_preventiva pp JOIN plan_mantenimiento p ON p.id_plan = pp.id_plan JOIN tipo_activo ta ON ta.id_tipo_activo = p.id_tipo_activo
CROSS JOIN LATERAL (
   SELECT d AS dia FROM (
     SELECT pp.fecha_ultima_ejecucion - k * CASE p.tipo_periodicidad WHEN 'Meses' THEN p.valor_periodicidad * 30 ELSE p.valor_periodicidad * 7 END AS d
     FROM generate_series(0, 12) k WHERE pp.fecha_ultima_ejecucion IS NOT NULL
     UNION ALL SELECT pp.fecha_proxima_ejecucion WHERE pp.fecha_proxima_ejecucion BETWEEN (SELECT hoy FROM cfg) AND (SELECT hoy FROM cfg) + 6) q
   WHERE d >= (SELECT ini FROM cfg) + 3) f
ORDER BY f.dia, pp.id_activo;

INSERT INTO orden_trabajo (numero_ot, id_activo, id_tecnico, id_centro_costo, tipo_ot, descripcion_tarea, prioridad, estado, trabajo_realizado, horas_trabajadas, costo_total, fecha_hora_creacion, fecha_hora_inicio, fecha_hora_cierre)
SELECT t.ot, t.id_activo, (SELECT id_personal FROM t_pers WHERE cargo = 'Técnico' AND k = t.esp), (SELECT id_centro_costo FROM centro_costo WHERE nombre = 'Mantenimiento'), 'Preventiva',
       t.tarea || ' (' || a.nombre || ')', 'Baja', CASE WHEN t.futura THEN 'Asignada' ELSE 'Cerrada' END,
       CASE WHEN NOT t.futura THEN 'Mantenimiento preventivo ejecutado según el plan; sin observaciones.' END,
       CASE WHEN NOT t.futura THEN round((0.5 + t.r * 2.5)::numeric, 2) END,
       CASE WHEN NOT t.futura THEN round(((0.5 + t.r * 2.5) * (SELECT costo_hora FROM tecnico_mantenimiento WHERE id_personal = (SELECT id_personal FROM t_pers WHERE cargo = 'Técnico' AND k = t.esp)) + (t.r * 35))::numeric, 2) END,
       CASE WHEN t.futura THEN (SELECT ahora FROM cfg) - interval '20 hours' ELSE t.dia + time '07:30' END,
       CASE WHEN NOT t.futura THEN t.dia + time '09:00' + t.r * interval '2 hours' END,
       CASE WHEN NOT t.futura THEN t.dia + time '09:00' + t.r * interval '2 hours' + (0.5 + t.r * 2.5) * interval '1 hour' END
FROM t_pre t JOIN activo a ON a.id_activo = t.id_activo ORDER BY t.ot;
INSERT INTO ot_preventiva (numero_ot, id_plan, fecha_programada) SELECT ot, id_plan, dia FROM t_pre ORDER BY ot;

-- ----------------------------------------------------------------- modelo predictivo de fallas: una evaluacion diaria; algunas generan alertas que se atienden con OT preventiva
INSERT INTO evaluacion_predictiva (fecha_hora_ejecucion, version_modelo, activos_evaluados, activos_sin_datos, resultado)
SELECT d::date + time '02:00' + random() * interval '4 minutes', CASE WHEN d::date < (SELECT ini FROM cfg) + 120 THEN 'falla-activos-v1.4' ELSE 'falla-activos-v2.0' END,
       (SELECT count(*) FROM activo WHERE estado <> 'Dado de baja') - (random() < 0.08)::int * 2, CASE WHEN random() < 0.15 THEN 1 + floor(random() * 3)::int ELSE 0 END,
       CASE WHEN random() < 0.02 THEN 'Fallida' ELSE 'Completada' END
FROM generate_series((SELECT ini FROM cfg), (SELECT hoy FROM cfg), interval '1 day') d
WHERE d::date + time '02:00' < (SELECT ahora FROM cfg)::timestamp ORDER BY 1;
UPDATE evaluacion_predictiva SET activos_evaluados = 0, activos_sin_datos = 0 WHERE resultado = 'Fallida';

CREATE TEMP TABLE t_al ON COMMIT DROP AS
SELECT row_number() OVER (ORDER BY ev.fecha_hora_ejecucion) AS n, ev.id_evaluacion, ev.fecha_hora_ejecucion AS f, a.id_activo, a.nombre, ta.umbral_alerta AS umbral, ta.nombre AS tipo,
       round((ta.umbral_alerta + (1 - ta.umbral_alerta) * (0.15 + random() * 0.8))::numeric, 4) AS prob
FROM (SELECT id_activo, id_tipo_activo, nombre FROM activo WHERE estado = 'Operativo' ORDER BY random() LIMIT 26) a
JOIN tipo_activo ta ON ta.id_tipo_activo = a.id_tipo_activo
CROSS JOIN LATERAL (SELECT * FROM evaluacion_predictiva WHERE resultado = 'Completada' AND fecha_hora_ejecucion < (SELECT ahora FROM cfg) - interval '2 days'
                    ORDER BY (hashtext(a.id_activo::text || id_evaluacion::text)) LIMIT 1) ev;
ALTER TABLE t_al ADD COLUMN estado text, ADD COLUMN f_act timestamptz;
UPDATE t_al SET estado = CASE WHEN n % 13 = 0 THEN 'Descartada' ELSE 'Atendida' END, f_act = f + (1 + (n % 6)) * interval '1 day' + interval '9 hours';
UPDATE t_al SET estado = 'Abierta', f_act = NULL, f = (SELECT ahora FROM cfg) - (1 + n % 3) * interval '1 day' WHERE n IN (SELECT n FROM t_al ORDER BY n DESC LIMIT 3);
INSERT INTO alerta_predictiva (id_evaluacion, id_activo, probabilidad_falla, umbral_aplicado, factores_explicativos, estado, fecha_hora_generacion, fecha_hora_actualizacion)
SELECT id_evaluacion, id_activo, prob, umbral,
       CASE tipo WHEN 'Aire acondicionado split' THEN 'Aumento del consumo eléctrico y del tiempo de enfriamiento en las últimas dos semanas'
                 WHEN 'Frigobar' THEN 'Ciclos de compresor más frecuentes y temperatura interna inestable'
                 WHEN 'Ascensor' THEN 'Incremento de paradas de emergencia y vibración en el motor'
                 WHEN 'Bomba de agua' THEN 'Caída de presión sostenida y horas de uso cercanas al ciclo de mantenimiento'
                 ELSE 'Horas de uso acumuladas cercanas al límite de vida útil y fallas recurrentes' END, estado, f, f_act
FROM t_al ORDER BY f;

-- OT preventiva generada por cada alerta atendida (la alerta es el origen; unica por alerta)
CREATE TEMP TABLE t_alot ON COMMIT DROP AS
SELECT nextval(pg_get_serial_sequence('orden_trabajo', 'numero_ot')) AS ot, al.id_alerta, al.id_activo, al.fecha_hora_actualizacion AS f, a.nombre, random() AS r,
       CASE ta.nombre WHEN 'Aire acondicionado split' THEN 3 WHEN 'Bomba de agua' THEN 2 WHEN 'Ascensor' THEN 1 ELSE 5 END AS esp
FROM alerta_predictiva al JOIN activo a ON a.id_activo = al.id_activo JOIN tipo_activo ta ON ta.id_tipo_activo = a.id_tipo_activo WHERE al.estado = 'Atendida' ORDER BY al.fecha_hora_generacion;
INSERT INTO orden_trabajo (numero_ot, id_activo, id_tecnico, id_centro_costo, tipo_ot, descripcion_tarea, prioridad, estado, trabajo_realizado, horas_trabajadas, costo_total, fecha_hora_creacion, fecha_hora_inicio, fecha_hora_cierre)
SELECT ot, id_activo, (SELECT id_personal FROM t_pers WHERE cargo = 'Técnico' AND k = esp), (SELECT id_centro_costo FROM centro_costo WHERE nombre = 'Mantenimiento'), 'Preventiva',
       'Revisión preventiva por alerta predictiva: ' || nombre, 'Media', 'Cerrada', 'Se revisó el equipo y se reemplazaron los componentes con desgaste; se reinició el seguimiento del modelo.',
       round((1 + r * 3)::numeric, 2), round((1 + r * 3)::numeric * 28 + (r * 120)::numeric, 2), f - interval '2 hours', f, f + (1 + r * 3) * interval '1 hour'
FROM t_alot ORDER BY ot;
INSERT INTO ot_preventiva (numero_ot, id_alerta, fecha_programada) SELECT ot, id_alerta, f::date FROM t_alot ORDER BY ot;

-- ----------------------------------------------------------------- propuestas de asignacion de limpieza (IA): una por dia y turno, con el detalle de cada orden propuesta
CREATE TEMP TABLE t_prop ON COMMIT DROP AS
SELECT row_number() OVER (ORDER BY o.fecha_programada, o.id_turno) AS n, o.fecha_programada AS fecha, o.id_turno, min(o.fecha_hora_creacion) AS f_gen, count(*) AS nord
FROM asignacion_limpieza a JOIN orden_limpieza o ON o.numero_orden = a.numero_orden
WHERE a.origen_asignacion = 'PropuestaIA' AND a.vigente GROUP BY o.fecha_programada, o.id_turno;
INSERT INTO propuesta_asignacion (id_supervisor, id_turno, fecha, fecha_hora_generacion, version_modelo, estado, fecha_hora_decision)
SELECT (SELECT id_personal FROM t_pers WHERE cargo = 'Supervisor' AND k = 1 + (p.n % 2)), p.id_turno, p.fecha, p.f_gen - interval '30 minutes', 'asignacion-hk-v1.3',
       CASE WHEN p.fecha >= (SELECT hoy FROM cfg) THEN 'Generada' WHEN p.n % 10 < 7 THEN 'Aceptada' WHEN p.n % 10 < 9 THEN 'Modificada' ELSE 'Rechazada' END,
       CASE WHEN p.fecha >= (SELECT hoy FROM cfg) THEN NULL ELSE p.f_gen - interval '30 minutes' + (2 + (p.n % 12)) * interval '1 minute' END
FROM t_prop p ORDER BY p.n;
INSERT INTO detalle_propuesta (id_propuesta, numero_orden, id_personal, minutos_estimados, carga_resultante, justificacion)
SELECT pa.id_propuesta, o.numero_orden, a.id_personal,
       CASE o.tipo_limpieza WHEN 'Salida' THEN 40 WHEN 'Profunda' THEN 90 ELSE 25 END + (o.numero_orden % 7)::int,
       row_number() OVER (PARTITION BY pa.id_propuesta, a.id_personal ORDER BY o.numero_orden)::int,
       CASE WHEN o.prioridad = 'Alta' THEN 'Prioridad alta por llegada próxima del huésped; se asigna a quien tiene su piso base cerca'
            ELSE 'Se asigna por piso base y menor carga de trabajo en el turno' END
FROM asignacion_limpieza a JOIN orden_limpieza o ON o.numero_orden = a.numero_orden
JOIN propuesta_asignacion pa ON pa.fecha = o.fecha_programada AND pa.id_turno = o.id_turno
WHERE a.origen_asignacion = 'PropuestaIA' AND a.vigente;

-- ----------------------------------------------------------------- G1: lista de espera (tipos de habitacion agotados en las fechas solicitadas)
INSERT INTO lista_espera (id_huesped, id_tipo_habitacion, fecha_ingreso, fecha_salida, fecha_registro, prioridad, estado)
SELECT x.id_huesped, x.id_tipo, x.f_in, x.f_in + x.noches, (x.f_in - x.antes)::timestamp + time '10:00' + random() * interval '8 hours', x.prio,
       CASE WHEN x.f_in < (SELECT hoy FROM cfg) THEN (CASE WHEN random() < 0.4 THEN 'ATENDIDA' WHEN random() < 0.7 THEN 'VENCIDA' ELSE 'CANCELADA' END) ELSE 'PENDIENTE' END
FROM (SELECT h.id_huesped, th.id_tipo_habitacion AS id_tipo, (SELECT ini FROM cfg) + 30 + floor(random() * 310)::int AS f_in, 1 + floor(random() * 4)::int AS noches, 3 + floor(random() * 25)::int AS antes, 1 + floor(random() * 3)::int AS prio
      FROM (SELECT id_huesped FROM huesped ORDER BY random() LIMIT 140) h CROSS JOIN LATERAL (SELECT id_tipo_habitacion FROM tipo_habitacion ORDER BY random() LIMIT 1) th) x
WHERE x.f_in - x.antes < (SELECT hoy FROM cfg) ORDER BY 4;

-- ----------------------------------------------------------------- integracion entre modulos: eventos (bandeja de salida) y bitacora de llamadas del modulo G2
CREATE TEMP TABLE t_ev ON COMMIT DROP AS
SELECT 'G1'::text AS o, 'G4'::text AS d, 'EstadiaFinalizada'::text AS tipo, 'estadia'::text AS entidad, e.id_estadia::text AS ident, e.ts_out + interval '2 minutes' AS f,
       jsonb_build_object('id_estadia', e.id_estadia, 'habitacion', e.id_hab, 'noches', e.noches) AS payload
FROM t_est e WHERE e.estado_est = 'FINALIZADA' AND e.ts_out < (SELECT ahora FROM cfg) - interval '5 minutes'
UNION ALL
SELECT 'G1', 'G2', 'CheckOutRegistrado', 'estadia', e.id_estadia::text, e.ts_out + interval '1 minute', jsonb_build_object('id_estadia', e.id_estadia, 'habitacion', e.id_hab, 'requiere_limpieza', true)
FROM t_est e WHERE e.estado_est = 'FINALIZADA' AND e.ts_out < (SELECT ahora FROM cfg) - interval '5 minutes'
UNION ALL
SELECT 'G1', 'G5', 'EstadiaFinalizada', 'estadia', e.id_estadia::text, e.ts_out + interval '3 minutes', jsonb_build_object('id_estadia', e.id_estadia, 'huesped', e.id_huesped)
FROM t_est e WHERE e.estado_est = 'FINALIZADA' AND e.ts_out < (SELECT ahora FROM cfg) - interval '5 minutes'
UNION ALL
SELECT 'G2', 'G1', 'HabitacionLista', 'orden_limpieza', o.numero_orden::text, o.fecha_hora_fin + interval '1 minute', jsonb_build_object('numero_orden', o.numero_orden, 'habitacion', o.id_habitacion, 'estado', 'Disponible')
FROM orden_limpieza o WHERE o.estado = 'Cerrada' AND o.fecha_hora_fin IS NOT NULL
UNION ALL
SELECT 'G2', 'G5', 'IncidenciaRegistrada', 'incidencia', i.numero_incidencia::text, i.fecha_hora_registro + interval '5 minutes', jsonb_build_object('numero_incidencia', i.numero_incidencia, 'criticidad', i.criticidad)
FROM incidencia i WHERE i.criticidad = 'Alta'
UNION ALL
SELECT 'G3', 'G4', 'ConsumoConfirmado', 'consumo', c.numero_consumo, c.fecha_hora_confirmacion + interval '30 seconds', jsonb_build_object('numero_consumo', c.numero_consumo, 'importe', c.importe_total)
FROM g3_servicios.consumo c WHERE c.estado = 'confirmado' AND c.forma_cobro <> 'incluido en paquete' AND random() < 0.35
UNION ALL
SELECT 'G4', 'G5', 'PagoRegistrado', 'comprobante', cp.id_comprobante, cp.fecha_emision::timestamp + time '12:00', jsonb_build_object('comprobante', cp.id_comprobante, 'total', cp.total)
FROM comprobante cp WHERE random() < 0.5;
DELETE FROM t_ev WHERE f IS NULL OR f > (SELECT ahora FROM cfg);
ALTER TABLE t_ev ADD COLUMN corr uuid DEFAULT gen_random_uuid(), ADD COLUMN n bigserial, ADD COLUMN estado text, ADD COLUMN intentos int, ADD COLUMN motivo text;
UPDATE t_ev SET estado = CASE WHEN f > (SELECT ahora FROM cfg) - interval '10 minutes' THEN 'pendiente'
                              WHEN n % 97 = 0 THEN 'rechazado' WHEN n % 211 = 0 THEN 'sin respuesta' ELSE 'entregado' END;
UPDATE t_ev SET intentos = CASE estado WHEN 'pendiente' THEN 0 WHEN 'sin respuesta' THEN 4 WHEN 'rechazado' THEN 1 ELSE CASE WHEN n % 31 = 0 THEN 2 ELSE 1 END END,
                motivo = CASE WHEN estado = 'rechazado' THEN pg_temp.pick(ARRAY['La entidad referenciada no existe en el módulo destino', 'Versión de contrato no soportada por el destino', 'Datos obligatorios incompletos en el mensaje']) END;

-- bitacora de integracion del modulo G2 (Housekeeping y Mantenimiento): cada evento donde participa G2, visto desde su lado
INSERT INTO registro_integracion (id_correlacion, direccion, modulo_contraparte, servicio, version_contrato, resultado, intentos, detalle_error, fecha_hora, payload)
SELECT e.corr, CASE WHEN e.o = 'G2' THEN 'Saliente' ELSE 'Entrante' END, CASE WHEN e.o = 'G2' THEN e.d ELSE e.o END, e.tipo, 'v1',
       CASE e.estado WHEN 'entregado' THEN 'Exitoso' WHEN 'pendiente' THEN 'Encolado' ELSE 'Error' END, greatest(e.intentos, 1),
       CASE e.estado WHEN 'rechazado' THEN e.motivo WHEN 'sin respuesta' THEN 'Tiempo de espera agotado tras 4 intentos' END, e.f, e.payload
FROM t_ev e WHERE 'G2' IN (e.o, e.d) ORDER BY e.f;

