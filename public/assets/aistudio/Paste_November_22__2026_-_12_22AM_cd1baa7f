RESET ROLE;
DO $funciones$
DECLARE f record;
BEGIN
 FOR f IN
  SELECT n.nspname,p.proname,pg_get_function_identity_arguments(p.oid) AS argumentos
  FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
  WHERE n.nspname IN ('g1_reservas','g2_housekeeping','g3_servicios','g4_finanzas','g5_crm')
    AND p.prokind='f'
 LOOP
  EXECUTE format('ALTER FUNCTION %I.%I(%s) SET search_path TO pg_catalog,%I,pg_temp',
    f.nspname,f.proname,f.argumentos,f.nspname);
 END LOOP;
END $funciones$;

