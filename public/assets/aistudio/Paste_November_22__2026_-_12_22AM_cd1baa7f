-- Habitaciones y pisos se calculan desde G1 para no duplicar datos maestros.
CREATE OR REPLACE VIEW configuracion.v_establecimiento_actual AS
SELECT e.id_establecimiento,e.codigo,e.razon_social,e.nombre_comercial,e.ruc,
       e.direccion,e.zona_horaria,e.moneda,e.logo_url,e.estado,
       (CURRENT_TIMESTAMP AT TIME ZONE e.zona_horaria)::date AS fecha_operativa,
       (SELECT count(*) FROM g1_reservas.habitacion h
         WHERE h.estado_registro = 'ACTIVA') AS total_habitaciones,
       (SELECT count(DISTINCT h.piso) FROM g1_reservas.habitacion h
         WHERE h.estado_registro = 'ACTIVA') AS total_pisos
FROM configuracion.establecimiento e
WHERE e.id_establecimiento = 1;

