-- Validación de correspondencia entre estadía y detalle de reserva.
CREATE OR REPLACE FUNCTION g1_reservas.validar_estadia_detalle() RETURNS TRIGGER
LANGUAGE plpgsql AS $$
DECLARE v_reserva BIGINT; v_habitacion BIGINT;
BEGIN
 SELECT id_reserva, id_habitacion INTO v_reserva, v_habitacion
 FROM g1_reservas.detalle_reserva WHERE id_detalle_reserva=NEW.id_detalle_reserva;
 IF v_reserva IS DISTINCT FROM NEW.id_reserva OR v_habitacion IS DISTINCT FROM NEW.id_habitacion THEN
  RAISE EXCEPTION 'La estadia debe corresponder al detalle de reserva y habitacion';
 END IF;
 RETURN NEW;
END $$;
DROP TRIGGER IF EXISTS trg_validar_estadia_detalle ON g1_reservas.estadia;
CREATE TRIGGER trg_validar_estadia_detalle BEFORE INSERT OR UPDATE ON g1_reservas.estadia
FOR EACH ROW EXECUTE FUNCTION g1_reservas.validar_estadia_detalle();

CREATE INDEX IF NOT EXISTS idx_reserva_fechas ON g1_reservas.reserva(fecha_ingreso,fecha_salida);
