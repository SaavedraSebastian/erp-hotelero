DO $rls_seguridad$
DECLARE v_table text;
BEGIN
  FOREACH v_table IN ARRAY ARRAY[
    'departamento','usuario_sistema','rol','permiso','usuario_rol','rol_permiso'
  ] LOOP
    EXECUTE format('ALTER TABLE seguridad.%I ENABLE ROW LEVEL SECURITY', v_table);
    EXECUTE format('DROP POLICY IF EXISTS seguridad_backend ON seguridad.%I', v_table);
    EXECUTE format(
      'CREATE POLICY seguridad_backend ON seguridad.%I FOR ALL TO sgh_erp_backend '
      'USING (true) WITH CHECK (true)', v_table
    );
  END LOOP;
END
$rls_seguridad$;

COMMIT;

