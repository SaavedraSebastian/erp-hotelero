  fecha_hora_creacion timestamptz NOT NULL DEFAULT current_timestamp,
  fecha_hora_inicio timestamptz,
  fecha_hora_fin timestamptz,
  observaciones varchar(500),
  CHECK (fecha_hora_inicio IS NULL OR fecha_hora_inicio >= fecha_hora_creacion),
  CHECK (fecha_hora_fin IS NULL OR (fecha_hora_inicio IS NOT NULL AND fecha_hora_fin >= fecha_hora_inicio))
