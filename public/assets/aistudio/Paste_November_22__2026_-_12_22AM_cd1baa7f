    ON g4_finanzas.cuenta_por_cobrar (id_cuenta);
CREATE INDEX IF NOT EXISTS ix_cxc_estado_vencimiento
    ON g4_finanzas.cuenta_por_cobrar (estado, fecha_vencimiento);

CREATE OR REPLACE FUNCTION g4_finanzas.fn_cxc_normalizar()
RETURNS trigger
LANGUAGE plpgsql
SET search_path = pg_catalog, g4_finanzas, pg_temp
AS $funcion$
DECLARE
    v_cuenta_comprobante VARCHAR(36);
    v_saldo NUMERIC(12,2);
BEGIN
    IF NEW.id_comprobante IS NOT NULL THEN
        SELECT c.id_cuenta
          INTO v_cuenta_comprobante
          FROM g4_finanzas.comprobante c
         WHERE c.id_comprobante = NEW.id_comprobante;

        IF NOT FOUND THEN
            RAISE EXCEPTION 'El comprobante % no existe', NEW.id_comprobante;
        END IF;

        IF NEW.id_cuenta IS NULL THEN
            NEW.id_cuenta := v_cuenta_comprobante;
        ELSIF NEW.id_cuenta <> v_cuenta_comprobante THEN
            RAISE EXCEPTION 'La cuenta % no corresponde al comprobante %',
                NEW.id_cuenta, NEW.id_comprobante;
        END IF;
    END IF;

    IF NEW.id_cuenta IS NULL THEN
        RAISE EXCEPTION 'La cuenta por cobrar debe vincularse a una cuenta o comprobante';
    END IF;

    v_saldo := NEW.monto_original - NEW.monto_pagado;
    NEW.estado := CASE
        WHEN v_saldo = 0 THEN 'PAGADA'
        WHEN NEW.fecha_vencimiento < CURRENT_DATE THEN 'VENCIDA'
        ELSE 'VIGENTE'
    END;
    NEW.fecha_actualizacion := CURRENT_TIMESTAMP;
    RETURN NEW;
END
$funcion$;

DROP TRIGGER IF EXISTS trg_cxc_normalizar ON g4_finanzas.cuenta_por_cobrar;
CREATE TRIGGER trg_cxc_normalizar
BEFORE INSERT OR UPDATE
ON g4_finanzas.cuenta_por_cobrar
FOR EACH ROW EXECUTE FUNCTION g4_finanzas.fn_cxc_normalizar();

-- Permite que una tarea diaria refresque VIGENTE/VENCIDA sin modificar montos.
CREATE OR REPLACE FUNCTION g4_finanzas.actualizar_estado_cuentas_por_cobrar()
RETURNS INTEGER
LANGUAGE plpgsql
SET search_path = pg_catalog, g4_finanzas, pg_temp
AS $funcion$
DECLARE
    v_actualizadas INTEGER;
BEGIN
    UPDATE g4_finanzas.cuenta_por_cobrar
       SET estado = CASE
           WHEN saldo_pendiente = 0 THEN 'PAGADA'
           WHEN fecha_vencimiento < CURRENT_DATE THEN 'VENCIDA'
           ELSE 'VIGENTE'
       END,
           fecha_actualizacion = CURRENT_TIMESTAMP
     WHERE estado IS DISTINCT FROM CASE
           WHEN saldo_pendiente = 0 THEN 'PAGADA'
           WHEN fecha_vencimiento < CURRENT_DATE THEN 'VENCIDA'
           ELSE 'VIGENTE'
       END;
    GET DIAGNOSTICS v_actualizadas = ROW_COUNT;
    RETURN v_actualizadas;
END
$funcion$;

