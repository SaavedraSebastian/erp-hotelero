CREATE TABLE segmento (
    id_segmento INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    codigo_segmento CHAR(6)  NOT NULL UNIQUE CHECK (codigo_segmento ~ '^SEG[0-9]{3}$'),
    nombre      VARCHAR(50)  NOT NULL UNIQUE,
    descripcion VARCHAR(150),
    prioridad   SMALLINT NOT NULL CHECK (prioridad BETWEEN 1 AND 999),
    activo      BOOLEAN  NOT NULL DEFAULT TRUE
);
 
CREATE TABLE regla_segmento (
    id_regla INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
id_segmento  INTEGER       NOT NULL REFERENCES segmento (id_segmento),
criterio     VARCHAR(30)   NOT NULL
             CHECK (criterio IN ('FRECUENCIA_VISITA','GASTO_ACUMULADO','NOCHES_ACUMULADAS','ANTIGUEDAD')),
operador VARCHAR(2)NOT NULL CHECK (operador IN ('>=','<=','=','>','<')),
    valor_umbral NUMERIC(12,2) NOT NULL CHECK (valor_umbral >= 0),
    activo   BOOLEAN   NOT NULL DEFAULT TRUE
);
CREATE INDEX ix_regla_segmento_segmento ON regla_segmento (id_segmento);
 
CREATE TABLE perfil_huesped (
    id_perfil          INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_huesped             BIGINT   NOT NULL UNIQUE,  
id_segmento        INTEGER   REFERENCES segmento (id_segmento),
fecha_alta         DATE      NOT NULL DEFAULT CURRENT_DATE,
total_estadias     INTEGER   NOT NULL DEFAULT 0 CHECK (total_estadias >= 0),
valor_acumulado    NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (valor_acumulado >= 0),
fecha_ultima_estadia   DATE,
fec_act_estadias   TIMESTAMP,
    fec_act_incidencias TIMESTAMP,
    fec_act_consumos   TIMESTAMP,
    fec_act_valor          TIMESTAMP,
    porcentaje_completitud NUMERIC(5,2)  NOT NULL DEFAULT 0 CHECK (porcentaje_completitud BETWEEN 0 AND 100),
    estado_perfil          VARCHAR(12)   NOT NULL DEFAULT 'INCOMPLETO'
                       CHECK (estado_perfil IN ('ACTIVO','INACTIVO','INCOMPLETO'))
);
CREATE INDEX ix_perfil_segmento ON perfil_huesped (id_segmento);
 
CREATE TABLE preferencia (
    id_preferencia INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_perfil  INTEGER  NOT NULL REFERENCES perfil_huesped (id_perfil),
categoria  VARCHAR(20)  NOT NULL
               CHECK (categoria IN ('HABITACION','ALIMENTACION','SERVICIOS','COMUNICACION')),
descripcion VARCHAR(150) NOT NULL,
origen     VARCHAR(10)  NOT NULL CHECK (origen IN ('DECLARADA','DETECTADA')),
fecha_registro TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
vigente    BOOLEAN      NOT NULL DEFAULT TRUE
);
CREATE INDEX ix_preferencia_perfil ON preferencia (id_perfil);
 
CREATE TABLE campana (
    id_campana INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    codigo_campana CHAR(12) NOT NULL UNIQUE CHECK (codigo_campana ~ '^CMP-[0-9]{4}-[0-9]{3}$'),
    id_segmento INTEGER  NOT NULL REFERENCES segmento (id_segmento),
    nombre     VARCHAR(80)  NOT NULL,
    canal      VARCHAR(15)  NOT NULL CHECK (canal IN ('CORREO','NOTIFICACION')),
    mensaje    VARCHAR(500) NOT NULL,
    fecha_inicio   DATE     NOT NULL,
    fecha_fin  DATE     NOT NULL,
    estado     VARCHAR(12)  NOT NULL DEFAULT 'PROGRAMADA'
               CHECK (estado IN ('PROGRAMADA','ACTIVA','CERRADA','CANCELADA')),
CONSTRAINT ck_campana_vigencia CHECK (fecha_fin >= fecha_inicio)           -- A5
);
CREATE INDEX ix_campana_segmento ON campana (id_segmento);
 
-- Relación N:M «recibe» (R06) con sus atributos propios
CREATE TABLE envio_campana (
id_campana   INTEGER NOT NULL REFERENCES campana (id_campana),
id_perfil    INTEGER NOT NULL REFERENCES perfil_huesped (id_perfil),
fecha_envio  TIMESTAMP   NOT NULL DEFAULT CURRENT_TIMESTAMP,
estado_envio VARCHAR(10) NOT NULL CHECK (estado_envio IN ('ENVIADO','FALLIDO')),
PRIMARY KEY (id_campana, id_perfil)
);
CREATE INDEX ix_envio_campana_perfil ON envio_campana (id_perfil);
 
CREATE TABLE beneficio (
    id_beneficio  INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
codigo_beneficio  CHAR(6)      NOT NULL UNIQUE CHECK (codigo_beneficio ~ '^BEN[0-9]{3}$'),
nombre        VARCHAR(60)  NOT NULL UNIQUE,
descripcion   VARCHAR(150),
    puntos_requeridos INTEGER  NOT NULL CHECK (puntos_requeridos > 0),
activo        BOOLEAN  NOT NULL DEFAULT TRUE
);
 
CREATE TABLE regla_acumulacion (
    id_regla_acum INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
codigo_regla CHAR(6)   NOT NULL UNIQUE CHECK (codigo_regla ~ '^RAC[0-9]{3}$'),
puntos_por_noche INTEGER   NOT NULL CHECK (puntos_por_noche >= 0),
monto_base   NUMERIC(10,2) NOT NULL CHECK (monto_base > 0),
puntos_por_monto INTEGER   NOT NULL CHECK (puntos_por_monto >= 0),
fecha_inicio DATE      NOT NULL,
fecha_fin    DATE,
activa       BOOLEAN   NOT NULL DEFAULT TRUE,
CONSTRAINT ck_regla_acum_vigencia CHECK (fecha_fin IS NULL OR fecha_fin >= fecha_inicio),   -- A5
-- A5: solo una regla activa en un mismo periodo (vigencias no superpuestas)
CONSTRAINT ex_una_regla_activa EXCLUDE USING gist
    (daterange(fecha_inicio, fecha_fin, '[]') WITH &&) WHERE (activa)
);
 
CREATE TABLE puntos_fidelizacion (
    id_movimiento INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_perfil     INTEGER NOT NULL REFERENCES perfil_huesped (id_perfil),
id_estadia_origen BIGINT,                                    -- Estadía (G1)
id_beneficio  INTEGER REFERENCES beneficio (id_beneficio),
id_regla_acum INTEGER     REFERENCES regla_acumulacion (id_regla_acum),
tipo_movimiento   VARCHAR(12) NOT NULL CHECK (tipo_movimiento IN ('ACUMULACION','CANJE','REVERSION','AJUSTE')),
puntos        INTEGER NOT NULL CHECK (puntos <> 0 AND puntos BETWEEN -9999999 AND 9999999),
    fecha         TIMESTAMP   NOT NULL DEFAULT CURRENT_TIMESTAMP,
estado        VARCHAR(12) NOT NULL DEFAULT 'ACREDITADO' CHECK (estado IN ('PENDIENTE','ACREDITADO','ANULADO')),
CONSTRAINT ck_puntos_tipo_movimiento CHECK (                               -- A3
       (tipo_movimiento = 'ACUMULACION' AND id_estadia_origen IS NOT NULL AND id_regla_acum IS NOT NULL
                                        AND id_beneficio IS NULL AND puntos > 0)
        OR (tipo_movimiento = 'CANJE'       AND id_beneficio IS NOT NULL AND id_estadia_origen IS NULL AND puntos < 0)
        OR (tipo_movimiento = 'REVERSION'   AND id_estadia_origen IS NOT NULL AND id_beneficio IS NULL AND puntos < 0)
    OR (tipo_movimiento = 'AJUSTE'  AND id_beneficio IS NULL)
)
);
-- A4: una estadía origina como máximo una acumulación (y una reversión)
CREATE UNIQUE INDEX ux_acumulacion_por_estadia ON puntos_fidelizacion (id_estadia_origen)
WHERE tipo_movimiento = 'ACUMULACION';
CREATE UNIQUE INDEX ux_reversion_por_estadia ON puntos_fidelizacion (id_estadia_origen)
WHERE tipo_movimiento = 'REVERSION';
CREATE INDEX ix_puntos_perfil ON puntos_fidelizacion (id_perfil);
 
CREATE TABLE area_responsable (
    id_area     INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    codigo_area CHAR(6) NOT NULL UNIQUE CHECK (codigo_area ~ '^ARE[0-9]{3}$'),
    nombre      VARCHAR(60) NOT NULL UNIQUE,
    modulo_origen   VARCHAR(30) NOT NULL
                CHECK (modulo_origen IN ('RESERVAS','HOUSEKEEPING','MANTENIMIENTO','RESTAURANTE',
                                             'FACTURACION','ATENCION_HUESPED')),
correo_contacto VARCHAR(80) CHECK (correo_contacto ~ '^[^@[:space:]]+@[^@[:space:]]+[.][^@[:space:]]+$'),
activa      BOOLEAN NOT NULL DEFAULT TRUE
);
 
CREATE SEQUENCE seq_codigo_reclamo;   -- correlativo del código de seguimiento REC-AAAA-NNNNN
 
CREATE TABLE reclamo (
    id_reclamo     INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
codigo_seguimiento CHAR(14) NOT NULL UNIQUE CHECK (codigo_seguimiento ~ '^REC-[0-9]{4}-[0-9]{5}$'),
id_perfil      INTEGER  NOT NULL REFERENCES perfil_huesped (id_perfil),
id_estadia     BIGINT  NOT NULL,                 -- Estadía (G1)
id_area        INTEGER  REFERENCES area_responsable (id_area),
id_incidencia_g2   BIGINT      UNIQUE,                   -- Incidencia (G2), relación 1:1
tipo           VARCHAR(10)  NOT NULL CHECK (tipo IN ('RECLAMO','SUGERENCIA')),
    canal              VARCHAR(10)  NOT NULL CHECK (canal IN ('AGENTE','ASISTENTE')),
descripcion    VARCHAR(500) NOT NULL,
motivo         VARCHAR(40),
prioridad      VARCHAR(8)   NOT NULL DEFAULT 'NORMAL' CHECK (prioridad IN ('NORMAL','CRITICA')),
    sentimiento_ia VARCHAR(8)   CHECK (sentimiento_ia IN ('POSITIVO','NEUTRO','NEGATIVO')),
    confianza      NUMERIC(5,4) CHECK (confianza BETWEEN 0 AND 1),
    es_critico     BOOLEAN  NOT NULL DEFAULT FALSE,
estado         VARCHAR(12)  NOT NULL DEFAULT 'REGISTRADO'
                   CHECK (estado IN ('REGISTRADO','DERIVADO','EN_ATENCION','CERRADO')),
fecha_registro TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    fecha_limite_sla   TIMESTAMP GENERATED ALWAYS AS (fecha_registro + INTERVAL '48 hours') STORED,   -- A6
fecha_cierre   TIMESTAMP,
CONSTRAINT ck_reclamo_cierre   CHECK ((estado = 'CERRADO') = (fecha_cierre IS NOT NULL)),   -- A6
CONSTRAINT ck_reclamo_fecha_cierre CHECK (fecha_cierre IS NULL OR fecha_cierre >= fecha_registro),
CONSTRAINT ck_reclamo_analisis_ia  CHECK ((sentimiento_ia IS NULL) = (confianza IS NULL))
);
CREATE INDEX ix_reclamo_perfil ON reclamo (id_perfil);
CREATE INDEX ix_reclamo_sla ON reclamo (estado, fecha_limite_sla);
 
CREATE TABLE seguimiento_reclamo (
id_seguimiento  INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
id_reclamo  INTEGER  NOT NULL REFERENCES reclamo (id_reclamo),
estado_anterior VARCHAR(12)  CHECK (estado_anterior IN ('REGISTRADO','DERIVADO','EN_ATENCION')),
estado_nuevo VARCHAR(12)  NOT NULL CHECK (estado_nuevo IN ('REGISTRADO','DERIVADO','EN_ATENCION','CERRADO')),
fecha_hora  TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
usuario     VARCHAR(30)  NOT NULL,
observacion VARCHAR(250),
CONSTRAINT ck_seguimiento_cambio CHECK (estado_anterior IS DISTINCT FROM estado_nuevo)
);
CREATE INDEX ix_seguimiento_reclamo ON seguimiento_reclamo (id_reclamo, fecha_hora);
 
CREATE TABLE compensacion (
    id_compensacion INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
id_reclamo     INTEGER   NOT NULL UNIQUE REFERENCES reclamo (id_reclamo),   -- un reclamo, una compensación
tipo_compensacion  VARCHAR(20)   NOT NULL
                   CHECK (tipo_compensacion IN ('DESCUENTO','NOCHE_SIN_COSTO','SERVICIO_CORTESIA')),
monto          NUMERIC(10,2) NOT NULL CHECK (monto > 0),
estado         VARCHAR(15)   NOT NULL DEFAULT 'SOLICITADA'
                   CHECK (estado IN ('SOLICITADA','APROBADA','RECHAZADA','NOTIFICADA','APLICADA','FUERA_DE_PLAZO')),
motivo_rechazo VARCHAR(250),
usuario_aprobador  VARCHAR(30),
fecha_solicitud TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
fecha_resolucion   TIMESTAMP,
fecha_notificacion TIMESTAMP,
CONSTRAINT ck_compensacion_aprobacion
    CHECK (estado = 'SOLICITADA' OR (usuario_aprobador IS NOT NULL AND fecha_resolucion IS NOT NULL)),   -- A7
CONSTRAINT ck_compensacion_rechazo
    CHECK ((estado = 'RECHAZADA') = (motivo_rechazo IS NOT NULL)),                                   -- A7
CONSTRAINT ck_compensacion_notificacion
    CHECK (estado NOT IN ('NOTIFICADA','APLICADA','FUERA_DE_PLAZO') OR fecha_notificacion IS NOT NULL),
CONSTRAINT ck_compensacion_fechas
    CHECK ((fecha_resolucion IS NULL OR fecha_resolucion >= fecha_solicitud)
           AND (fecha_notificacion IS NULL OR fecha_notificacion >= fecha_resolucion))
);
 
CREATE TABLE consulta_asistente (
    id_consulta     INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
id_estadia      BIGINT,                              -- Estadía (G1), si hay una vigente
id_reclamo      INTEGER  UNIQUE REFERENCES reclamo (id_reclamo),   -- da_origen (1:1)
intencion       VARCHAR(40)  NOT NULL,
    confianza       NUMERIC(5,4) NOT NULL CHECK (confianza BETWEEN 0 AND 1),
resultado       VARCHAR(20)  NOT NULL
                    CHECK (resultado IN ('RESPONDIDA','LIMITACION_INFORMADA','RECLAMO_REGISTRADO','DERIVADA')),
derivada_agente BOOLEAN  NOT NULL DEFAULT FALSE,
tiempo_respuesta_ms INTEGER  NOT NULL CHECK (tiempo_respuesta_ms BETWEEN 0 AND 999999),
fecha_hora      TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
CONSTRAINT ck_consulta_reclamo CHECK ((resultado = 'RECLAMO_REGISTRADO') = (id_reclamo IS NOT NULL)),
CONSTRAINT ck_consulta_derivacion CHECK ((resultado = 'DERIVADA') = derivada_agente)
);
 
-- Jerarquía Opinión (t,e): Reseña y Encuesta heredan id_opinion (A8)
CREATE TABLE opinion (
    id_opinion       INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_perfil        INTEGER   NOT NULL REFERENCES perfil_huesped (id_perfil),
id_estadia       BIGINT   NOT NULL,              -- Estadía (G1)
id_area          INTEGER   REFERENCES area_responsable (id_area),
tipo_opinion     VARCHAR(8)NOT NULL CHECK (tipo_opinion IN ('RESENA','ENCUESTA')),
texto_seudonimizado  VARCHAR(1000),
sentimiento_ia   VARCHAR(8)CHECK (sentimiento_ia IN ('POSITIVO','NEUTRO','NEGATIVO')),
confianza        NUMERIC(5,4)  CHECK (confianza BETWEEN 0 AND 1),
motivo           VARCHAR(40),
es_critica       BOOLEAN   NOT NULL DEFAULT FALSE,
estado_clasificacion VARCHAR(12)   NOT NULL DEFAULT 'PENDIENTE'
                     CHECK (estado_clasificacion IN ('PENDIENTE','CLASIFICADA','EN_REVISION')),
fecha_recepcion  TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
UNIQUE (id_opinion, tipo_opinion),                                         -- apoyo a la jerarquía
CONSTRAINT ck_opinion_derivacion   CHECK (id_area IS NULL OR sentimiento_ia = 'NEGATIVO'),   -- A9
    CONSTRAINT ck_opinion_critica      CHECK (NOT es_critica OR sentimiento_ia = 'NEGATIVO'), -- A9
    CONSTRAINT ck_opinion_texto        CHECK (texto_seudonimizado IS NOT NULL OR sentimiento_ia IS NULL),   -- sin comentario no hay análisis
    CONSTRAINT ck_opinion_analisis_ia  CHECK ((sentimiento_ia IS NULL) = (confianza IS NULL))
);
CREATE INDEX ix_opinion_perfil ON opinion (id_perfil);
CREATE INDEX ix_opinion_clasificacion ON opinion (estado_clasificacion);
 
