CREATE OR REPLACE FUNCTION seguridad.tiene_permiso(
  p_auth_user_id UUID,
  p_codigo_permiso VARCHAR
)
RETURNS BOOLEAN
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = pg_catalog, seguridad, pg_temp
AS $funcion$
  SELECT EXISTS (
    SELECT 1
    FROM seguridad.usuario_sistema u
    JOIN seguridad.usuario_rol ur ON ur.id_usuario = u.id_usuario
    JOIN seguridad.rol r ON r.id_rol = ur.id_rol
    JOIN seguridad.rol_permiso rp ON rp.id_rol = r.id_rol
    JOIN seguridad.permiso p ON p.id_permiso = rp.id_permiso
    WHERE u.auth_user_id = p_auth_user_id
      AND u.estado = 'ACTIVO'
      AND ur.activo
      AND ur.vigente_desde <= CURRENT_TIMESTAMP
      AND (ur.vigente_hasta IS NULL OR ur.vigente_hasta >= CURRENT_TIMESTAMP)
      AND r.activo
      AND p.activo
      AND p.codigo = p_codigo_permiso
  )
$funcion$;

CREATE OR REPLACE FUNCTION seguridad.contexto_usuario(p_auth_user_id UUID)
RETURNS JSONB
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = pg_catalog, seguridad, pg_temp
AS $funcion$
  SELECT jsonb_build_object(
    'idUsuario', u.id_usuario,
    'authUserId', u.auth_user_id,
    'codigo', u.codigo_usuario,
    'nombres', u.nombres,
    'apellidos', u.apellidos,
    'departamento', u.codigo_departamento,
    'estado', u.estado,
    'idPersonalG2', u.id_personal_g2,
    'idUsuarioG4', u.id_usuario_g4,
    'roles', COALESCE((
      SELECT jsonb_agg(DISTINCT r.codigo ORDER BY r.codigo)
      FROM seguridad.usuario_rol ur
      JOIN seguridad.rol r ON r.id_rol = ur.id_rol
      WHERE ur.id_usuario = u.id_usuario AND ur.activo AND r.activo
        AND ur.vigente_desde <= CURRENT_TIMESTAMP
        AND (ur.vigente_hasta IS NULL OR ur.vigente_hasta >= CURRENT_TIMESTAMP)
    ), '[]'::jsonb),
    'permisos', COALESCE((
      SELECT jsonb_agg(DISTINCT p.codigo ORDER BY p.codigo)
      FROM seguridad.usuario_rol ur
      JOIN seguridad.rol r ON r.id_rol = ur.id_rol
      JOIN seguridad.rol_permiso rp ON rp.id_rol = r.id_rol
      JOIN seguridad.permiso p ON p.id_permiso = rp.id_permiso
      WHERE ur.id_usuario = u.id_usuario AND ur.activo AND r.activo AND p.activo
        AND ur.vigente_desde <= CURRENT_TIMESTAMP
        AND (ur.vigente_hasta IS NULL OR ur.vigente_hasta >= CURRENT_TIMESTAMP)
    ), '[]'::jsonb)
  )
