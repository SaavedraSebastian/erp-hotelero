-- SECCIÓN 3. Reglas de negocio con funciones y triggers (A2, A8, A10-A14)
 
-- Usuario de la aplicación que hace el cambio (el backend ejecuta SET LOCAL app.usuario = '...')
CREATE FUNCTION fn_usuario_app() RETURNS VARCHAR LANGUAGE sql STABLE AS $$
    SELECT COALESCE(NULLIF(current_setting('app.usuario', true), ''), CURRENT_USER::text)::varchar(30)
$$;
 
-- Auditoría de cambios en las tablas principales (escribe con los permisos del dueño)
CREATE FUNCTION fn_auditar() RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER
SET search_path = g5_crm, pg_temp AS $$
DECLARE
v_id text;
BEGIN
IF TG_OP = 'DELETE' THEN
        v_id := to_jsonb(OLD) ->> TG_ARGV[0];
ELSE
        v_id := to_jsonb(NEW) ->> TG_ARGV[0];
END IF;
INSERT INTO log_auditoria (usuario_bd, usuario_app, operacion, tabla, id_registro, datos_anteriores, datos_nuevos)
VALUES (session_user, fn_usuario_app(), TG_OP, TG_TABLE_NAME, v_id,
            CASE WHEN TG_OP <> 'INSERT' THEN to_jsonb(OLD) END,
            CASE WHEN TG_OP <> 'DELETE' THEN to_jsonb(NEW) END);
RETURN NULL;
END $$;
 
-- Registro de consultas a datos sensibles (por ejemplo, la ficha unificada, CU-CA-05)
CREATE FUNCTION registrar_consulta_sensible(p_tabla VARCHAR, p_id_registro VARCHAR)
RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = g5_crm, pg_temp AS $$
BEGIN
    INSERT INTO log_auditoria (usuario_bd, usuario_app, operacion, tabla, id_registro)
    VALUES (session_user, fn_usuario_app(), 'CONSULTA', p_tabla, p_id_registro);
END $$;
REVOKE ALL ON FUNCTION registrar_consulta_sensible(VARCHAR, VARCHAR) FROM PUBLIC;
 
-- Historial inmutable: el log y el seguimiento de reclamos no admiten UPDATE ni DELETE
CREATE FUNCTION fn_registro_inmutable() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
RAISE EXCEPTION '% es un historial inmutable: no admite UPDATE ni DELETE', TG_TABLE_NAME;
END $$;
 
-- A13: un segmento con campañas programadas o activas no puede deshabilitarse
CREATE FUNCTION fn_segmento_validar() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
IF OLD.activo AND NOT NEW.activo AND EXISTS (
        SELECT 1 FROM campana WHERE id_segmento = NEW.id_segmento AND estado IN ('PROGRAMADA','ACTIVA')) THEN
    RAISE EXCEPTION 'A13: el segmento % tiene campañas programadas o activas', NEW.codigo_segmento;
END IF;
    RETURN NEW;
END $$;
 
-- A12 y A13: alta y cambios de una campaña
CREATE FUNCTION fn_campana_validar() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
IF TG_OP = 'INSERT' THEN
    IF NEW.estado <> 'PROGRAMADA' THEN
        RAISE EXCEPTION 'A12: una campaña se registra en estado PROGRAMADA';
    END IF;
        IF NOT (SELECT activo FROM segmento WHERE id_segmento = NEW.id_segmento) THEN
            RAISE EXCEPTION 'A13: el segmento destinatario está deshabilitado';
    END IF;
        RETURN NEW;
END IF;
IF OLD.estado <> 'PROGRAMADA' AND
   (NEW.id_segmento, NEW.nombre, NEW.canal, NEW.mensaje, NEW.fecha_inicio, NEW.fecha_fin, NEW.codigo_campana)
   IS DISTINCT FROM
   (OLD.id_segmento, OLD.nombre, OLD.canal, OLD.mensaje, OLD.fecha_inicio, OLD.fecha_fin, OLD.codigo_campana) THEN
    RAISE EXCEPTION 'A12: solo una campaña PROGRAMADA puede modificarse (estado actual: %)', OLD.estado;
END IF;
IF NEW.estado <> OLD.estado AND NOT (
           (OLD.estado = 'PROGRAMADA' AND NEW.estado IN ('ACTIVA','CANCELADA'))
    OR (OLD.estado = 'ACTIVA' AND NEW.estado IN ('CERRADA','CANCELADA'))) THEN
    RAISE EXCEPTION 'Transición de campaña no permitida: % -> %', OLD.estado, NEW.estado;
END IF;
    RETURN NEW;
END $$;
 
-- A10 y A12: los envíos solo se registran para campañas activas y perfiles del segmento destinatario
CREATE FUNCTION fn_envio_validar() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE
    v_campana campana%ROWTYPE;
BEGIN
    SELECT * INTO v_campana FROM campana WHERE id_campana = NEW.id_campana;
IF v_campana.estado <> 'ACTIVA' THEN
    RAISE EXCEPTION 'A12: la campaña % no está activa (estado %)', v_campana.codigo_campana, v_campana.estado;
END IF;
IF NOT EXISTS (SELECT 1 FROM perfil_huesped
                   WHERE id_perfil = NEW.id_perfil AND id_segmento = v_campana.id_segmento) THEN
    RAISE EXCEPTION 'A10: el perfil % no pertenece al segmento destinatario', NEW.id_perfil;
END IF;
    RETURN NEW;
END $$;
 
-- A2, A3 y A14: validación de los movimientos de puntos
CREATE FUNCTION fn_puntos_validar() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE
v_saldo     INTEGER;
v_requerido INTEGER;
v_activo BOOLEAN;
BEGIN
IF NEW.tipo_movimiento = 'CANJE' THEN
    SELECT puntos_requeridos, activo INTO v_requerido, v_activo FROM beneficio WHERE id_beneficio = NEW.id_beneficio;
    IF NOT v_activo THEN
            RAISE EXCEPTION 'A14: el beneficio está deshabilitado';
        END IF;
    IF NEW.puntos <> -v_requerido THEN
        RAISE EXCEPTION 'El canje debe descontar los % puntos requeridos por el beneficio', v_requerido;
    END IF;
ELSIF NEW.tipo_movimiento = 'ACUMULACION' AND NEW.id_regla_acum IS NOT NULL THEN   -- sin regla, lo rechaza A3
    IF NOT EXISTS (SELECT 1 FROM regla_acumulacion WHERE id_regla_acum = NEW.id_regla_acum AND activa) THEN
            RAISE EXCEPTION 'A14: la regla de acumulación está deshabilitada';
    END IF;
END IF;
IF NEW.puntos < 0 AND NEW.estado = 'ACREDITADO' THEN
        PERFORM 1 FROM perfil_huesped WHERE id_perfil = NEW.id_perfil FOR UPDATE;   -- serializa los canjes del perfil
        SELECT COALESCE(SUM(puntos), 0) INTO v_saldo
          FROM puntos_fidelizacion WHERE id_perfil = NEW.id_perfil AND estado = 'ACREDITADO';
    IF v_saldo + NEW.puntos < 0 THEN
            RAISE EXCEPTION 'A2: saldo insuficiente (saldo %, movimiento %)', v_saldo, NEW.puntos;
    END IF;
END IF;
    RETURN NEW;
END $$;
 
-- A6 y A14: código de seguimiento, área activa y avance del estado del reclamo
CREATE FUNCTION fn_reclamo_validar() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE
v_orden_ant INTEGER;
v_orden_nvo INTEGER;
BEGIN
IF TG_OP = 'INSERT' AND NEW.codigo_seguimiento IS NULL THEN
    NEW.codigo_seguimiento := 'REC-' || to_char(NEW.fecha_registro, 'YYYY') || '-'
                              || lpad(nextval('seq_codigo_reclamo')::text, 5, '0');
END IF;
IF NEW.id_area IS NOT NULL AND (TG_OP = 'INSERT' OR NEW.id_area IS DISTINCT FROM OLD.id_area) AND
       NOT (SELECT activa FROM area_responsable WHERE id_area = NEW.id_area) THEN
    RAISE EXCEPTION 'A14: el área responsable está deshabilitada';
END IF;
IF TG_OP = 'UPDATE' AND NEW.estado <> OLD.estado THEN
    v_orden_ant := array_position(ARRAY['REGISTRADO','DERIVADO','EN_ATENCION','CERRADO'], OLD.estado::text);
    v_orden_nvo := array_position(ARRAY['REGISTRADO','DERIVADO','EN_ATENCION','CERRADO'], NEW.estado::text);
    IF v_orden_nvo < v_orden_ant THEN
            RAISE EXCEPTION 'El reclamo no puede volver de % a %', OLD.estado, NEW.estado;
    END IF;
END IF;
    RETURN NEW;
END $$;
 
-- RF-CA-10: cada cambio de estado del reclamo queda en su seguimiento
CREATE FUNCTION fn_reclamo_seguimiento() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
IF TG_OP = 'INSERT' THEN
    INSERT INTO seguimiento_reclamo (id_reclamo, estado_anterior, estado_nuevo, usuario, observacion)
    VALUES (NEW.id_reclamo, NULL, NEW.estado, fn_usuario_app(), 'Registro inicial');
ELSIF NEW.estado <> OLD.estado THEN
    INSERT INTO seguimiento_reclamo (id_reclamo, estado_anterior, estado_nuevo, usuario)
    VALUES (NEW.id_reclamo, OLD.estado, NEW.estado, fn_usuario_app());
END IF;
    RETURN NULL;
END $$;
 
-- RF-CA-12 y A7: solo los reclamos (no las sugerencias) admiten compensación; ciclo de estados
CREATE FUNCTION fn_compensacion_validar() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
IF TG_OP = 'INSERT' THEN
    IF NEW.estado <> 'SOLICITADA' THEN
        RAISE EXCEPTION 'Una compensación se registra en estado SOLICITADA';
    END IF;
        IF (SELECT tipo FROM reclamo WHERE id_reclamo = NEW.id_reclamo) <> 'RECLAMO' THEN
            RAISE EXCEPTION 'Solo un reclamo (no una sugerencia) admite compensación';
    END IF;
ELSIF NEW.estado <> OLD.estado AND NOT (
           (OLD.estado = 'SOLICITADA' AND NEW.estado IN ('APROBADA','RECHAZADA'))
    OR (OLD.estado = 'APROBADA'   AND NEW.estado = 'NOTIFICADA')
    OR (OLD.estado = 'NOTIFICADA' AND NEW.estado IN ('APLICADA','FUERA_DE_PLAZO'))) THEN
    RAISE EXCEPTION 'Transición de compensación no permitida: % -> %', OLD.estado, NEW.estado;
END IF;
    RETURN NEW;
END $$;
 
-- A14: una opinión negativa solo se deriva a un área activa
CREATE FUNCTION fn_opinion_validar() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
IF NEW.id_area IS NOT NULL AND (TG_OP = 'INSERT' OR NEW.id_area IS DISTINCT FROM OLD.id_area) AND
       NOT (SELECT activa FROM area_responsable WHERE id_area = NEW.id_area) THEN
    RAISE EXCEPTION 'A14: el área responsable está deshabilitada';
END IF;
    RETURN NEW;
END $$;
 
-- A8: jerarquía total; al confirmar la transacción toda opinión debe tener su subtipo
CREATE FUNCTION fn_opinion_con_subtipo() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
IF (NEW.tipo_opinion = 'RESENA'   AND NOT EXISTS (SELECT 1 FROM resena   WHERE id_opinion = NEW.id_opinion))
OR (NEW.tipo_opinion = 'ENCUESTA' AND NOT EXISTS (SELECT 1 FROM encuesta WHERE id_opinion = NEW.id_opinion)) THEN
    RAISE EXCEPTION 'A8: la opinión % no tiene registrado su subtipo %', NEW.id_opinion, NEW.tipo_opinion;
END IF;
    RETURN NULL;
END $$;
 
