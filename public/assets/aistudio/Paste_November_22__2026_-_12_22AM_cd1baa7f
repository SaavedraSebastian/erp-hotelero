CREATE OR REPLACE FUNCTION g5_crm.fn_solicitud_huesped_validar()
RETURNS trigger
LANGUAGE plpgsql
SET search_path = pg_catalog, g5_crm, pg_temp
AS $funcion$
DECLARE
    v_area VARCHAR(30);
BEGIN
    v_area := CASE NEW.area_destino
        WHEN 'RECEPCION' THEN 'RESERVAS'
        WHEN 'HOUSEKEEPING' THEN 'HOUSEKEEPING'
        WHEN 'MANTENIMIENTO' THEN 'MANTENIMIENTO'
    END;

    IF NEW.id_area IS NULL THEN
        SELECT a.id_area INTO NEW.id_area
          FROM g5_crm.area_responsable a
         WHERE a.modulo_origen = v_area AND a.activa
         ORDER BY a.id_area
         LIMIT 1;
    ELSIF NOT EXISTS (
        SELECT 1 FROM g5_crm.area_responsable a
         WHERE a.id_area = NEW.id_area
           AND a.modulo_origen = v_area
           AND a.activa
    ) THEN
        RAISE EXCEPTION 'El area % no corresponde al destino % o no esta activa',
            NEW.id_area, NEW.area_destino;
    END IF;

    IF NEW.id_area IS NULL THEN
        RAISE EXCEPTION 'No existe un area activa para el destino %', NEW.area_destino;
    END IF;

    IF NEW.estado IN ('ATENDIDA','CANCELADA') THEN
        NEW.fecha_cierre := COALESCE(NEW.fecha_cierre, CURRENT_TIMESTAMP);
    ELSE
        NEW.fecha_cierre := NULL;
    END IF;

    NEW.fecha_actualizacion := CURRENT_TIMESTAMP;
    RETURN NEW;
END
$funcion$;

