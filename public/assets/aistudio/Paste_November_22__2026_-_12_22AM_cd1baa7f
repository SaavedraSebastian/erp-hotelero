CREATE TABLE IF NOT EXISTS seguridad.idempotencia_operacion (
  id_idempotencia     UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  id_usuario          UUID NOT NULL REFERENCES seguridad.usuario_sistema (id_usuario),
  clave               VARCHAR(100) NOT NULL,
  operacion           VARCHAR(120) NOT NULL,
  hash_solicitud      CHAR(64) NOT NULL CHECK (hash_solicitud ~ '^[0-9a-f]{64}$'),
  estado              VARCHAR(12) NOT NULL DEFAULT 'EN_PROCESO'
                      CHECK (estado IN ('EN_PROCESO','COMPLETADA','FALLIDA')),
  codigo_http         SMALLINT CHECK (codigo_http BETWEEN 100 AND 599),
  referencia_resultado JSONB NOT NULL DEFAULT '{}'::jsonb,
  mensaje_error       VARCHAR(500),
  fecha_creacion      TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
  fecha_finalizacion  TIMESTAMPTZ,
  fecha_expiracion    TIMESTAMPTZ NOT NULL DEFAULT (CURRENT_TIMESTAMP + INTERVAL '24 hours'),
  UNIQUE (id_usuario, clave, operacion),
  CONSTRAINT ck_idempotencia_referencia_objeto CHECK (
    jsonb_typeof(referencia_resultado) = 'object'
  ),
  CONSTRAINT ck_idempotencia_finalizacion CHECK (
    (estado = 'EN_PROCESO' AND fecha_finalizacion IS NULL)
    OR (estado IN ('COMPLETADA','FALLIDA') AND fecha_finalizacion IS NOT NULL)
  ),
  CONSTRAINT ck_idempotencia_expiracion CHECK (fecha_expiracion > fecha_creacion)
);

CREATE INDEX IF NOT EXISTS ix_idempotencia_expiracion
  ON seguridad.idempotencia_operacion (fecha_expiracion);

CREATE OR REPLACE FUNCTION seguridad.limpiar_idempotencia_expirada()
RETURNS INTEGER
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, seguridad, pg_temp
AS $funcion$
DECLARE v_eliminadas INTEGER;
BEGIN
  DELETE FROM seguridad.idempotencia_operacion
   WHERE fecha_expiracion < CURRENT_TIMESTAMP
     AND estado <> 'EN_PROCESO';
  GET DIAGNOSTICS v_eliminadas = ROW_COUNT;
  RETURN v_eliminadas;
END
$funcion$;

