-- Concesiones operativas para los cinco roles de G3.
-- g3_owner es propietario; g3_dba hereda g3_owner por la membresía de la fuente.
-- g3_app escribe; g3_integracion opera intercambios; g3_lectura solo consulta.
GRANT SELECT,INSERT,UPDATE ON ALL TABLES IN SCHEMA g3_servicios TO g3_app;
GRANT SELECT ON ALL TABLES IN SCHEMA g3_servicios TO g3_lectura;
REVOKE UPDATE ON historial_precio_item,registro_intento_acceso FROM g3_app;
REVOKE UPDATE ON movimiento_inventario FROM g3_app;
GRANT UPDATE (estado_anulacion) ON movimiento_inventario TO g3_app;
GRANT SELECT,INSERT,UPDATE ON estadia_externa,cuenta_cobro,paquete,
 envio_externo,solicitud_reposicion TO g3_integracion;
GRANT SELECT ON articulo_almacen,lote_articulo,movimiento_inventario TO g3_integracion;
GRANT INSERT ON movimiento_inventario TO g3_integracion;
GRANT UPDATE (estado_anulacion) ON movimiento_inventario TO g3_integracion;
REVOKE ALL ON ALL TABLES IN SCHEMA g3_servicios FROM PUBLIC;
REVOKE ALL ON ALL SEQUENCES IN SCHEMA g3_servicios FROM PUBLIC;
REVOKE EXECUTE ON ALL FUNCTIONS IN SCHEMA g3_servicios FROM PUBLIC;
-- Los triggers siguen ejecutándose por sus eventos; no se publican como API SQL.
-- No se concede DELETE ni TRUNCATE a los roles de aplicación o integración.

RESET ROLE;


