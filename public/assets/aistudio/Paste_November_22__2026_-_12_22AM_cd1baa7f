-- ============================================================================
-- MIGRACION 05: identidad transversal, RBAC y rol tecnico del backend
-- PostgreSQL 13+ / Supabase
-- No almacena contrasenas: la autenticacion pertenece a Supabase Auth.
-- ============================================================================

BEGIN;
SET LOCAL TIME ZONE 'America/Lima';
SELECT pg_advisory_xact_lock(hashtext('sgh_erp_seguridad_rbac_v1'));

DO $precondiciones$
DECLARE v_schema text;
BEGIN
  FOREACH v_schema IN ARRAY ARRAY[
    'g1_reservas','g2_housekeeping','g3_servicios','g4_finanzas','g5_crm'
  ] LOOP
    IF NOT EXISTS (SELECT 1 FROM pg_namespace WHERE nspname = v_schema) THEN
      RAISE EXCEPTION 'Falta el esquema requerido: %', v_schema;
    END IF;
  END LOOP;
END
$precondiciones$;

-- Roles tecnicos NOLOGIN. La cuenta indicada en DATABASE_URL debe recibir
-- sgh_erp_backend como membresia fuera de esta migracion.
DO $roles_tecnicos$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'sgh_erp_backend') THEN
    CREATE ROLE sgh_erp_backend NOLOGIN INHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION;
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'rol_g4_finanzas') THEN
    CREATE ROLE rol_g4_finanzas NOLOGIN INHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION;
  END IF;
END
$roles_tecnicos$;

DO $conexion_backend$
BEGIN
  EXECUTE format('GRANT CONNECT ON DATABASE %I TO sgh_erp_backend', current_database());
END
$conexion_backend$;

-- G4 no tenia un rol operativo equivalente al de los otros modulos.
GRANT USAGE ON SCHEMA g4_finanzas TO rol_g4_finanzas;
GRANT SELECT, INSERT, UPDATE ON ALL TABLES IN SCHEMA g4_finanzas TO rol_g4_finanzas;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA g4_finanzas TO rol_g4_finanzas;
REVOKE DELETE, TRUNCATE ON ALL TABLES IN SCHEMA g4_finanzas FROM rol_g4_finanzas;

-- El rol transversal hereda solo roles de aplicacion, nunca propietarios/DBA.
DO $membresias$
DECLARE v_role text;
BEGIN
  FOREACH v_role IN ARRAY ARRAY[
    'rol_g1_reservas','rol_g2_backend','g3_app','rol_g4_finanzas','g5_crm_app'
  ] LOOP
    IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = v_role) THEN
      EXECUTE format('GRANT %I TO sgh_erp_backend', v_role);
    ELSE
      RAISE NOTICE 'Rol funcional no encontrado; revisar antes del despliegue: %', v_role;
    END IF;
  END LOOP;
END
$membresias$;

