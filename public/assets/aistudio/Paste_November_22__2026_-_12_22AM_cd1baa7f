-- Avance 6 - G4 Facturacion y Finanzas: SQL del modelo relacional (MR)
-- Motor objetivo: PostgreSQL 13 o superior (sintaxis SQL ISO/IEC 9075)

CREATE TABLE usuario (
    id_usuario     INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre_usuario VARCHAR(50)  NOT NULL UNIQUE,
    nombres        VARCHAR(100) NOT NULL,
    apellidos      VARCHAR(100) NOT NULL,
    correo         VARCHAR(120) NOT NULL UNIQUE,
    rol            VARCHAR(20)  NOT NULL
                   CHECK (rol IN ('RECEPCIONISTA','CAJERO','ADMINISTRADOR','JEFE_FINANZAS',
                                  'GERENTE_FINANCIERO','GERENTE_GENERAL','RESP_COSTOS')),
    estado         BOOLEAN      NOT NULL DEFAULT TRUE
);

CREATE TABLE centro_costo (
    id_centro_costo INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre          VARCHAR(80)   NOT NULL UNIQUE,
    presupuesto     NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (presupuesto >= 0),
    estado          BOOLEAN       NOT NULL DEFAULT TRUE
);

CREATE TABLE cuenta (
    id_cuenta       VARCHAR(36)   PRIMARY KEY DEFAULT gen_random_uuid()::text,
    id_huesped      BIGINT       NOT NULL,
    id_reserva      BIGINT,
    id_habitacion   BIGINT,
    saldo_pendiente NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (saldo_pendiente >= 0),
    estado          VARCHAR(10)   NOT NULL DEFAULT 'ACTIVA' CHECK (estado IN ('ACTIVA','CERRADA')),
    fecha_apertura  TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP,
    fecha_cierre    TIMESTAMP,
    CHECK ((estado = 'CERRADA') = (fecha_cierre IS NOT NULL))
);
CREATE UNIQUE INDEX ux_cuenta_reserva ON cuenta (id_reserva) WHERE id_reserva IS NOT NULL;
CREATE INDEX ix_cuenta_huesped ON cuenta (id_huesped);

CREATE TABLE consumo (
    id_consumo            VARCHAR(36)   PRIMARY KEY DEFAULT gen_random_uuid()::text,
    id_cuenta             VARCHAR(36)   NOT NULL REFERENCES cuenta (id_cuenta),
    id_usuario            INTEGER       NOT NULL REFERENCES usuario (id_usuario),
    id_centro_costo       INTEGER       REFERENCES centro_costo (id_centro_costo),
    numero_consumo_origen VARCHAR(30)   UNIQUE,
    concepto              VARCHAR(150)  NOT NULL,
    importe               NUMERIC(12,2) NOT NULL CHECK (importe > 0),
    fecha                 DATE          NOT NULL DEFAULT CURRENT_DATE,
    area                  VARCHAR(50)   NOT NULL,
    estado                VARCHAR(10)   NOT NULL DEFAULT 'VIGENTE'
                          CHECK (estado IN ('VIGENTE','FACTURADO','ANULADO'))
);
CREATE INDEX ix_consumo_cuenta ON consumo (id_cuenta);

CREATE TABLE transferencia_consumo (
    id_transferencia  VARCHAR(36)  PRIMARY KEY DEFAULT gen_random_uuid()::text,
    id_cuenta_origen  VARCHAR(36)  NOT NULL REFERENCES cuenta (id_cuenta),
    id_cuenta_destino VARCHAR(36)  NOT NULL REFERENCES cuenta (id_cuenta),
    id_usuario        INTEGER      NOT NULL REFERENCES usuario (id_usuario),
    motivo            VARCHAR(250) NOT NULL,
    fecha_hora        TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CHECK (id_cuenta_origen <> id_cuenta_destino)
);

CREATE TABLE detalle_transferencia (
    id_detalle_transferencia VARCHAR(36)   PRIMARY KEY DEFAULT gen_random_uuid()::text,
    id_transferencia         VARCHAR(36)   NOT NULL REFERENCES transferencia_consumo (id_transferencia),
    id_consumo               VARCHAR(36)   NOT NULL REFERENCES consumo (id_consumo),
    importe                  NUMERIC(12,2) NOT NULL CHECK (importe > 0),
    UNIQUE (id_transferencia, id_consumo)
);

CREATE TABLE turno_caja (
    id_turno_caja            VARCHAR(36)   PRIMARY KEY DEFAULT gen_random_uuid()::text,
    id_usuario               INTEGER       NOT NULL REFERENCES usuario (id_usuario),
    id_usuario_autoriza      INTEGER       REFERENCES usuario (id_usuario),
    turno                    VARCHAR(10)   NOT NULL CHECK (turno IN ('MANANA','TARDE','NOCHE')),
    saldo_inicial            NUMERIC(12,2) NOT NULL CHECK (saldo_inicial >= 0),
    saldo_esperado           NUMERIC(12,2),
    saldo_final              NUMERIC(12,2),
    diferencia               NUMERIC(12,2) GENERATED ALWAYS AS (saldo_final - saldo_esperado) STORED,
    justificacion_diferencia VARCHAR(250),
    motivo_excepcion         VARCHAR(250),
    fecha_apertura           TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP,
    fecha_cierre             TIMESTAMP,
    estado                   VARCHAR(10)   NOT NULL DEFAULT 'ABIERTA' CHECK (estado IN ('ABIERTA','CERRADA')),
    CHECK ((estado = 'CERRADA') = (fecha_cierre IS NOT NULL)),
    CHECK (fecha_cierre IS NULL OR fecha_cierre >= fecha_apertura),
    CHECK (diferencia IS NULL OR diferencia = 0 OR justificacion_diferencia IS NOT NULL),
    CHECK (id_usuario_autoriza IS NULL OR motivo_excepcion IS NOT NULL)
);
CREATE UNIQUE INDEX ux_turno_caja_abierto ON turno_caja (id_usuario, turno) WHERE estado = 'ABIERTA';

CREATE TABLE movimiento_caja (
    id_movimiento_caja VARCHAR(36)   PRIMARY KEY DEFAULT gen_random_uuid()::text,
    id_turno_caja      VARCHAR(36)   NOT NULL REFERENCES turno_caja (id_turno_caja),
    id_usuario         INTEGER       NOT NULL REFERENCES usuario (id_usuario),
    tipo               VARCHAR(7)    NOT NULL CHECK (tipo IN ('INGRESO','EGRESO')),
    importe            NUMERIC(12,2) NOT NULL CHECK (importe > 0),
    motivo             VARCHAR(250)  NOT NULL,
    fecha_hora         TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX ix_movimiento_caja_turno ON movimiento_caja (id_turno_caja);

CREATE TABLE comprobante (
    id_comprobante           VARCHAR(36)   PRIMARY KEY DEFAULT gen_random_uuid()::text,
    id_cuenta                VARCHAR(36)   NOT NULL REFERENCES cuenta (id_cuenta),
    id_usuario               INTEGER       NOT NULL REFERENCES usuario (id_usuario),
    id_comprobante_ref       VARCHAR(36)   REFERENCES comprobante (id_comprobante),
    tipo                     VARCHAR(12)   NOT NULL CHECK (tipo IN ('BOLETA','FACTURA','NOTA_CREDITO')),
    serie                    VARCHAR(4)    NOT NULL,
    correlativo              INTEGER       NOT NULL CHECK (correlativo > 0),
    tipo_documento_cliente   VARCHAR(3)    NOT NULL CHECK (tipo_documento_cliente IN ('DNI','RUC','CE','PAS')),
    numero_documento_cliente VARCHAR(20)   NOT NULL,
    razon_social_cliente     VARCHAR(200)  NOT NULL,
    direccion_cliente        VARCHAR(250),
    operacion_gravada        NUMERIC(12,2) NOT NULL CHECK (operacion_gravada >= 0),
    igv                      NUMERIC(12,2) NOT NULL CHECK (igv >= 0),
    total                    NUMERIC(12,2) NOT NULL,
    estado                   VARCHAR(10)   NOT NULL DEFAULT 'BORRADOR'
                             CHECK (estado IN ('BORRADOR','FIRMADO','ENVIADO','ACEPTADO','RECHAZADO','ANULADO')),
    mensaje_rechazo          VARCHAR(250),
    motivo_nota              VARCHAR(250),
    fecha_emision            TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (tipo, serie, correlativo),
    CHECK (total = operacion_gravada + igv),
    CHECK ((tipo = 'NOTA_CREDITO') = (id_comprobante_ref IS NOT NULL)),
    CHECK (tipo <> 'NOTA_CREDITO' OR motivo_nota IS NOT NULL),
    CHECK (tipo <> 'FACTURA' OR tipo_documento_cliente = 'RUC')
);
CREATE INDEX ix_comprobante_cuenta ON comprobante (id_cuenta);

CREATE TABLE cobro (
    id_cobro       VARCHAR(36)   PRIMARY KEY DEFAULT gen_random_uuid()::text,
    id_cuenta      VARCHAR(36)   NOT NULL REFERENCES cuenta (id_cuenta),
    id_turno_caja  VARCHAR(36)   NOT NULL REFERENCES turno_caja (id_turno_caja),
    id_usuario     INTEGER       NOT NULL REFERENCES usuario (id_usuario),
    id_comprobante VARCHAR(36)   REFERENCES comprobante (id_comprobante),
    monto          NUMERIC(12,2) NOT NULL CHECK (monto > 0),
    medio_pago     VARCHAR(20)   NOT NULL
                   CHECK (medio_pago IN ('EFECTIVO','TARJETA','TRANSFERENCIA','BILLETERA_DIGITAL')),
    fecha_hora     TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP,
    estado         VARCHAR(10)   NOT NULL DEFAULT 'REGISTRADO' CHECK (estado IN ('REGISTRADO','ANULADO'))
);
CREATE INDEX ix_cobro_cuenta ON cobro (id_cuenta);
CREATE INDEX ix_cobro_turno ON cobro (id_turno_caja);

CREATE TABLE gasto (
    id_gasto             VARCHAR(36)   PRIMARY KEY DEFAULT gen_random_uuid()::text,
    id_usuario           INTEGER       NOT NULL REFERENCES usuario (id_usuario),
    id_usuario_aprobador INTEGER       REFERENCES usuario (id_usuario),
    id_centro_costo      INTEGER       NOT NULL REFERENCES centro_costo (id_centro_costo),
    categoria            VARCHAR(60)   NOT NULL,
    proveedor            VARCHAR(120)  NOT NULL,
    concepto             VARCHAR(250)  NOT NULL,
    monto                NUMERIC(12,2) NOT NULL CHECK (monto > 0),
    fecha                DATE          NOT NULL DEFAULT CURRENT_DATE,
    comprobante_sustento VARCHAR(250)  NOT NULL,
    estado               VARCHAR(10)   NOT NULL DEFAULT 'PENDIENTE'
                         CHECK (estado IN ('PENDIENTE','APROBADO','RECHAZADO')),
    fecha_aprobacion     TIMESTAMP,
    CHECK (estado = 'PENDIENTE' OR (id_usuario_aprobador IS NOT NULL AND fecha_aprobacion IS NOT NULL))
);

CREATE TABLE alerta_financiera (
    id_alerta          VARCHAR(36)   PRIMARY KEY DEFAULT gen_random_uuid()::text,
    id_usuario         INTEGER       NOT NULL REFERENCES usuario (id_usuario),
    id_usuario_revisor INTEGER       REFERENCES usuario (id_usuario),
    id_cuenta          VARCHAR(36)   REFERENCES cuenta (id_cuenta),
    id_cobro           VARCHAR(36)   UNIQUE REFERENCES cobro (id_cobro),
    id_turno_caja      VARCHAR(36)   REFERENCES turno_caja (id_turno_caja),
    tipo_operacion     VARCHAR(30)   NOT NULL,
    monto              NUMERIC(12,2) NOT NULL,
    puntaje_anomalia   NUMERIC(5,4)  NOT NULL CHECK (puntaje_anomalia BETWEEN 0 AND 1),
    severidad          VARCHAR(5)    NOT NULL CHECK (severidad IN ('BAJA','MEDIA','ALTA')),
    clasificacion      VARCHAR(15)   NOT NULL DEFAULT 'PENDIENTE'
                       CHECK (clasificacion IN ('PENDIENTE','CONFIRMADA','JUSTIFICADA','FALSO_POSITIVO')),
    justificacion      VARCHAR(250),
    fecha_hora         TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP,
    fecha_revision     TIMESTAMP,
    CHECK (clasificacion = 'PENDIENTE' OR (id_usuario_revisor IS NOT NULL AND fecha_revision IS NOT NULL))
);
CREATE INDEX ix_alerta_pendiente ON alerta_financiera (clasificacion, severidad);

CREATE TABLE proyeccion_financiera (
    id_proyeccion       VARCHAR(36)    PRIMARY KEY DEFAULT gen_random_uuid()::text,
    id_usuario          INTEGER        NOT NULL REFERENCES usuario (id_usuario),
    id_proyeccion_base  VARCHAR(36)    REFERENCES proyeccion_financiera (id_proyeccion),
    periodo             SMALLINT       NOT NULL CHECK (periodo IN (7,30,90)),
