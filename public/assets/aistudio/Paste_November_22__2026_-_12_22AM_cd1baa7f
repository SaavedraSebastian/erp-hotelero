-- Todo cambio de precio se persiste con motivo. El backend fija app.motivo_cambio_precio
-- dentro de la misma transacción antes de actualizar item_catalogo.
CREATE FUNCTION fn_registrar_cambio_precio() RETURNS trigger LANGUAGE plpgsql AS $g3_func$
DECLARE m text := NULLIF(current_setting('app.motivo_cambio_precio', true), '');
BEGIN
 IF NEW.precio_vigente IS DISTINCT FROM OLD.precio_vigente THEN
   IF m IS NULL THEN
     RAISE EXCEPTION 'El cambio de precio requiere app.motivo_cambio_precio' USING ERRCODE = '23514';
   END IF;
   INSERT INTO historial_precio_item (id_historial_precio,id_item_catalogo,precio_anterior,precio_nuevo,vigente_desde,motivo)
   VALUES (md5(NEW.id_item_catalogo || clock_timestamp()::text || random()::text),NEW.id_item_catalogo,OLD.precio_vigente,NEW.precio_vigente,CURRENT_TIMESTAMP,m);
 END IF;
 RETURN NEW;
END ;
$g3_func$;
CREATE TRIGGER tg_item_catalogo_historial_precio AFTER UPDATE OF precio_vigente ON item_catalogo
 FOR EACH ROW EXECUTE FUNCTION fn_registrar_cambio_precio();

-- Máquinas de estado operativas. La interfaz no puede saltar etapas aunque envíe un UPDATE directo.
CREATE FUNCTION fn_validar_transicion_operativa() RETURNS trigger LANGUAGE plpgsql AS $g3_func$
BEGIN
 IF NEW.estado = OLD.estado THEN RETURN NEW; END IF;
 IF TG_TABLE_NAME = 'consumo' AND NOT (
      (OLD.estado = 'por confirmar' AND NEW.estado IN ('confirmado','descartado')) OR
      (OLD.estado = 'confirmado' AND NEW.estado = 'anulado')) THEN
   RAISE EXCEPTION 'Transición de consumo no permitida: % -> %', OLD.estado, NEW.estado USING ERRCODE = '23514';
 ELSIF TG_TABLE_NAME = 'comanda' AND NOT (
      (OLD.estado = 'pendiente' AND NEW.estado IN ('en preparación','cancelada')) OR
      (OLD.estado = 'en preparación' AND NEW.estado = 'lista') OR
      (OLD.estado = 'lista' AND NEW.estado = 'entregada')) THEN
   RAISE EXCEPTION 'Transición de comanda no permitida: % -> %', OLD.estado, NEW.estado USING ERRCODE = '23514';
 ELSIF TG_TABLE_NAME = 'solicitud_servicio' AND NOT (
      (OLD.estado = 'solicitada' AND NEW.estado IN ('en atención','completada','cancelada')) OR
      (OLD.estado = 'en atención' AND NEW.estado IN ('parcialmente atendida','completada','cancelada')) OR
      (OLD.estado = 'parcialmente atendida' AND NEW.estado = 'completada')) THEN
   RAISE EXCEPTION 'Transición de solicitud no permitida: % -> %', OLD.estado, NEW.estado USING ERRCODE = '23514';
 ELSIF TG_TABLE_NAME = 'orden_compra' AND NOT (
      (OLD.estado = 'pendiente de aprobación' AND NEW.estado IN ('aprobada','rechazada','cancelada')) OR
      (OLD.estado = 'aprobada' AND NEW.estado IN ('enviada','cancelada')) OR
      (OLD.estado = 'enviada' AND NEW.estado IN ('parcialmente recibida','completada','cancelada')) OR
      (OLD.estado = 'parcialmente recibida' AND NEW.estado IN ('completada','cancelada'))) THEN
   RAISE EXCEPTION 'Transición de orden no permitida: % -> %', OLD.estado, NEW.estado USING ERRCODE = '23514';
 END IF;
 RETURN NEW;
END ;
$g3_func$;
CREATE TRIGGER tg_consumo_transicion BEFORE UPDATE OF estado ON consumo FOR EACH ROW EXECUTE FUNCTION fn_validar_transicion_operativa();
CREATE TRIGGER tg_comanda_transicion BEFORE UPDATE OF estado ON comanda FOR EACH ROW EXECUTE FUNCTION fn_validar_transicion_operativa();
CREATE TRIGGER tg_solicitud_servicio_transicion BEFORE UPDATE OF estado ON solicitud_servicio FOR EACH ROW EXECUTE FUNCTION fn_validar_transicion_operativa();
CREATE TRIGGER tg_orden_compra_transicion BEFORE UPDATE OF estado ON orden_compra FOR EACH ROW EXECUTE FUNCTION fn_validar_transicion_operativa();

CREATE FUNCTION fn_validar_total_consumo() RETURNS trigger LANGUAGE plpgsql AS $g3_func$
DECLARE n varchar(30); esperado numeric(12,2); calculado numeric(12,2); lineas integer;
BEGIN
 n := CASE WHEN TG_TABLE_NAME = 'consumo' THEN COALESCE(NEW.numero_consumo, OLD.numero_consumo)
           ELSE COALESCE(NEW.numero_consumo, OLD.numero_consumo) END;
 SELECT importe_total INTO esperado FROM consumo WHERE numero_consumo = n;
 IF NOT FOUND THEN RETURN NULL; END IF;
 SELECT count(*), COALESCE(round(sum(importe),2),0) INTO lineas,calculado FROM detalle_consumo WHERE numero_consumo = n;
 IF lineas = 0 OR calculado <> esperado THEN
   RAISE EXCEPTION 'El consumo % requiere detalle y total coherente. Cabecera: %, detalle: %', n, esperado, calculado USING ERRCODE = '23514';
 END IF;
 RETURN NULL;
END ;
$g3_func$;
CREATE CONSTRAINT TRIGGER tg_consumo_total_diferido AFTER INSERT OR UPDATE ON consumo
 DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION fn_validar_total_consumo();
CREATE CONSTRAINT TRIGGER tg_detalle_consumo_total_diferido AFTER INSERT OR UPDATE OR DELETE ON detalle_consumo
 DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION fn_validar_total_consumo();

-- Al confirmar, la transacción debe bloquear la cabecera y los artículos involucrados.
-- El backend ejecutará SELECT ... FOR UPDATE en consumo y articulo_almacen, registrará
-- los movimientos del kardex y cambiará el estado dentro de la misma transacción.



CREATE FUNCTION fn_validar_referencia_envio() RETURNS trigger LANGUAGE plpgsql AS $g3_func$
DECLARE ok boolean := true;
BEGIN
 IF NEW.tipo_envio IN ('consumo', 'anulación de consumo') THEN
   ok := EXISTS (SELECT 1 FROM consumo WHERE numero_consumo = NEW.id_referencia);
 ELSIF NEW.tipo_envio IN ('costo de compra', 'anulación de compra') THEN
   ok := EXISTS (SELECT 1 FROM recepcion_compra WHERE id_recepcion = NEW.id_referencia);
 ELSIF NEW.tipo_envio = 'resultado de reposición' THEN
   ok := EXISTS (SELECT 1 FROM solicitud_reposicion WHERE id_solicitud_externa = NEW.id_referencia);
 END IF;  -- 'costo de ventas': la clave es punto de venta + fecha, no un registro único
 IF NOT ok THEN
   RAISE EXCEPTION 'id_referencia % no existe para el tipo de envío %', NEW.id_referencia, NEW.tipo_envio USING ERRCODE = '23503';
 END IF;
 RETURN NEW;
END ;
$g3_func$;
CREATE TRIGGER tg_envio_externo_referencia BEFORE INSERT OR UPDATE OF tipo_envio, id_referencia ON envio_externo
 FOR EACH ROW EXECUTE FUNCTION fn_validar_referencia_envio();
 
-- 6.2 Kardex inalterable: un movimiento no se borra ni se modifica; solo puede marcarse su anulación.
CREATE FUNCTION fn_kardex_inalterable() RETURNS trigger LANGUAGE plpgsql AS $g3_func$
BEGIN
 IF TG_OP = 'DELETE' THEN
   RAISE EXCEPTION 'El kardex no permite borrar movimientos (id_movimiento %)', OLD.id_movimiento USING ERRCODE = '42501';
 END IF;
 IF (to_jsonb(NEW) - 'estado_anulacion') IS DISTINCT FROM (to_jsonb(OLD) - 'estado_anulacion') THEN
   RAISE EXCEPTION 'El kardex solo permite marcar la anulación del movimiento %', OLD.id_movimiento USING ERRCODE = '42501';
 END IF;
 RETURN NEW;
END ;
$g3_func$;
CREATE TRIGGER tg_movimiento_inalterable BEFORE UPDATE OR DELETE ON movimiento_inventario
 FOR EACH ROW EXECUTE FUNCTION fn_kardex_inalterable();
 
-- 6.3 La decisión del administrador sobre una recomendación queda registrada sin poder cambiarse.
CREATE FUNCTION fn_decision_inalterable() RETURNS trigger LANGUAGE plpgsql AS $g3_func$
BEGIN
 IF OLD.decision IS NOT NULL AND (NEW.decision, NEW.comentario_decision, NEW.fecha_hora_decision)
      IS DISTINCT FROM (OLD.decision, OLD.comentario_decision, OLD.fecha_hora_decision) THEN
   RAISE EXCEPTION 'La decisión de la recomendación % ya está registrada y no puede cambiarse', OLD.id_recomendacion USING ERRCODE = '42501';
 END IF;
 RETURN NEW;
END ;
$g3_func$;
CREATE TRIGGER tg_recomendacion_decision BEFORE UPDATE ON recomendacion_gestion
 FOR EACH ROW EXECUTE FUNCTION fn_decision_inalterable();
 
 
-- 6.4 Auditoría: cada registro guarda cuándo y quién lo creó y lo modificó (fecha_creacion, usuario_creacion,
--     fecha_modificacion, usuario_modificacion). Lo hace la base de datos, así que no depende de la aplicación:
--     - el usuario sale de la variable de sesión app.usuario_id, que el backend fija con SET LOCAL en cada
--       transacción; si no está fijada se registra el rol de base de datos (current_user);
--     - los datos de creación no pueden cambiarse después.
--     El kardex (movimiento_inventario) nunca se modifica, por eso solo registra la creación.
CREATE FUNCTION fn_auditoria() RETURNS trigger LANGUAGE plpgsql AS $g3_func$
DECLARE u text := COALESCE(NULLIF(current_setting('app.usuario_id', true), ''), current_user::text);
BEGIN
 IF TG_OP = 'INSERT' THEN
   NEW.fecha_creacion := CURRENT_TIMESTAMP;      NEW.usuario_creacion := u;
   NEW.fecha_modificacion := CURRENT_TIMESTAMP;  NEW.usuario_modificacion := u;
 ELSE
   NEW.fecha_creacion := OLD.fecha_creacion;     NEW.usuario_creacion := OLD.usuario_creacion;
   NEW.fecha_modificacion := CURRENT_TIMESTAMP;  NEW.usuario_modificacion := u;
 END IF;
 RETURN NEW;
END ;
$g3_func$;
 
CREATE FUNCTION fn_auditoria_creacion() RETURNS trigger LANGUAGE plpgsql AS $g3_func$
BEGIN
 NEW.fecha_creacion := CURRENT_TIMESTAMP;
 NEW.usuario_creacion := COALESCE(NULLIF(current_setting('app.usuario_id', true), ''), current_user::text);
 RETURN NEW;
END ;
$g3_func$;
 
