-- ======================================================================
-- G3 SERVICIOS EXTERNOS RESTAURANTE Y ALMACEN
-- ======================================================================
DO $g3_rol$ BEGIN
 IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='g3_owner') THEN
  CREATE ROLE g3_owner NOLOGIN;
 END IF;
END $g3_rol$;
DO $g3_rol$ BEGIN
 IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='g3_dba') THEN
  CREATE ROLE g3_dba   NOLOGIN;
 END IF;
END $g3_rol$;
GRANT g3_owner TO g3_dba;
 
-- Roles de servicio del módulo; configurar autenticación fuera del archivo de entrega.
DO $g3_rol$ BEGIN
 IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='g3_app') THEN
  CREATE ROLE g3_app LOGIN
   ;
 END IF;
END $g3_rol$;
DO $g3_rol$ BEGIN
 IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='g3_integracion') THEN
  CREATE ROLE g3_integracion LOGIN
   ;
 END IF;
END $g3_rol$;
DO $g3_rol$ BEGIN
 IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='g3_lectura') THEN
  CREATE ROLE g3_lectura LOGIN
   ;
 END IF;
END $g3_rol$;
 
-- Cuentas personales del equipo G3: cada una entra con el nivel que necesita (no todas tienen todos los privilegios)
DO $g3_rol$ BEGIN
 IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='g3_saavedra') THEN
  CREATE ROLE g3_saavedra LOGIN IN ROLE g3_dba   -- administración: estructura y despliegue
   ;
 END IF;
END $g3_rol$;
DO $g3_rol$ BEGIN
 IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='g3_baylon') THEN
  CREATE ROLE g3_baylon LOGIN IN ROLE g3_app   -- desarrollo: lee y escribe, sin DELETE ni estructura
   ;
 END IF;
END $g3_rol$;
DO $g3_rol$ BEGIN
 IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='g3_varas') THEN
  CREATE ROLE g3_varas LOGIN IN ROLE g3_app   -- desarrollo: lee y escribe, sin DELETE ni estructura
   ;
 END IF;
END $g3_rol$;
DO $g3_rol$ BEGIN
 IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='g3_ponce') THEN
  CREATE ROLE g3_ponce LOGIN IN ROLE g3_lectura   -- auditoría: solo lectura
   ;
 END IF;
END $g3_rol$;
 
-- Base de datos: usar la conexión existente; no se crea ni cambia desde G3.
-- Se utiliza la base de datos de la conexión actual, creada antes de ejecutar el consolidado.

-- El aislamiento se aplica al esquema de G3 sin revocar la conexión de los otros grupos.
-- Permiso de conexión (las cuentas personales lo heredan del rol al que pertenecen)
DO $$
BEGIN
   EXECUTE format('GRANT CONNECT ON DATABASE %I TO g3_dba, g3_app, g3_integracion, g3_lectura',
                  current_database());
END $$;
 
-- Esquema del G3 (aislado: sin privilegios para PUBLIC ni para roles de otros grupos)
GRANT g3_owner TO CURRENT_USER;
CREATE SCHEMA g3_servicios AUTHORIZATION g3_owner;
REVOKE ALL ON SCHEMA g3_servicios FROM PUBLIC;
GRANT USAGE ON SCHEMA g3_servicios TO g3_app, g3_integracion, g3_lectura;
COMMENT ON SCHEMA g3_servicios IS 'Módulo 3 (G3): Servicios externos, POS, Restaurante y Almacén';
-- Asegurar que todas las tablas y funciones sin prefijo pertenecen a G3.
SET ROLE g3_owner;
SET LOCAL search_path TO g3_servicios, pg_catalog;

-- TABLA: PuntoVenta   (punto_venta)
CREATE TABLE punto_venta (
id_punto_venta             VARCHAR(36)NOT NULL,
nombre                     VARCHAR(120)   NOT NULL,
tipo                       VARCHAR(40)NOT NULL,
estado                     VARCHAR(40)NOT NULL,
motivo_desactivacion       VARCHAR(500),
fecha_creacion             TIMESTAMP(0)   NOT NULL DEFAULT CURRENT_TIMESTAMP,
usuario_creacion           VARCHAR(36)NOT NULL DEFAULT current_user,
fecha_modificacion         TIMESTAMP(0)   NOT NULL DEFAULT CURRENT_TIMESTAMP,
    usuario_modificacion           VARCHAR(36)NOT NULL DEFAULT current_user,
CONSTRAINT pk_punto_venta PRIMARY KEY (id_punto_venta),
CONSTRAINT uq_punto_venta_nombre UNIQUE (nombre),
CONSTRAINT ck_punto_venta_tipo_valido CHECK (tipo IN ('alimentos y bebidas','servicio complementario')),
CONSTRAINT ck_punto_venta_estado_valido CHECK (estado IN ('activo','inactivo')),
CONSTRAINT ck_punto_venta_inactivo_requiere_motivo CHECK (estado <> 'inactivo' OR motivo_desactivacion IS NOT NULL)
);
-- TABLA: Mesa   (mesa)
