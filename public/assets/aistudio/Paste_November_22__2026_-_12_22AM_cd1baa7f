CREATE TABLE IF NOT EXISTS integracion.evento_outbox (
  id_evento          UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  id_correlacion     UUID NOT NULL,
  modulo_origen      VARCHAR(10) NOT NULL
                     CHECK (modulo_origen IN ('GENERAL','M1','M2','M3','M4','M5')),
  tipo_evento        VARCHAR(100) NOT NULL CHECK (btrim(tipo_evento) <> ''),
  entidad            VARCHAR(80) NOT NULL CHECK (btrim(entidad) <> ''),
  id_entidad         VARCHAR(120) NOT NULL CHECK (btrim(id_entidad) <> ''),
  payload            JSONB NOT NULL DEFAULT '{}'::jsonb,
  estado             VARCHAR(12) NOT NULL DEFAULT 'PENDIENTE'
                     CHECK (estado IN ('PENDIENTE','PROCESANDO','PUBLICADO','FALLIDO')),
  numero_intentos    SMALLINT NOT NULL DEFAULT 0 CHECK (numero_intentos BETWEEN 0 AND 20),
  disponible_desde   TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
  fecha_creacion     TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
  fecha_publicacion  TIMESTAMPTZ,
  ultimo_error       VARCHAR(1000),
  UNIQUE (id_correlacion, tipo_evento, entidad, id_entidad),
  CONSTRAINT ck_outbox_payload_objeto CHECK (jsonb_typeof(payload) = 'object'),
  CONSTRAINT ck_outbox_publicacion CHECK (
    (estado = 'PUBLICADO' AND fecha_publicacion IS NOT NULL)
    OR (estado <> 'PUBLICADO' AND fecha_publicacion IS NULL)
  )
);

CREATE INDEX IF NOT EXISTS ix_outbox_pendiente
  ON integracion.evento_outbox (disponible_desde, fecha_creacion)
  WHERE estado IN ('PENDIENTE','FALLIDO');

CREATE TABLE IF NOT EXISTS seguridad.notificacion_operativa (
  id_notificacion    UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  id_correlacion     UUID,
  modulo_origen      VARCHAR(10) NOT NULL
                     CHECK (modulo_origen IN ('GENERAL','M1','M2','M3','M4','M5')),
  tipo_evento        VARCHAR(100) NOT NULL CHECK (btrim(tipo_evento) <> ''),
  titulo             VARCHAR(150) NOT NULL CHECK (btrim(titulo) <> ''),
  mensaje            VARCHAR(500) NOT NULL CHECK (btrim(mensaje) <> ''),
  severidad          VARCHAR(10) NOT NULL DEFAULT 'INFO'
                     CHECK (severidad IN ('INFO','EXITO','ADVERTENCIA','ERROR')),
  entidad            VARCHAR(80),
  id_entidad         VARCHAR(120),
  metadatos          JSONB NOT NULL DEFAULT '{}'::jsonb,
  fecha_creacion     TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
  fecha_expiracion   TIMESTAMPTZ,
  CONSTRAINT ck_notificacion_metadatos_objeto CHECK (jsonb_typeof(metadatos) = 'object'),
  CONSTRAINT ck_notificacion_expiracion CHECK (
    fecha_expiracion IS NULL OR fecha_expiracion > fecha_creacion
  )
);

CREATE UNIQUE INDEX IF NOT EXISTS ux_notificacion_correlacion
  ON seguridad.notificacion_operativa (id_correlacion, tipo_evento)
  WHERE id_correlacion IS NOT NULL;
CREATE INDEX IF NOT EXISTS ix_notificacion_fecha
  ON seguridad.notificacion_operativa (fecha_creacion DESC);

CREATE TABLE IF NOT EXISTS seguridad.notificacion_destinatario (
  id_notificacion    UUID NOT NULL
                     REFERENCES seguridad.notificacion_operativa (id_notificacion) ON DELETE CASCADE,
  id_usuario         UUID NOT NULL
                     REFERENCES seguridad.usuario_sistema (id_usuario) ON DELETE CASCADE,
  fecha_asignacion   TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
  fecha_lectura      TIMESTAMPTZ,
  fecha_descarte     TIMESTAMPTZ,
  PRIMARY KEY (id_notificacion,id_usuario),
  CONSTRAINT ck_notificacion_destino_fechas CHECK (
    (fecha_lectura IS NULL OR fecha_lectura >= fecha_asignacion)
    AND (fecha_descarte IS NULL OR fecha_descarte >= fecha_asignacion)
  )
);

CREATE INDEX IF NOT EXISTS ix_notificacion_destinatario_pendiente
  ON seguridad.notificacion_destinatario (id_usuario, fecha_asignacion DESC)
  WHERE fecha_lectura IS NULL AND fecha_descarte IS NULL;

CREATE OR REPLACE VIEW seguridad.v_notificacion_usuario AS
SELECT d.id_usuario,n.id_notificacion,n.id_correlacion,n.modulo_origen,
       n.tipo_evento,n.titulo,n.mensaje,n.severidad,n.entidad,n.id_entidad,
       n.metadatos,n.fecha_creacion,n.fecha_expiracion,d.fecha_asignacion,
       d.fecha_lectura,d.fecha_descarte,
       (d.fecha_lectura IS NOT NULL) AS leida,
       (d.fecha_descarte IS NOT NULL) AS descartada
FROM seguridad.notificacion_destinatario d
JOIN seguridad.notificacion_operativa n USING (id_notificacion)
WHERE n.fecha_expiracion IS NULL OR n.fecha_expiracion > CURRENT_TIMESTAMP;

