  codigo_usuario     VARCHAR(30),
  modulo             VARCHAR(12) NOT NULL
                     CHECK (modulo IN ('GENERAL','SEGURIDAD','M1','M2','M3','M4','M5')),
  operacion          VARCHAR(80) NOT NULL CHECK (btrim(operacion) <> ''),
  entidad            VARCHAR(80) NOT NULL CHECK (btrim(entidad) <> ''),
  id_registro        VARCHAR(120),
  resultado          VARCHAR(10) NOT NULL
                     CHECK (resultado IN ('EXITO','ERROR','DENEGADO')),
