CREATE TABLE IF NOT EXISTS g4_finanzas.cuenta_por_cobrar (
    id_cuenta_por_cobrar VARCHAR(36) PRIMARY KEY DEFAULT gen_random_uuid()::text,
    id_cuenta            VARCHAR(36) REFERENCES g4_finanzas.cuenta (id_cuenta),
    id_comprobante       VARCHAR(36) REFERENCES g4_finanzas.comprobante (id_comprobante),
    razon_social_cliente VARCHAR(200) NOT NULL,
    fecha_emision        DATE NOT NULL DEFAULT CURRENT_DATE,
    fecha_vencimiento    DATE NOT NULL,
    monto_original       NUMERIC(12,2) NOT NULL CHECK (monto_original > 0),
    monto_pagado         NUMERIC(12,2) NOT NULL DEFAULT 0
                         CHECK (monto_pagado >= 0 AND monto_pagado <= monto_original),
    saldo_pendiente      NUMERIC(12,2)
                         GENERATED ALWAYS AS (monto_original - monto_pagado) STORED,
    estado               VARCHAR(10) NOT NULL DEFAULT 'VIGENTE'
                         CHECK (estado IN ('VIGENTE','VENCIDA','PAGADA')),
    nota_seguimiento     TEXT,
    fecha_creacion       TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    fecha_actualizacion  TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT ck_cxc_origen CHECK (id_cuenta IS NOT NULL OR id_comprobante IS NOT NULL),
    CONSTRAINT ck_cxc_vencimiento CHECK (fecha_vencimiento >= fecha_emision),
    CONSTRAINT ck_cxc_estado_saldo CHECK (
        (estado = 'PAGADA' AND saldo_pendiente = 0)
        OR (estado IN ('VIGENTE','VENCIDA') AND saldo_pendiente > 0)
    )
);

