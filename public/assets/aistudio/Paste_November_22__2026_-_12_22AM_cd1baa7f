CREATE TABLE IF NOT EXISTS configuracion.establecimiento (
  id_establecimiento  SMALLINT PRIMARY KEY DEFAULT 1 CHECK (id_establecimiento = 1),
  codigo              VARCHAR(20) NOT NULL UNIQUE,
  razon_social        VARCHAR(200) NOT NULL,
  nombre_comercial    VARCHAR(150) NOT NULL,
  ruc                 CHAR(11) CHECK (ruc IS NULL OR ruc ~ '^[0-9]{11}$'),
  direccion           VARCHAR(300),
  zona_horaria        VARCHAR(50) NOT NULL DEFAULT 'America/Lima',
  moneda              CHAR(3) NOT NULL DEFAULT 'PEN' CHECK (moneda ~ '^[A-Z]{3}$'),
  logo_url            TEXT,
  estado              VARCHAR(10) NOT NULL DEFAULT 'ACTIVO'
                      CHECK (estado IN ('ACTIVO','INACTIVO')),
  fecha_creacion      TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
  fecha_modificacion  TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
  CONSTRAINT ck_establecimiento_codigo CHECK (codigo ~ '^[A-Z][A-Z0-9_-]{2,19}$')
);

CREATE OR REPLACE FUNCTION configuracion.fn_validar_establecimiento()
RETURNS trigger LANGUAGE plpgsql
SET search_path = pg_catalog, configuracion, pg_temp
AS $funcion$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_timezone_names WHERE name = NEW.zona_horaria) THEN
    RAISE EXCEPTION 'Zona horaria no valida: %', NEW.zona_horaria;
  END IF;
  NEW.fecha_modificacion := CURRENT_TIMESTAMP;
  RETURN NEW;
END
$funcion$;

DROP TRIGGER IF EXISTS trg_validar_establecimiento ON configuracion.establecimiento;
CREATE TRIGGER trg_validar_establecimiento
BEFORE INSERT OR UPDATE ON configuracion.establecimiento
FOR EACH ROW EXECUTE FUNCTION configuracion.fn_validar_establecimiento();

