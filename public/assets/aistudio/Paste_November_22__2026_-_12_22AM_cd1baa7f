-- Saldo de puntos por perfil (A2; CU-CA-19)
 
CREATE VIEW v_saldo_puntos AS
SELECT p.id_perfil, p.id_huesped,
   COALESCE(SUM(m.puntos) FILTER (WHERE m.estado = 'ACREDITADO'), 0) AS saldo_puntos
FROM perfil_huesped p
LEFT JOIN puntos_fidelizacion m ON m.id_perfil = p.id_perfil
GROUP BY p.id_perfil, p.id_huesped;
 
-- Distribución de huéspedes por segmento (RF-CA-15; CU-CA-10)
CREATE VIEW v_distribucion_segmento AS
SELECT s.codigo_segmento, s.nombre, s.activo, COUNT(p.id_perfil) AS total_perfiles
FROM segmento s
LEFT JOIN perfil_huesped p ON p.id_segmento = s.id_segmento
GROUP BY s.id_segmento, s.codigo_segmento, s.nombre, s.activo;
 
-- Tablero de reclamos abiertos con su situación frente al SLA de 48 h (RF-CA-11; CU-CA-32 y CU-CA-33)
CREATE VIEW v_tablero_reclamos AS
SELECT r.codigo_seguimiento, r.tipo, r.prioridad, r.estado, r.id_area, r.fecha_registro, r.fecha_limite_sla,
   ROUND(EXTRACT(EPOCH FROM (r.fecha_limite_sla - LOCALTIMESTAMP)) / 3600, 1) AS horas_restantes,
       CASE WHEN LOCALTIMESTAMP > r.fecha_limite_sla THEN 'VENCIDO'
            WHEN r.fecha_limite_sla - LOCALTIMESTAMP <= INTERVAL '12 hours' THEN 'POR_VENCER'
            ELSE 'EN_PLAZO' END AS situacion_sla
FROM reclamo r
WHERE r.estado <> 'CERRADO';
 
