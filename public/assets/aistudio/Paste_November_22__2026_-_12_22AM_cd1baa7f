-- Historia y kardex se corrigen mediante nuevos asientos, nunca sobrescribiendo.
CREATE FUNCTION impedir_mutacion() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
 RAISE EXCEPTION 'Registro histórico inmutable en %', TG_TABLE_NAME;
END $$;
CREATE TRIGGER historial_inmutable BEFORE UPDATE OR DELETE
ON cambio_estado_habitacion FOR EACH ROW EXECUTE FUNCTION impedir_mutacion();
CREATE TRIGGER kardex_inmutable BEFORE UPDATE OR DELETE
ON movimiento_insumo FOR EACH ROW EXECUTE FUNCTION impedir_mutacion();
-- Serializa las transiciones de una misma habitación.
CREATE FUNCTION validar_transicion() RETURNS trigger LANGUAGE plpgsql
SET search_path = g2_housekeeping, pg_catalog AS $$
DECLARE actual char(3); exige boolean;
BEGIN
 PERFORM pg_advisory_xact_lock(
  hashtextextended('g2_hab:' || NEW.id_habitacion::text,0));
 SELECT id_estado INTO actual FROM v_estado_actual
 WHERE id_habitacion = NEW.id_habitacion;
 IF NEW.id_estado_anterior IS DISTINCT FROM actual THEN
  RAISE EXCEPTION 'Estado anterior desactualizado';
 END IF;
 IF actual IS NOT NULL THEN
  SELECT requiere_motivo INTO exige FROM transicion_permitida
  WHERE id_estado_origen = actual
    AND id_estado_destino = NEW.id_estado_nuevo;
  IF NOT FOUND THEN RAISE EXCEPTION 'Transición no permitida'; END IF;
  IF exige AND nullif(btrim(NEW.motivo),'') IS NULL THEN
   RAISE EXCEPTION 'La transición requiere motivo';
  END IF;
 END IF;
 NEW.fecha_hora := clock_timestamp();
 RETURN NEW;
END $$;
CREATE TRIGGER validar_estado BEFORE INSERT ON cambio_estado_habitacion
FOR EACH ROW EXECUTE FUNCTION validar_transicion();
-- Fecha agregada a la orden para enlazarla con el turno concreto.
CREATE FUNCTION validar_asignacion() RETURNS trigger LANGUAGE plpgsql
SET search_path = g2_housekeeping, pg_catalog AS $$
DECLARE o orden_limpieza%ROWTYPE; habilitado boolean;
BEGIN
 IF NOT NEW.vigente THEN RETURN NEW; END IF;
 SELECT * INTO o FROM orden_limpieza
 WHERE numero_orden = NEW.numero_orden FOR UPDATE;
 IF NOT FOUND OR o.estado IN ('Cerrada','Anulada') THEN
  RAISE EXCEPTION 'Orden inexistente o cerrada';
 END IF;
 SELECT pt.disponible AND p.estado = 'A' INTO habilitado
 FROM programacion_turno pt JOIN personal_operativo p USING(id_personal)
 WHERE pt.id_personal = NEW.id_personal AND pt.id_turno = o.id_turno
   AND pt.fecha = o.fecha_programada FOR UPDATE OF pt,p;
 IF habilitado IS DISTINCT FROM true THEN
  RAISE EXCEPTION 'Trabajador no disponible en fecha y turno';
 END IF;
 IF EXISTS (SELECT 1 FROM asignacion_limpieza
  WHERE numero_orden = NEW.numero_orden)
  AND TG_OP = 'INSERT'
  AND nullif(btrim(NEW.motivo_reasignacion),'') IS NULL THEN
  RAISE EXCEPTION 'La reasignación exige motivo';
 END IF;
 RETURN NEW;
END $$;
CREATE TRIGGER validar_personal BEFORE INSERT OR UPDATE ON asignacion_limpieza
FOR EACH ROW EXECUTE FUNCTION validar_asignacion();
-- El stock se modifica dentro de la misma transacción que inserta el kardex.
CREATE FUNCTION aplicar_movimiento() RETURNS trigger LANGUAGE plpgsql
SECURITY DEFINER SET search_path = g2_housekeeping, pg_catalog AS $$
DECLARE saldo numeric;
BEGIN
 SELECT stock_actual INTO STRICT saldo FROM insumo
 WHERE id_insumo = NEW.id_insumo FOR UPDATE;
 saldo := saldo + CASE WHEN NEW.signo = '+' THEN NEW.cantidad
                      ELSE -NEW.cantidad END;
 IF saldo < 0 THEN RAISE EXCEPTION 'Stock insuficiente'; END IF;
 NEW.saldo_posterior := saldo;
 UPDATE insumo SET stock_actual = saldo WHERE id_insumo = NEW.id_insumo;
 RETURN NEW;
END $$;
CREATE TRIGGER stock_transaccional BEFORE INSERT ON movimiento_insumo
FOR EACH ROW EXECUTE FUNCTION aplicar_movimiento();
CREATE FUNCTION proteger_ot_cerrada() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
 IF OLD.estado = 'Cerrada' THEN
  RAISE EXCEPTION 'La orden cerrada no se modifica ni se elimina';
 END IF;
 IF TG_OP = 'DELETE' THEN RETURN OLD; END IF;
 RETURN NEW;
END $$;
CREATE TRIGGER cierre_inmutable BEFORE UPDATE OR DELETE ON orden_trabajo
FOR EACH ROW EXECUTE FUNCTION proteger_ot_cerrada();
-- Jerarquías totales y exclusivas. Se validan al finalizar la transacción.
CREATE FUNCTION validar_jerarquia_personal() RETURNS trigger LANGUAGE plpgsql
SET search_path = g2_housekeeping, pg_catalog AS $$
DECLARE k bigint; c text; n integer; correcto boolean;
BEGIN
 k := CASE WHEN TG_OP = 'DELETE' THEN OLD.id_personal ELSE NEW.id_personal END;
 SELECT cargo INTO c FROM personal_operativo WHERE id_personal=k;
 IF NOT FOUND THEN RETURN NULL; END IF;
 SELECT (EXISTS(SELECT 1 FROM personal_limpieza WHERE id_personal=k))::int
      + (EXISTS(SELECT 1 FROM tecnico_mantenimiento WHERE id_personal=k))::int
      + (EXISTS(SELECT 1 FROM supervisor WHERE id_personal=k))::int INTO n;
 correcto := CASE c
 WHEN 'Limpieza' THEN EXISTS(SELECT 1 FROM personal_limpieza WHERE id_personal=k)
 WHEN 'Técnico' THEN EXISTS(SELECT 1 FROM tecnico_mantenimiento WHERE id_personal=k)
 ELSE EXISTS(SELECT 1 FROM supervisor WHERE id_personal=k) END;
 IF n <> 1 OR NOT correcto THEN RAISE EXCEPTION 'Jerarquía de personal inválida'; END IF;
 RETURN NULL;
END $$;
DO $$ DECLARE t text; BEGIN
 FOREACH t IN ARRAY ARRAY['personal_operativo','personal_limpieza',
                         'tecnico_mantenimiento','supervisor'] LOOP
 EXECUTE format('CREATE CONSTRAINT TRIGGER jerarquia_personal
 AFTER INSERT OR UPDATE OR DELETE ON %I DEFERRABLE INITIALLY DEFERRED
 FOR EACH ROW EXECUTE FUNCTION validar_jerarquia_personal()',t);
 END LOOP;
END $$;
CREATE FUNCTION validar_jerarquia_ot() RETURNS trigger LANGUAGE plpgsql
SET search_path = g2_housekeeping, pg_catalog AS $$
DECLARE k bigint; tipo text; n integer; correcto boolean;
BEGIN
 k := CASE WHEN TG_OP = 'DELETE' THEN OLD.numero_ot ELSE NEW.numero_ot END;
 SELECT tipo_ot INTO tipo FROM orden_trabajo WHERE numero_ot=k;
 IF NOT FOUND THEN RETURN NULL; END IF;
 SELECT (EXISTS(SELECT 1 FROM ot_correctiva WHERE numero_ot=k))::int
      + (EXISTS(SELECT 1 FROM ot_preventiva WHERE numero_ot=k))::int INTO n;
 correcto := CASE tipo WHEN 'Correctiva' THEN
  EXISTS(SELECT 1 FROM ot_correctiva WHERE numero_ot=k) ELSE
  EXISTS(SELECT 1 FROM ot_preventiva WHERE numero_ot=k) END;
 IF n <> 1 OR NOT correcto THEN RAISE EXCEPTION 'Jerarquía de OT inválida'; END IF;
 RETURN NULL;
END $$;
DO $$ DECLARE t text; BEGIN
 FOREACH t IN ARRAY ARRAY['orden_trabajo','ot_correctiva','ot_preventiva'] LOOP
 EXECUTE format('CREATE CONSTRAINT TRIGGER jerarquia_ot
 AFTER INSERT OR UPDATE OR DELETE ON %I DEFERRABLE INITIALLY DEFERRED
 FOR EACH ROW EXECUTE FUNCTION validar_jerarquia_ot()',t);
 END LOOP;
END $$;
