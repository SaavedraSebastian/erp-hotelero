# Entorno del servidor
NODE_ENV=development
PORT=3000
APP_URL="http://localhost:3000"
STRICT_ENV_VALIDATION="false"

# Conexión privada a PostgreSQL en Supabase (NUNCA usar prefijo VITE_ / NEXT_PUBLIC_ ni exponer al navegador)
# Recomendado: usar el rol técnico sgh_erp_api con pertenencia a sgh_erp_backend (no postgres)
DATABASE_URL=""
DATABASE_SSL="true"
DATABASE_SSL_REJECT_UNAUTHORIZED="false"
PG_POOL_MAX="15"
PG_CONNECTION_TIMEOUT_MS="5000"
PG_IDLE_TIMEOUT_MS="30000"
PG_QUERY_TIMEOUT_MS="15000"
PG_STATEMENT_TIMEOUT_MS="15000"

# Supabase Auth (el servidor verifica JWT con JWKS; el navegador solo usa URL + ANON KEY para auth)
SUPABASE_URL=""
SUPABASE_JWKS_URL=""
SUPABASE_JWT_ISSUER=""
SUPABASE_JWT_AUDIENCE="authenticated"
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Seguridad HTTP y CORS (lista separada por comas de orígenes permitidos en producción)
CORS_ALLOWED_ORIGINS=""

# Gemini AI (solo servidor)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
